<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 is deliberately not suppressed: AGENTS.md Prime Directive #2 mandates 100% docblock coverage -->
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <WarningsNotAsErrors>NU1900</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NanoWeaverHrt\NanoWeaverHrt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NanoWeaverHrt.Tests" />
  </ItemGroup>

</Project>
