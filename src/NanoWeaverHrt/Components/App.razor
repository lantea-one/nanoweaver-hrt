@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject NanoWeaverHrt.Security.Integrity.IAssetIntegrityService AssetIntegrity
@{
    string appCssSri = AssetIntegrity.GetSubresourceIntegrity("css/app.css");
    string sessionJsSri = AssetIntegrity.GetSubresourceIntegrity("js/weaver-session.js");
    string authJsSri = AssetIntegrity.GetSubresourceIntegrity("js/weaver-auth.js");
    string appJsSri = AssetIntegrity.GetSubresourceIntegrity("js/app.js");
    string vizJsSri = AssetIntegrity.GetSubresourceIntegrity("js/weaver-visualizer.js");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>NanoWeaverHrt (nanoweaver-hrt): Sovereign Nanotechnology Node</title>
    <link rel="stylesheet" href="@($"css/app.css?v={Uri.EscapeDataString(appCssSri)}")" integrity="@appCssSri" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    @*
        WHAT: Session, idle-watcher, and client-side challenge-response authentication scripts.
        WHY:  Prime Directive 12 & Audit C8 mandate client-side challenge signing without
              transmitting raw private keys across the Blazor SignalR circuit.
        HOW:  Vendored crypto module loaded with SRI hash validation, followed by weaver-auth.js.
              Authored scripts and stylesheets compute dynamic SRI hashes server-side via .NET
              and include content-derived ?v= cache busters so upgrades never collide with stale browser caches.
    *@
    <script src="@($"js/weaver-session.js?v={Uri.EscapeDataString(sessionJsSri)}")" integrity="@sessionJsSri"></script>
    <script type="module" src="lib/weaver-crypto-vendor.js" integrity="sha384-2PWlMHMrV/enpeAeEB0EtHqLjYv9Rql4aPLZNGynBOQPFkoacC01+5WwbCsr8lgD"></script>
    <script src="@($"js/weaver-auth.js?v={Uri.EscapeDataString(authJsSri)}")" integrity="@authJsSri"></script>
    <script src="@($"js/app.js?v={Uri.EscapeDataString(appJsSri)}")" integrity="@appJsSri"></script>
    <script src="@($"js/weaver-visualizer.js?v={Uri.EscapeDataString(vizJsSri)}")" integrity="@vizJsSri"></script>
</body>
</html>
