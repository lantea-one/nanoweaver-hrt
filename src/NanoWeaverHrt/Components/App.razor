@using static Microsoft.AspNetCore.Components.Web.RenderMode
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>NanoWeaverHrt (nanoweaver-hrt): Sovereign Nanotechnology Node</title>
    <link rel="stylesheet" href="css/app.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    @*
        WHAT: Session, idle-watcher, and client-side challenge-response authentication scripts.
        WHY:  Prime Directive 12 & Audit C8 mandate client-side challenge signing without
              transmitting raw private keys across the Blazor SignalR circuit.
        HOW:  Vendored crypto module loaded with SRI hash validation, followed by weaver-auth.js.
    *@
    <script src="js/weaver-session.js"></script>
    <script type="module" src="lib/weaver-crypto-vendor.js" integrity="sha384-cGSuUAxVag6M22EUFPXwy2Ru6SijbfQ8wdJ+2GBTND1XmMtuH2Atb50BfuBg/z0F"></script>
    <script src="js/weaver-auth.js"></script>
    <script src="js/app.js"></script>
    <script src="js/weaver-visualizer.js"></script>
</body>
</html>
