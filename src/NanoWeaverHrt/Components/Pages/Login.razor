@page "/login"
@inject UserSessionState SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="login-container">
    <div class="card login-card">
        <div class="login-header text-center">
            <span class="logo-dot"></span>
            <h2>SOVEREIGN AUTHENTICATION</h2>
            <p class="subtext">Asymmetric Private Key Sign-In</p>
        </div>

        @if (SessionState.IsAuthenticated)
        {
            <div class="alert alert-info mt-3 text-center">
                Currently signed in as <strong class="font-mono">@SessionState.CurrentUser?.Username</strong> (@SessionState.CurrentUser?.Role).
                <div class="mt-2">
                    <button class="btn btn-outline" @onclick="SignOut">Sign Out</button>
                    <a href="/" class="btn btn-primary ml-2">Go to Dashboard</a>
                </div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_infoMessage))
            {
                <div class="alert alert-warning mt-3">@_infoMessage</div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger mt-3">@_errorMessage</div>
            }

            <div class="form-group mt-3">
                <label for="loginUser" class="form-label">Username</label>
                <input id="loginUser" class="form-control font-mono" placeholder="e.g., administrator or researcher-01" />
                <div class="form-hint">Enter your registered identity handle on this sovereign node.</div>
            </div>

            <div class="form-group mt-3">
                <div class="d-flex justify-between align-center mb-1">
                    <label for="privKeyPem" class="form-label" style="margin-bottom:0;">Private Key (.pem / .key)</label>
                    <div class="d-flex gap-1">
                        <label for="keyFileUpload" class="btn btn-sm btn-outline cursor-pointer" style="margin:0;">
                            📁 Upload Key File
                        </label>
                        <input id="keyFileUpload" type="file" accept=".pem,.key,.txt" style="display:none;" />
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => _showPrivateKey = !_showPrivateKey">
                            @(_showPrivateKey ? "🔒 Mask Key" : "👁 Show Key")
                        </button>
                    </div>
                </div>
@*
    WHAT: Multi-line textarea for the PEM private key, masked via CSS rather than input type.
    WHY:  Keeps the private key strictly in browser DOM memory without SignalR circuit streaming (Audit C8).
    HOW:  The mask toggle swaps a CSS class instead of the input type, because type="password"
          is unavailable on a textarea.
*@
                <textarea id="privKeyPem" rows="5" class="form-control font-mono private-key-input @(_showPrivateKey ? string.Empty : "is-masked")" placeholder="Paste private key PEM text (including the BEGIN and END lines) or upload a key file above..."></textarea>
                <div class="form-hint">Paste your cryptographic private key or upload your .pem/.key file. Keys are signed locally in browser memory and never transmitted to the server.</div>
            </div>

            <div class="form-group mt-3">
                <label for="loginPassword" class="form-label">Passphrase (if key is encrypted)</label>
                <input id="loginPassword" type="password" class="form-control" placeholder="Leave blank for unencrypted private key" />
                <div class="form-hint">Optional: Enter your decryption passphrase if your private key was password-protected.</div>
            </div>

            <div class="actions mt-4 text-center">
                <button id="loginSubmitBtn" class="btn btn-primary w-100" @onclick="Authenticate">Sign In with Private Key</button>
            </div>

            <div class="mt-3 text-center text-muted subtext">
                Need an account? Contact your system Administrator or visit <a href="/setup">First-Launch Setup</a> if uninitialized.
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Controls whether the private key input is masked as a password or displayed as plain text.
    /// </summary>
    private bool _showPrivateKey;

    /// <summary>
    /// Informational message banner (e.g., session idle timeout notification).
    /// </summary>
    private string? _infoMessage;

    /// <summary>
    /// Error message string displayed on failed authentication attempts.
    /// </summary>
    private string? _errorMessage;

    /// <summary>
    /// Initializes login component and checks for idle timeout query parameters.
    /// </summary>
    protected override void OnInitialized()
    {
        // WHAT: Detects query string indicating an automated idle session termination.
        // WHY:  Informs the user clearly why their previous session ended.
        // HOW:  Inspects NavigationManager URI for reason=idle_timeout.
        if (Navigation.Uri.Contains("reason=idle_timeout", StringComparison.OrdinalIgnoreCase))
        {
            _infoMessage = "Your session has expired due to inactivity. Please sign in again to access the platform.";
        }
    }

    /// <summary>
    /// Attaches client-side event handlers after the component has rendered.
    /// </summary>
    /// <param name="firstRender">True if this is the component's first render cycle.</param>
    /// <returns>An asynchronous task tracking the operation.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // WHAT: Binds client-side change handler to key file upload input.
        // WHY:  Allows reading private key files into DOM memory without SignalR streaming (Audit C8).
        // HOW:  Invokes JS weaverBindKeyFileInput passing input and textarea IDs.
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("weaverBindKeyFileInput", "keyFileUpload", "privKeyPem");
            }
            catch (Exception)
            {
                // Disconnected circuit or unit test environment
            }
        }
    }

    /// <summary>
    /// Submits user credentials and verifies private key signatures against stored public keys.
    /// </summary>
    /// <returns>An asynchronous task tracking the sign-in operation.</returns>
    private async Task Authenticate()
    {
        // WHAT: Executes asymmetric challenge-response sign-in via client-side JavaScript.
        // WHY:  Ensures private key never crosses the SignalR circuit to the server (Audit C8).
        // HOW:  Invokes window.weaverSignIn and stores authenticated user in SessionState.
        _errorMessage = null;
        try
        {
            WeaverSignInResult result = await JS.InvokeAsync<WeaverSignInResult>("weaverSignIn");
            if (!result.Ok || result.User == null)
            {
                _errorMessage = result.Error ?? "Authentication failed.";
                return;
            }

            SessionState.SetUser(result.User);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Authentication failed: {ex.Message}";
        }
    }

    /// <summary>
    /// Signs out the currently authenticated user and resets page state.
    /// </summary>
    /// <returns>An asynchronous task tracking the sign-out operation.</returns>
    private async Task SignOut()
    {
        // WHAT: Clears authenticated browser session in client storage and server state.
        // WHY:  Terminates user authorization and revokes bearer session tokens.
        // HOW:  Invokes weaverClearSession and clears SessionState.
        try
        {
            await JS.InvokeVoidAsync("weaverClearSession");
        }
        catch (Exception)
        {
            // Disconnected circuit or unit test environment
        }

        SessionState.SignOut();
        Navigation.NavigateTo("/login");
    }

    /// <summary>
    /// Interop payload returned by client-side weaverSignIn.
    /// </summary>
    /// <param name="Ok">Indicates whether the sign-in workflow succeeded.</param>
    /// <param name="Error">Descriptive error message on failure.</param>
    /// <param name="Token">Signed JWT session bearer token.</param>
    /// <param name="User">Authenticated user account record.</param>
    private sealed record WeaverSignInResult(
        bool Ok,
        string? Error,
        string? Token,
        UserAccount? User);
}
