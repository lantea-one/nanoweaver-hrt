@page "/login"
@inject IUserAuthenticationService AuthService
@inject UserSessionState SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="login-container">
    <div class="card login-card">
        <div class="login-header text-center">
            <span class="logo-dot"></span>
            <h2>SOVEREIGN AUTHENTICATION</h2>
            <p class="subtext">Asymmetric Private Key Sign-In</p>
        </div>

        @if (SessionState.IsAuthenticated)
        {
            <div class="alert alert-info mt-3 text-center">
                Currently signed in as <strong class="font-mono">@SessionState.CurrentUser?.Username</strong> (@SessionState.CurrentUser?.Role).
                <div class="mt-2">
                    <button class="btn btn-outline" @onclick="SignOut">Sign Out</button>
                    <a href="/" class="btn btn-primary ml-2">Go to Dashboard</a>
                </div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_infoMessage))
            {
                <div class="alert alert-warning mt-3">@_infoMessage</div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger mt-3">@_errorMessage</div>
            }

            <div class="form-group mt-3">
                <label for="loginUser" class="form-label">Username</label>
                <input id="loginUser" class="form-control font-mono" placeholder="e.g., administrator or researcher-01" @bind="_username" />
                <div class="form-hint">Enter your registered identity handle on this sovereign node.</div>
            </div>

            <div class="form-group mt-3">
                <div class="d-flex justify-between align-center mb-1">
                    <label for="privKeyPem" class="form-label" style="margin-bottom:0;">Private Key (.pem / .key)</label>
                    <div class="d-flex gap-1">
                        <label for="keyFileUpload" class="btn btn-sm btn-outline cursor-pointer" style="margin:0;">
                            📁 Upload Key File
                        </label>
                        <InputFile id="keyFileUpload" OnChange="HandleKeyFileUpload" accept=".pem,.key,.txt" style="display:none;" />
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => _showPrivateKey = !_showPrivateKey">
                            @(_showPrivateKey ? "🔒 Mask Key" : "👁 Show Key")
                        </button>
                    </div>
                </div>
@*
    WHAT: Multi-line textarea for the PEM private key, masked via CSS rather than input type.
    WHY:  A single-line <input> collapses the newlines out of pasted PEM text, after which the
          key cannot be parsed and sign-in fails with a signature error. Only the file-upload
          path worked. A textarea preserves the line structure a PEM envelope requires.
    HOW:  The mask toggle swaps a CSS class instead of the input type, because type="password"
          is unavailable on a textarea.
*@
                <textarea id="privKeyPem" rows="5" class="form-control font-mono private-key-input @(_showPrivateKey ? string.Empty : "is-masked")" placeholder="Paste private key PEM text (including the BEGIN and END lines) or upload a key file above..." @bind="_privateKeyPem"></textarea>
                <div class="form-hint">Paste your cryptographic private key or upload your .pem/.key file. Keys are verified locally in-memory and never stored.</div>
            </div>

            <div class="form-group mt-3">
                <label for="loginPassword" class="form-label">Passphrase (if key is encrypted)</label>
                <input id="loginPassword" type="password" class="form-control" placeholder="Leave blank for unencrypted private key" @bind="_password" />
                <div class="form-hint">Optional: Enter your decryption passphrase if your private key was password-protected.</div>
            </div>

            <div class="actions mt-4 text-center">
                <button class="btn btn-primary w-100" @onclick="Authenticate">Sign In with Private Key</button>
            </div>

            <div class="mt-3 text-center text-muted subtext">
                Need an account? Contact your system Administrator or visit <a href="/setup">First-Launch Setup</a> if uninitialized.
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// User input value for account username.
    /// </summary>
    private string _username = string.Empty;

    /// <summary>
    /// User input text containing the PEM-encoded private key.
    /// </summary>
    private string _privateKeyPem = string.Empty;

    /// <summary>
    /// Optional passphrase input for decrypting protected private keys.
    /// </summary>
    private string _password = string.Empty;

    /// <summary>
    /// Controls whether the private key input is masked as a password or displayed as plain text.
    /// </summary>
    private bool _showPrivateKey;

    /// <summary>
    /// Informational message banner (e.g., session idle timeout notification).
    /// </summary>
    private string? _infoMessage;

    /// <summary>
    /// Error message string displayed on failed authentication attempts.
    /// </summary>
    private string? _errorMessage;

    /// <summary>
    /// Initializes login component and checks for idle timeout query parameters.
    /// </summary>
    protected override void OnInitialized()
    {
        // WHAT: Detects query string indicating an automated idle session termination.
        // WHY:  Informs the user clearly why their previous session ended.
        // HOW:  Inspects NavigationManager URI for reason=idle_timeout.
        if (Navigation.Uri.Contains("reason=idle_timeout", StringComparison.OrdinalIgnoreCase))
        {
            _infoMessage = "Your session has expired due to inactivity. Please sign in again to access the platform.";
        }
    }

    /// <summary>
    /// Reads an uploaded private key file directly into the private key input field.
    /// </summary>
    /// <param name="e">File input event arguments.</param>
    private async Task HandleKeyFileUpload(InputFileChangeEventArgs e)
    {
        // WHAT: Reads the raw contents of an uploaded .pem or .key file in the browser.
        // WHY:  Permits researchers to select their key file without manually copy-pasting multi-line text.
        // HOW:  Opens a bounded stream (max 64 KB) and decodes text using UTF-8 StreamReader.
        _errorMessage = null;
        try
        {
            if (e.File != null)
            {
                using Stream stream = e.File.OpenReadStream(maxAllowedSize: 65536);
                using StreamReader reader = new(stream, System.Text.Encoding.UTF8);
                _privateKeyPem = await reader.ReadToEndAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to read uploaded key file: {ex.Message}";
        }
    }

    /// <summary>
    /// Submits user credentials and verifies private key signatures against stored public keys.
    /// </summary>
    private async Task Authenticate()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_privateKeyPem))
        {
            _errorMessage = "Username and private key are both required.";
            return;
        }

        var result = await AuthService.AuthenticateWithPrivateKeyAsync(
            _username.Trim(),
            _privateKeyPem.Trim(),
            string.IsNullOrWhiteSpace(_password) ? null : _password,
            isWebRequest: true);

        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage ?? "Authentication failed.";
            return;
        }

        SessionState.SetUser(result.User);
        if (!string.IsNullOrEmpty(result.Token))
        {
            try
            {
                await JS.InvokeVoidAsync("weaverSetSession", result.Token);
            }
            catch (Exception)
            {
                // Disconnected circuit or unit test environment
            }
        }

        Navigation.NavigateTo("/");
    }

    /// <summary>
    /// Signs out the currently authenticated user and resets page state.
    /// </summary>
    private async Task SignOut()
    {
        try
        {
            await JS.InvokeVoidAsync("weaverClearSession");
        }
        catch (Exception)
        {
            // Disconnected circuit or unit test environment
        }

        SessionState.SignOut();
        Navigation.NavigateTo("/login");
    }
}
