@page "/endocrine"
@using System.Globalization
@using System.Text
@using NanoWeaverHrt.Genomics
@using NanoWeaverHrt.Endocrine
@using NanoWeaverHrt.Models
@inject EndocrineStateEngine Engine
@inject IPharmacogenomicsService GenomicsService
@inject IEndocrineClosedLoopEngine ClosedLoopEngine
@inject IEpigeneticCircuitService EpigeneticCircuitService
@inject IConfigurationRepository ConfigRepo
@inject IJSRuntime JS
@inject IWeaverLocalizer Localizer

<div class="endocrine-container">
    <div class="panel-header">
        <div>
            <h2>Patient-Targeted Endocrine Regulatory Hub</h2>
            <p class="panel-desc">Bistable molecular toggle state management, pharmacogenomic predisposition screening, and precision kinetics.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/simulations" class="btn btn-outline btn-sm text-no-underline">
                🧪 In-Silico Studio
            </a>
            <div class="badge @(_activeProfile.Regimen == TherapeuticRegimen.MaleToFemale ? "badge-accent" : "badge-outline")">
                ACTIVE: @_activeProfile.Regimen.ToString().ToUpperInvariant()
            </div>
        </div>
    </div>

    <!-- Bistable Toggle Switch Panel -->
    <div class="card panel mt-3">
        <div class="panel-header">
            <h3>Bistable Synthetic Hormone Toggle Controller</h3>
            <span class="subtext">Autonomous feedback regulation</span>
        </div>

        <div class="endocrine-controls mt-2">
            <div class="toggle-switch-group">
                <button class="toggle-btn @(_activeProfile.TargetState == ToggleState.EstrogenicDominant ? "active-estrogen" : "")"
                        @onclick="() => SetToggleState(ToggleState.EstrogenicDominant)">
                    <span class="symbol">♀</span> @Localizer.GetString("Regimen.MtF", _currentLanguage) (@Localizer.GetString("Regimen.E2Dominant", _currentLanguage))
                </button>
                <button class="toggle-btn @(_activeProfile.TargetState == ToggleState.AndrogenicDominant ? "active-testosterone" : "")"
                        @onclick="() => SetToggleState(ToggleState.AndrogenicDominant)">
                    <span class="symbol">♂</span> @Localizer.GetString("Regimen.FtM", _currentLanguage) (@Localizer.GetString("Regimen.TDominant", _currentLanguage))
                </button>
            </div>

            <!-- Setpoint Metrics Display -->
            <div class="setpoints-display mt-3">
                <div class="setpoint-item">
                    <span class="setpoint-label">TARGET 17β-ESTRADIOL</span>
                    <span class="setpoint-val font-mono">@_activeProfile.TargetEstradiolPmolL.ToString("F1") <small>pmol/L</small></span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">TARGET TESTOSTERONE</span>
                    <span class="setpoint-val font-mono">@_activeProfile.TargetTestosteroneNmolL.ToString("F2") <small>nmol/L</small></span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">APTAMER TARGET Kd</span>
                    <span class="setpoint-val font-mono">@_activeProfile.BindingAffinityKdTargetNanoMolar.ToString("F1") <small>nM</small></span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">TARGET TISSUE</span>
                    <span class="setpoint-val font-mono">@_activeProfile.TargetTissue</span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">DELIVERY CHASSIS</span>
                    <span class="setpoint-val font-mono">@_activeProfile.DeliveryVehicle.Geometry</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Pharmacogenomics & Genetic Predisposition Screening Panel -->
    <div class="card panel mt-4">
        <div class="panel-header">
            <div>
                <h3>Pharmacogenomic Risk &amp; Genetic Predisposition Screening</h3>
                <span class="subtext">Identifies patient-specific mutations affecting thrombosis risk, clearance rate, and DNA origami tolerance.</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (_genomicProfile.HasCriticalAlerts)
                {
                    <span class="genomic-badge-critical animate-pulse">CRITICAL RISKS ACTIVE</span>
                }
                else
                {
                    <span class="genomic-badge-optimal">GENOME STABLE</span>
                }
            </div>
        </div>

        <!-- Presets Selection & Profile Metrics -->
        <div class="mt-3">
            <span class="subtext font-mono fs-08-upper">Load Patient Genomic Preset:</span>
            <div class="d-flex flex-wrap gap-2 mt-2">
                @foreach (var preset in _availablePresets)
                {
                    <button class="btn btn-sm @(_activePresetId == preset.PresetId ? "btn-primary" : "btn-outline")"
                            @onclick="() => SelectPreset(preset.PresetId)">
                        @preset.Title
                    </button>
                }
            </div>

            <!-- Genomic Risk Index Summary Bar -->
            <div class="setpoints-display mt-3 grid-auto-180">
                <div class="setpoint-item">
                    <span class="setpoint-label">THROMBOSIS RISK INDEX</span>
                    <span class="setpoint-val font-mono @(_genomicProfile.ThrombosisRiskIndex > 1.5 ? "text-danger" : "text-success")">
                        @_genomicProfile.ThrombosisRiskIndex.ToString("F1")x
                        <small>@(_genomicProfile.ThrombosisRiskIndex > 1.5 ? "ELEVATED" : "BASELINE")</small>
                    </span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">CLEARANCE MULTIPLIER</span>
                    <span class="setpoint-val font-mono">
                        @_genomicProfile.OverallClearanceMultiplier.ToString("F2")x
                        <small>@(_genomicProfile.OverallClearanceMultiplier < 1.0 ? "SLOWER" : _genomicProfile.OverallClearanceMultiplier > 1.0 ? "RAPID" : "NORMAL")</small>
                    </span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">CPG METHYLATION</span>
                    <span class="setpoint-val font-mono @(_genomicProfile.CpGMethylationMandatory ? "text-warning" : "text-muted")">
                        @(_genomicProfile.CpGMethylationMandatory ? "MANDATORY" : "STANDARD")
                    </span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">RECOMMENDED MAX E2</span>
                    <span class="setpoint-val font-mono">
                        @(_genomicProfile.RecommendedMaxEstradiolPmolL.HasValue ? $"{_genomicProfile.RecommendedMaxEstradiolPmolL.Value:F1} pmol/L" : "UNRESTRICTED")
                    </span>
                </div>
            </div>

            <!-- Individual Marker Toggles -->
            <div class="mt-3 p-3 bg-trans-dark-2">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="subtext font-mono fs-08-upper">Individual Genetic Marker Selectors:</span>
                    <button class="btn btn-sm btn-outline" @onclick="ClearAllMarkers">Clear All</button>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var marker in _availableMarkers)
                    {
                        <label class="d-flex align-items-center gap-1 font-mono fs-085-pointer">
                            <input type="checkbox"
                                   checked="@_selectedMarkerIds.Contains(marker.MarkerId)"
                                   @onchange="() => ToggleMarker(marker.MarkerId)" />
                            <span class="@(marker.Severity == ClinicalSeverity.Critical ? "text-danger" : marker.Severity == ClinicalSeverity.Warning ? "text-warning" : "text-muted")">
                                @marker.GeneSymbol (@marker.VariantName.Split('(')[0].Trim())
                            </span>
                        </label>
                    }
                </div>
            </div>

            <!-- Prominent Severity Call-Out Alert Banners -->
            <div class="mt-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h4 class="m-0-white">Active Clinical Call-Out Alerts (@_genomicProfile.Alerts.Count)</h4>
                    <button class="btn btn-sm btn-primary" @onclick="ApplyGenomicAdjustments">
                        ⚡ Apply Genetic Kinetic Adjustments
                    </button>
                </div>

                @foreach (var alert in _genomicProfile.Alerts)
                {
                    <div class="genomic-alert-box @GetAlertBoxClass(alert.Severity)">
                        <div class="genomic-alert-header">
                            <div>
                                <strong class="text-white-1rem">@alert.Title</strong>
                                <span class="subtext d-block fs-08">@alert.Category</span>
                            </div>
                            <span class="@GetBadgeClass(alert.Severity)">@alert.Severity.ToString().ToUpperInvariant() CALL-OUT</span>
                        </div>
                        <p class="endocrine-desc">@alert.CallOutMessage</p>
                        <div class="genomic-guidance-pill">
                            <div><strong class="text-sky">Clinical Directive:</strong> @alert.ClinicalGuidance</div>
                            @if (!string.IsNullOrEmpty(alert.KineticGuidance))
                            {
                                <div><strong class="text-amber">Kinetics Calibration:</strong> @alert.KineticGuidance</div>
                            }
                            @if (!string.IsNullOrEmpty(alert.ScaffoldGuidance))
                            {
                                <div><strong class="text-fuchsia">DNA Origami Modification:</strong> @alert.ScaffoldGuidance</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Pharmacodynamic Stabilization Simulation -->
    <div class="card panel mt-4">
        <div class="panel-header">
            <h3>72-Hour Hormone Pharmacodynamic Stabilization Curves</h3>
            <span class="badge badge-outline">Continuous Target Plateau</span>
        </div>
        <p class="subtext">Kinetics curve calculated over a 72-hour horizon as aptamer-mediated release reaches homeostatic equilibrium, factoring in patient-specific genetic clearance.</p>

        <!-- Dynamic Dual-Axis HTML5 Canvas Kinetics Visualization -->
        <div class="canvas-box mt-3 mb-4 canvas-panel-bg">
            <canvas id="canvas-endocrine-kinetics" class="canvas-h-320"></canvas>
        </div>

        <div class="table-container mt-3">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Time (Hours)</th>
                        <th>Circulating 17β-Estradiol (pmol/L)</th>
                        <th>Circulating Testosterone (nmol/L)</th>
                        <th>Regulatory State</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (HormoneCurvePoint pt in _kineticsPoints)
                    {
                        <tr>
                            <td class="font-mono text-accent">@pt.Hour h</td>
                            <td class="font-mono">@pt.EstradiolPmolL.ToString("F1") pmol/L</td>
                            <td class="font-mono">@pt.TestosteroneNmolL.ToString("F2") nmol/L</td>
                            <td><span class="badge badge-accent">@(_activeProfile.TargetState)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Hypothalamic-Pituitary-Gonadal (HPG) Axis & Tissue Tropism -->
    <div class="card panel mt-4">
        <div class="panel-header">
            <h3>Hypothalamic-Pituitary-Gonadal (HPG) Axis &amp; Nanocarrier Biodistribution</h3>
            <span class="badge badge-accent">@(_activeProfile.TargetTissue)</span>
        </div>
        <p class="subtext">
            Biomedical anatomical feedback circuit demonstrating localized anterior pituitary gonadotrope delivery, negative feedback loop suppression, and systemic receptor distribution.
        </p>

        <div class="canvas-box mt-3 mb-2 canvas-panel-bg">
            <canvas id="canvas-anatomical-target" class="canvas-h-340"></canvas>
        </div>
    </div>

    <!-- Closed-Loop HPG Axis Dynamic Simulation Panel -->
    <div class="card panel mt-4">
        <div class="panel-header">
            <div>
                <h3>Closed-Loop HPG Axis Dynamic Simulation</h3>
                <span class="subtext">Coupled ODE Runge-Kutta (RK4) integration with LH/FSH negative feedback and aptamer release modulation.</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-primary" @onclick="RunClosedLoopSimulation">
                    ⚡ Recalibrate Closed-Loop Kinetics
                </button>
                @if (_closedLoopResult != null)
                {
                    <span class="badge @(_closedLoopResult.SteadyStateReached ? "badge-accent" : "badge-outline")">
                        @(_closedLoopResult.SteadyStateReached ? "STEADY STATE ACHIEVED" : "TRANSIENT DYNAMICS")
                    </span>
                }
            </div>
        </div>

        @if (_closedLoopResult != null)
        {
            <!-- Dynamic Closed-Loop Metrics Bar -->
            <div class="setpoints-display mt-3 grid-auto-180">
                <div class="setpoint-item">
                    <span class="setpoint-label">FINAL 17β-ESTRADIOL</span>
                    <span class="setpoint-val font-mono">@_closedLoopResult.FinalEstradiolPmolL.ToString("F1") <small>pmol/L</small></span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">FINAL TESTOSTERONE</span>
                    <span class="setpoint-val font-mono">@_closedLoopResult.FinalTestosteroneNmolL.ToString("F2") <small>nmol/L</small></span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">LH SUPPRESSION</span>
                    <span class="setpoint-val font-mono @(_closedLoopResult.FinalLhIuL < 1.0 ? "text-success" : "text-warning")">
                        @_closedLoopResult.FinalLhIuL.ToString("F2") <small>IU/L (@(_closedLoopResult.FinalLhIuL < 1.0 ? "SUPPRESSED" : "ACTIVE"))</small>
                    </span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">FSH SUPPRESSION</span>
                    <span class="setpoint-val font-mono @(_closedLoopResult.FinalFshIuL < 1.5 ? "text-success" : "text-warning")">
                        @_closedLoopResult.FinalFshIuL.ToString("F2") <small>IU/L (@(_closedLoopResult.FinalFshIuL < 1.5 ? "SUPPRESSED" : "ACTIVE"))</small>
                    </span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">CARRIER RELEASE RATE</span>
                    <span class="setpoint-val font-mono">
                        @((_closedLoopResult.Points.Count > 0 ? _closedLoopResult.Points[^1].CarrierReleaseRate : 0.0).ToString("F2"))
                        <small>pmol/(L·h)</small>
                    </span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">TIME TO SUPPRESSION</span>
                    <span class="setpoint-val font-mono">
                        @(_closedLoopResult.TimeToSuppressionHours >= 0 ? $"{_closedLoopResult.TimeToSuppressionHours:F1} h" : "NOT SUPPRESSED")
                    </span>
                </div>
            </div>

            <!-- Trajectory Sample Table -->
            <div class="table-container mt-3">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>17β-Estradiol (pmol/L)</th>
                            <th>Testosterone (nmol/L)</th>
                            <th>LH (IU/L)</th>
                            <th>FSH (IU/L)</th>
                            <th>Aptamer Release Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ClosedLoopPoint pt in GetSampledClosedLoopPoints())
                        {
                            <tr>
                                <td class="font-mono text-accent">@pt.Hour.ToString("F0") h</td>
                                <td class="font-mono">@pt.EstradiolPmolL.ToString("F1")</td>
                                <td class="font-mono">@pt.TestosteroneNmolL.ToString("F2")</td>
                                <td class="font-mono @(pt.LhIuL < 1.0 ? "text-success" : "")">@pt.LhIuL.ToString("F2")</td>
                                <td class="font-mono @(pt.FshIuL < 1.5 ? "text-success" : "")">@pt.FshIuL.ToString("F2")</td>
                                <td class="font-mono text-accent">@pt.CarrierReleaseRate.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Milestone 42: Epigenetic Steroidogenic Enzyme Reprogramming & Bistable Circuit Design Studio -->
    <div id="epigenetic-circuit-studio-panel" class="card panel mt-4">
        <div class="panel-header">
            <div>
                <h3>@Localizer.GetString("EpigeneticCircuit.SectionTitle", _currentLanguage)</h3>
                <span class="subtext">@Localizer.GetString("EpigeneticCircuit.SectionSubtitle", _currentLanguage)</span>
            </div>
            @if (_activeEpigeneticCircuit is not null)
            {
                <span id="epigenetic-approval-badge" class="@GetEpigeneticBadgeClass(_activeEpigeneticCircuit.CircuitStatus)">
                    @GetEpigeneticStatusLabel(_activeEpigeneticCircuit.CircuitStatus)
                </span>
            }
        </div>

        <div class="grid-3 gap-2 mt-3">
            <div>
                <label class="form-label" for="epigenetic-patient-input">@Localizer.GetString("EpigeneticCircuit.PatientIdLabel", _currentLanguage)</label>
                <input id="epigenetic-patient-input" type="text" class="form-control" @bind="_epigeneticPatientId" />
            </div>
            <div>
                <label class="form-label" for="epigenetic-regimen-select">Regimen</label>
                <select id="epigenetic-regimen-select" class="form-control" @bind="_epigeneticRegimen">
                    <option value="@TherapeuticRegimen.MaleToFemale">@TherapeuticRegimen.MaleToFemale</option>
                    <option value="@TherapeuticRegimen.FemaleToMale">@TherapeuticRegimen.FemaleToMale</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="epigenetic-tissue-select">Target Tissue</label>
                <select id="epigenetic-tissue-select" class="form-control" @bind="_epigeneticTargetTissue">
                    <option value="@TargetTissueType.GonadalTarget">@TargetTissueType.GonadalTarget</option>
                    <option value="@TargetTissueType.AdrenalSteroidogenic">@TargetTissueType.AdrenalSteroidogenic</option>
                    <option value="@TargetTissueType.AnteriorPituitaryGonadotrope">@TargetTissueType.AnteriorPituitaryGonadotrope</option>
                    <option value="@TargetTissueType.PeripheralReceptor">@TargetTissueType.PeripheralReceptor</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="epigenetic-effector-select">@Localizer.GetString("EpigeneticCircuit.EffectorLabel", _currentLanguage)</label>
                <select id="epigenetic-effector-select" class="form-control" @bind="_epigeneticEffectorPlatform">
                    <option value="@EpigeneticEffectorPlatform.CrisprOffOn">@EpigeneticEffectorPlatform.CrisprOffOn</option>
                    <option value="@EpigeneticEffectorPlatform.DCas9Dnmt3aTet1">@EpigeneticEffectorPlatform.DCas9Dnmt3aTet1</option>
                    <option value="@EpigeneticEffectorPlatform.DCas9KrabVp64">@EpigeneticEffectorPlatform.DCas9KrabVp64</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="epigenetic-stability-input">@Localizer.GetString("EpigeneticCircuit.StabilityFactorLabel", _currentLanguage)</label>
                <input id="epigenetic-stability-input" type="number" step="0.05" class="form-control" @bind="_epigeneticStabilityFactor" />
            </div>
            <div>
                <label class="form-label" for="epigenetic-notes-input">Clinician Design Notes (AES-256-GCM)</label>
                <input id="epigenetic-notes-input" type="text" class="form-control" @bind="_epigeneticNotes" />
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button id="btn-design-epigenetic-circuit" class="btn btn-primary btn-sm" @onclick="DesignEpigeneticCircuitUiAsync">
                @Localizer.GetString("EpigeneticCircuit.DesignButton", _currentLanguage)
            </button>
            @if (_activeEpigeneticCircuit is not null)
            {
                <button id="btn-evaluate-epigenetic-circuit" class="btn btn-outline btn-sm" @onclick="EvaluateEpigeneticCircuitUiAsync">
                    @Localizer.GetString("EpigeneticCircuit.EvaluateButton", _currentLanguage)
                </button>
                <button id="btn-approve-epigenetic-circuit" class="btn btn-outline btn-sm" @onclick="ApproveEpigeneticCircuitUiAsync">
                    @Localizer.GetString("EpigeneticCircuit.ApproveButton", _currentLanguage)
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_epigeneticErrorMessage))
        {
            <div id="epigenetic-error-banner" class="genomic-alert-critical mt-3">@_epigeneticErrorMessage</div>
        }

        @if (_activeEpigeneticCircuit is not null)
        {
            <div class="setpoints-display mt-3">
                <div class="setpoint-item">
                    <span class="setpoint-label">PREDICTED E2 / T</span>
                    <span class="setpoint-val font-mono">@_activeEpigeneticCircuit.PredictedEstradiolPmolL.ToString("F1", CultureInfo.InvariantCulture) pmol/L • @_activeEpigeneticCircuit.PredictedTestosteroneNmolL.ToString("F2", CultureInfo.InvariantCulture) nmol/L</span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">PREDICTED TTR / MIN CFD</span>
                    <span class="setpoint-val font-mono">@_activeEpigeneticCircuit.PredictedTtrPercent.ToString("F1", CultureInfo.InvariantCulture)% • CFD @_activeEpigeneticCircuit.MinOffTargetSpecificityScore.ToString("F2", CultureInfo.InvariantCulture)%</span>
                </div>
                <div class="setpoint-item">
                    <span class="setpoint-label">BISTABLE SEPARATRIX MARGIN</span>
                    <span class="setpoint-val font-mono">@(_activeEpigeneticCircuit.IsBistable ? "Bistable" : "Monostable") (Δ=@_activeEpigeneticCircuit.SeparatrixMargin.ToString("F3", CultureInfo.InvariantCulture))</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_activeEpigeneticCircuit.SignatureAlgorithm))
                {
                    <div class="setpoint-item">
                        <span class="setpoint-label">PQC SYNTHESIS SEAL</span>
                        <span class="setpoint-val font-mono text-break-all">@_activeEpigeneticCircuit.SignatureAlgorithm • @_activeEpigeneticCircuit.ApprovalSignerKeyId</span>
                    </div>
                }
            </div>

            @if (_activeEpigeneticCircuit.FailureReasons.Count > 0)
            {
                <div class="genomic-alert-critical mt-3">
                    @foreach (string reason in _activeEpigeneticCircuit.FailureReasons)
                    {
                        <div>• @reason</div>
                    }
                </div>
            }

            <div class="mt-3">
                <h4>@Localizer.GetString("EpigeneticCircuit.PhasePlaneTitle", _currentLanguage)</h4>
                <svg id="epigenetic-phase-plane-svg" class="epigenetic-phase-svg" viewBox="0 0 320 220" role="img" aria-label="Bistable Hill Toggle Phase Plane">
                    <line x1="34" y1="14" x2="34" y2="194" class="epigenetic-axis" />
                    <line x1="34" y1="194" x2="308" y2="194" class="epigenetic-axis" />
                    <line x1="34" y1="104" x2="308" y2="104" class="epigenetic-grid" />
                    <line x1="171" y1="14" x2="171" y2="194" class="epigenetic-grid" />
                    <polyline points="@BuildPhasePlanePolyline(_activeEpigeneticCircuit.PhasePlane.EstrogenNullcline)" class="epigenetic-nullcline-e2" />
                    <polyline points="@BuildPhasePlanePolyline(_activeEpigeneticCircuit.PhasePlane.AndrogenNullcline)" class="epigenetic-nullcline-t" />
                    @if (_activeEpigeneticCircuit.PhasePlane.SeparatrixCurve.Count > 1)
                    {
                        <polyline points="@BuildPhasePlanePolyline(_activeEpigeneticCircuit.PhasePlane.SeparatrixCurve)" class="epigenetic-separatrix" />
                    }
                    <circle cx="@ToPhaseSvgX(_activeEpigeneticCircuit.PhasePlane.TargetAttractor.EstrogenAxisNormalized)" cy="@ToPhaseSvgY(_activeEpigeneticCircuit.PhasePlane.TargetAttractor.AndrogenAxisNormalized)" r="5" class="epigenetic-attractor-target" />
                    @if (_activeEpigeneticCircuit.PhasePlane.IsBistable)
                    {
                        <circle cx="@ToPhaseSvgX(_activeEpigeneticCircuit.PhasePlane.AlternateAttractor.EstrogenAxisNormalized)" cy="@ToPhaseSvgY(_activeEpigeneticCircuit.PhasePlane.AlternateAttractor.AndrogenAxisNormalized)" r="4" class="epigenetic-attractor-alt" />
                        <circle cx="@ToPhaseSvgX(_activeEpigeneticCircuit.PhasePlane.SaddlePoint.EstrogenAxisNormalized)" cy="@ToPhaseSvgY(_activeEpigeneticCircuit.PhasePlane.SaddlePoint.AndrogenAxisNormalized)" r="4" class="epigenetic-saddle-pt" />
                    }
                    <text x="145" y="212" class="epigenetic-svg-label">Estrogenic Chromatin (u)</text>
                    <text x="40" y="24" class="epigenetic-svg-label">Androgenic (v)</text>
                </svg>
            </div>

            <div class="mt-3">
                <h4>@Localizer.GetString("EpigeneticCircuit.GuideTableTitle", _currentLanguage)</h4>
                <table id="epigenetic-guide-table" class="table table-dark table-sm mt-2">
                    <thead>
                        <tr>
                            <th>@Localizer.GetString("EpigeneticCircuit.ColTargetGene", _currentLanguage)</th>
                            <th>Mode</th>
                            <th>Protospacer / PAM</th>
                            <th>@Localizer.GetString("EpigeneticCircuit.ColSpecificity", _currentLanguage)</th>
                            <th>@Localizer.GetString("EpigeneticCircuit.ColFoldChange", _currentLanguage)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (EpigeneticGuideRnaRecord guide in _activeEpigeneticCircuit.Guides)
                        {
                            <tr>
                                <td class="font-mono">@guide.TargetGeneSymbol</td>
                                <td class="font-mono">@guide.ModulationMode</td>
                                <td class="font-mono">@guide.ProtospacerSequence (@guide.PamSequence)</td>
                                <td class="font-mono">@guide.CfdSpecificityScore.ToString("F2", CultureInfo.InvariantCulture)%</td>
                                <td class="font-mono">@guide.PredictedFoldChange.ToString("F2", CultureInfo.InvariantCulture)x</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Active endocrine target profile.
    /// </summary>
    /// <remarks>
    /// WHY `null!`: Blazor constructs the component before it can inject services, so this field
    /// cannot be given a real value in a field initializer. OnInitialized assigns it from the
    /// engine before the first render, and every use sits in markup that only runs after that,
    /// so no code path observes the null.
    /// </remarks>
    private EndocrineTargetProfile _activeProfile = null!;

    /// <summary>
    /// Evaluated pharmacogenomic profile for the patient.
    /// </summary>
    /// <remarks>
    /// WHY `null!`: As above, this is assigned during OnInitialized (via SelectPreset) before the
    /// component renders for the first time, which is the earliest point any reader can see it.
    /// </remarks>
    private PatientGenomicProfile _genomicProfile = null!;

    /// <summary>
    /// Currently active community localization language.
    /// </summary>
    private WeaverLanguage _currentLanguage = WeaverLanguage.English;

    /// <summary>
    /// Simulated kinetics curve data points over 72 hours.
    /// </summary>
    private IReadOnlyList<HormoneCurvePoint> _kineticsPoints = [];

    /// <summary>
    /// Simulated closed-loop HPG axis dynamic result.
    /// </summary>
    private ClosedLoopSimulationResult? _closedLoopResult;

    /// <summary>
    /// List of all available catalog genetic markers.
    /// </summary>
    private IReadOnlyList<GeneticMarker> _availableMarkers = [];

    /// <summary>
    /// List of standard clinical demonstration presets.
    /// </summary>
    private IReadOnlyList<GeneticMarkerPreset> _availablePresets = [];

    /// <summary>
    /// Currently selected preset identifier.
    /// </summary>
    private string _activePresetId = "PRESET_BASELINE";

    /// <summary>
    /// Set of actively selected genetic marker IDs.
    /// </summary>
    private readonly HashSet<string> _selectedMarkerIds = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Loads active endocrine profile, catalog markers, and initial genomic evaluation.
    /// </summary>
    protected override void OnInitialized()
    {
        _activeProfile = Engine.GetActiveProfile();
        _availableMarkers = GenomicsService.GetCatalog();
        _availablePresets = GenomicsService.GetPresetProfiles();

        // Default to Baseline preset
        SelectPreset("PRESET_BASELINE");
    }

    /// <summary>
    /// Selects a predefined genetic preset and recalibrates the profile.
    /// </summary>
    /// <param name="presetId">The preset identifier to activate.</param>
    private void SelectPreset(string presetId)
    {
        _activePresetId = presetId;
        _selectedMarkerIds.Clear();

        GeneticMarkerPreset? preset = _availablePresets.FirstOrDefault(p => p.PresetId == presetId);
        if (preset != null)
        {
            foreach (string mid in preset.MarkerIds)
            {
                _selectedMarkerIds.Add(mid);
            }
        }

        ReevaluateGenomics();
    }

    /// <summary>
    /// Toggles a specific genetic marker on or off in the active selection.
    /// </summary>
    /// <param name="markerId">The marker identifier to toggle.</param>
    private void ToggleMarker(string markerId)
    {
        _activePresetId = string.Empty; // Clear preset since user is customizing
        if (!_selectedMarkerIds.Add(markerId))
        {
            _selectedMarkerIds.Remove(markerId);
        }

        ReevaluateGenomics();
    }

    /// <summary>
    /// Clears all selected markers, restoring wild-type baseline.
    /// </summary>
    private void ClearAllMarkers()
    {
        _activePresetId = "PRESET_BASELINE";
        _selectedMarkerIds.Clear();
        ReevaluateGenomics();
    }

    /// <summary>
    /// Reevaluates pharmacogenomics and recalibrates simulated kinetics.
    /// </summary>
    private void ReevaluateGenomics()
    {
        _genomicProfile = GenomicsService.AnalyzeProfile(
            _activeProfile.PatientId,
            _selectedMarkerIds,
            _activeProfile.Regimen);

        _kineticsPoints = Engine.SimulateKinetics(72, 4, _genomicProfile);
        RunClosedLoopSimulation();
    }

    /// <summary>
    /// Applies genetically customized setpoints to the active endocrine engine and updates the visualization.
    /// </summary>
    private async Task ApplyGenomicAdjustments()
    {
        _activeProfile = GenomicsService.ApplyGeneticAdjustments(_activeProfile, _genomicProfile);
        Engine.SetActiveProfile(_activeProfile);
        _kineticsPoints = Engine.SimulateKinetics(72, 4, _genomicProfile);
        RunClosedLoopSimulation();
        await RenderChartAsync();
    }

    /// <summary>
    /// Returns the CSS box class for a given severity level.
    /// </summary>
    private static string GetAlertBoxClass(ClinicalSeverity severity) => severity switch
    {
        ClinicalSeverity.Critical => "genomic-alert-critical",
        ClinicalSeverity.Warning => "genomic-alert-warning",
        ClinicalSeverity.Advisory => "genomic-alert-advisory",
        _ => "genomic-alert-optimal"
    };

    /// <summary>
    /// Returns the CSS badge class for a given severity level.
    /// </summary>
    private static string GetBadgeClass(ClinicalSeverity severity) => severity switch
    {
        ClinicalSeverity.Critical => "genomic-badge-critical",
        ClinicalSeverity.Warning => "genomic-badge-warning",
        ClinicalSeverity.Advisory => "genomic-badge-advisory",
        _ => "genomic-badge-optimal"
    };

    /// <summary>
    /// Renders the HTML5 canvas kinetics curve after DOM is updated and synchronizes persisted language preference.
    /// </summary>
    /// <param name="firstRender">True on initial render.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // WHAT: Reads persisted language preference on initial render.
        // WHY:  Ensures endocrine toggle labels match the client's preferred language.
        // HOW:  Queries 'weaverGetLanguage' via JS interop and triggers StateHasChanged if updated.
        if (firstRender)
        {
            try
            {
                string? storedTag = await JS.InvokeAsync<string?>("weaverGetLanguage");
                if (!string.IsNullOrWhiteSpace(storedTag))
                {
                    _currentLanguage = Localizer.ResolveLanguage(storedTag);
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
                // Headless unit tests or prerendering
            }
        }

        await RenderChartAsync();
    }

    /// <summary>
    /// Invokes the native JavaScript chart renderer with current kinetics points and setpoints.
    /// </summary>
    private async Task RenderChartAsync()
    {
        try
        {
            var pts = _kineticsPoints.Select(p => new { hour = p.Hour, estradiolPmolL = p.EstradiolPmolL, testosteroneNmolL = p.TestosteroneNmolL }).ToArray();
            await JS.InvokeVoidAsync("WeaverVisualizer.renderKineticsChart", "canvas-endocrine-kinetics", pts, _activeProfile.TargetEstradiolPmolL, _activeProfile.TargetTestosteroneNmolL);
            await JS.InvokeVoidAsync("WeaverVisualizer.renderAnatomicalTargeting", "canvas-anatomical-target", new { regimen = _activeProfile.Regimen.ToString(), targetTissue = _activeProfile.TargetTissue.ToString(), kdNanoMolar = _activeProfile.BindingAffinityKdTargetNanoMolar, targetE2 = _activeProfile.TargetEstradiolPmolL, targetT = _activeProfile.TargetTestosteroneNmolL });
        }
        catch (JSDisconnectedException)
        {
            // Circuit disconnected gracefully during navigation
        }
    }

    /// <summary>
    /// Updates the bistable toggle state and refreshes kinetics.
    /// </summary>
    /// <param name="targetState">The target toggle state (Estrogenic vs Androgenic).</param>
    private async Task SetToggleState(ToggleState targetState)
    {
        ToggleSwitchRequest req = new()
        {
            TargetState = targetState
        };
        _activeProfile = Engine.UpdateToggleState(req);
        ReevaluateGenomics();
        await RenderChartAsync();
    }

    /// <summary>
    /// Executes the dynamic closed-loop HPG axis ODE simulation using the current active profile setpoints and genomic clearance.
    /// </summary>
    private void RunClosedLoopSimulation()
    {
        ClosedLoopSimulationRequest req = new()
        {
            TargetState = _activeProfile.TargetState,
            TargetEstradiolPmolL = _activeProfile.TargetEstradiolPmolL,
            TargetTestosteroneNmolL = _activeProfile.TargetTestosteroneNmolL,
            ClearanceMultiplier = _genomicProfile?.OverallClearanceMultiplier ?? 1.0,
            InitialEstradiolPmolL = _activeProfile.TargetState == ToggleState.EstrogenicDominant ? 120.0 : 600.0,
            InitialTestosteroneNmolL = _activeProfile.TargetState == ToggleState.EstrogenicDominant ? 18.0 : 1.5,
            InitialLhIuL = 6.5,
            InitialFshIuL = 5.0,
            TotalHours = 72,
            StepHours = 1.0
        };

        _closedLoopResult = ClosedLoopEngine.Simulate(req);
    }

    /// <summary>
    /// Returns a thinned subset of closed-loop trajectory points suitable for tabular display.
    /// </summary>
    /// <returns>A collection of trajectory points sampled across key intervals.</returns>
    private IEnumerable<ClosedLoopPoint> GetSampledClosedLoopPoints()
    {
        if (_closedLoopResult == null)
        {
            yield break;
        }

        int stepInterval = Math.Max(1, _closedLoopResult.Points.Count / 12);
        for (int i = 0; i < _closedLoopResult.Points.Count; i += stepInterval)
        {
            yield return _closedLoopResult.Points[i];
        }

        if (_closedLoopResult.Points.Count > 0 && (_closedLoopResult.Points.Count - 1) % stepInterval != 0)
        {
            yield return _closedLoopResult.Points[^1];
        }
    }

    /// <summary>
    /// Patient identifier bound to the epigenetic toggle circuit studio form.
    /// </summary>
    private string _epigeneticPatientId = "pat_endocrine_demo";

    /// <summary>
    /// Selected endocrine therapeutic regimen for epigenetic circuit synthesis.
    /// </summary>
    private TherapeuticRegimen _epigeneticRegimen = TherapeuticRegimen.MaleToFemale;

    /// <summary>
    /// Selected anatomical tissue target for epigenetic circuit delivery.
    /// </summary>
    private TargetTissueType _epigeneticTargetTissue = TargetTissueType.GonadalTarget;

    /// <summary>
    /// Selected non-nuclease dCas9 epigenetic effector platform.
    /// </summary>
    private EpigeneticEffectorPlatform _epigeneticEffectorPlatform = EpigeneticEffectorPlatform.CrisprOffOn;

    /// <summary>
    /// Chromatin heritability stability scaling multiplier evaluated during stress testing.
    /// </summary>
    private double _epigeneticStabilityFactor = 1.0;

    /// <summary>
    /// Optional clinician design notes encrypted via AES-256-GCM when persisted.
    /// </summary>
    private string _epigeneticNotes = "Canonical endogenous steroidogenic toggle switch";

    /// <summary>
    /// Validation or safety error message displayed inside the epigenetic studio panel.
    /// </summary>
    private string? _epigeneticErrorMessage;

    /// <summary>
    /// Active evaluated or approved epigenetic circuit report displayed in the studio panel.
    /// </summary>
    private EpigeneticCircuitEvaluationReport? _activeEpigeneticCircuit;

    /// <summary>
    /// Designs and evaluates a new patient-specific epigenetic toggle circuit from the form inputs.
    /// </summary>
    /// <returns>A task representing the asynchronous design operation.</returns>
    private async Task DesignEpigeneticCircuitUiAsync()
    {
        // WHAT: Builds a DesignEpigeneticCircuitRequest from panel inputs and invokes EpigeneticCircuitService.
        // WHY:  Milestone 42 (P223): Enables clinicians to generate and analyze permanent epigenetic switches interactively.
        // HOW:  Clears prior errors, invokes DesignCircuitAsync, updates _activeEpigeneticCircuit, and captures validation exceptions.
        _epigeneticErrorMessage = null;
        try
        {
            DesignEpigeneticCircuitRequest req = new()
            {
                PatientId = _epigeneticPatientId,
                Regimen = _epigeneticRegimen,
                TargetTissue = _epigeneticTargetTissue,
                EffectorPlatform = _epigeneticEffectorPlatform,
                Notes = _epigeneticNotes
            };
            _activeEpigeneticCircuit = await EpigeneticCircuitService.DesignCircuitAsync(req, "endocrine_ui");
        }
        catch (Exception ex)
        {
            _epigeneticErrorMessage = ex.Message;
        }
    }

    /// <summary>
    /// Re-evaluates Hill bistability and endocrine setpoints for the active circuit under configured stability stress.
    /// </summary>
    /// <returns>A task representing the asynchronous evaluation operation.</returns>
    private async Task EvaluateEpigeneticCircuitUiAsync()
    {
        // WHAT: Invokes EvaluateCircuitAsync with the panel's chromatin stability factor.
        // WHY:  Demonstrates bistable attractor resilience vs monostable collapse prior to approval.
        // HOW:  Guards for active circuit, invokes EvaluateCircuitAsync, and refreshes panel state or error message.
        if (_activeEpigeneticCircuit is null)
        {
            return;
        }

        _epigeneticErrorMessage = null;
        try
        {
            EvaluateEpigeneticCircuitRequest req = new()
            {
                ClearanceMultiplier = _genomicProfile?.OverallClearanceMultiplier ?? 1.0,
                EpigeneticStabilityFactor = _epigeneticStabilityFactor
            };
            _activeEpigeneticCircuit = await EpigeneticCircuitService.EvaluateCircuitAsync(
                _activeEpigeneticCircuit.CircuitId,
                req,
                "endocrine_ui");
        }
        catch (Exception ex)
        {
            _epigeneticErrorMessage = ex.Message;
        }
    }

    /// <summary>
    /// Attempts fail-closed NIST FIPS 204 ML-DSA-65 permanent synthesis sign-off for the active circuit.
    /// </summary>
    /// <returns>A task representing the asynchronous approval operation.</returns>
    private async Task ApproveEpigeneticCircuitUiAsync()
    {
        // WHAT: Invokes ApproveCircuitAsync to either mint an ML-DSA-65 signature or lock status to Blocked.
        // WHY:  Enforces fail-closed synthesis gating visibly inside #epigenetic-approval-badge.
        // HOW:  Supplies active stability/clearance parameters to ApproveCircuitAsync and updates rendered state.
        if (_activeEpigeneticCircuit is null)
        {
            return;
        }

        _epigeneticErrorMessage = null;
        try
        {
            ApproveEpigeneticCircuitRequest req = new()
            {
                ReviewerNotes = "Approved via Endocrine Regulatory Hub UI",
                ClearanceMultiplier = _genomicProfile?.OverallClearanceMultiplier ?? 1.0,
                EpigeneticStabilityFactor = _epigeneticStabilityFactor
            };
            _activeEpigeneticCircuit = await EpigeneticCircuitService.ApproveCircuitAsync(
                _activeEpigeneticCircuit.CircuitId,
                req,
                "endocrine_ui");
        }
        catch (Exception ex)
        {
            _epigeneticErrorMessage = ex.Message;
        }
    }

    /// <summary>
    /// Maps an <see cref="EpigeneticCircuitStatus"/> value to its accessible high-contrast badge CSS class.
    /// </summary>
    /// <param name="status">Current epigenetic circuit approval status.</param>
    /// <returns>CSS badge class string.</returns>
    private static string GetEpigeneticBadgeClass(EpigeneticCircuitStatus status) => status switch
    {
        EpigeneticCircuitStatus.Approved => "genomic-badge-optimal",
        EpigeneticCircuitStatus.Blocked => "genomic-badge-critical animate-pulse",
        _ => "badge-amber"
    };

    /// <summary>
    /// Resolves the localized plain-English approval banner text for an <see cref="EpigeneticCircuitStatus"/>.
    /// </summary>
    /// <param name="status">Current epigenetic circuit approval status.</param>
    /// <returns>Localized approval or fail-closed block text.</returns>
    private string GetEpigeneticStatusLabel(EpigeneticCircuitStatus status) => status switch
    {
        EpigeneticCircuitStatus.Approved => Localizer.GetString("EpigeneticCircuit.BadgeApproved", _currentLanguage),
        EpigeneticCircuitStatus.Blocked => Localizer.GetString("EpigeneticCircuit.BadgeBlocked", _currentLanguage),
        _ => Localizer.GetString("EpigeneticCircuit.BadgeEvaluated", _currentLanguage)
    };

    /// <summary>
    /// Projects a sequence of phase-plane coordinates into an SVG polyline points string.
    /// </summary>
    /// <param name="points">Ordered normalized phase-plane points.</param>
    /// <returns>Space-delimited <c>x,y</c> SVG polyline coordinates formatted invariantly.</returns>
    private static string BuildPhasePlanePolyline(IReadOnlyList<PhasePlanePoint> points)
    {
        // WHAT: Converts normalized phase-plane coordinates (u, v) into SVG polyline point pairs.
        // WHY:  Plots deterministic dark-mode SVG nullclines and separatrix curves without JS canvas dependencies.
        // HOW:  Iterates points linearly using StringBuilder and invariant decimal formatting.
        StringBuilder sb = new(points.Count * 12);
        for (int i = 0; i < points.Count; i++)
        {
            if (i > 0)
            {
                sb.Append(' ');
            }

            sb.Append(ToPhaseSvgX(points[i].EstrogenAxisNormalized));
            sb.Append(',');
            sb.Append(ToPhaseSvgY(points[i].AndrogenAxisNormalized));
        }

        return sb.ToString();
    }

    /// <summary>
    /// Maps a normalized estrogen axis value <c>u</c> in [0, 1.25] into SVG horizontal pixel coordinates.
    /// </summary>
    /// <param name="uNormalized">Normalized estrogenic chromatin coordinate.</param>
    /// <returns>Invariant decimal string representing horizontal SVG pixel offset.</returns>
    private static string ToPhaseSvgX(double uNormalized)
    {
        // WHAT: Linearly transforms u in [0, 1.25] into plot viewport [34, 308].
        // WHY:  Ensures consistent SVG axis alignment across attractors, saddle, and nullclines.
        // HOW:  Clamps normalized coordinate and interpolates linearly.
        double clamped = Math.Clamp(uNormalized, 0.0, 1.25) / 1.25;
        double px = 34.0 + (clamped * 274.0);
        return px.ToString("F1", CultureInfo.InvariantCulture);
    }

    /// <summary>
    /// Maps a normalized androgen axis value <c>v</c> in [0, 1.25] into inverted SVG vertical pixel coordinates.
    /// </summary>
    /// <param name="vNormalized">Normalized androgenic chromatin coordinate.</param>
    /// <returns>Invariant decimal string representing vertical SVG pixel offset.</returns>
    private static string ToPhaseSvgY(double vNormalized)
    {
        // WHAT: Linearly transforms v in [0, 1.25] into plot viewport [194, 14] (bottom to top).
        // WHY:  SVG vertical coordinates increase downward, requiring inversion for standard Cartesian orientation.
        // HOW:  Clamps normalized coordinate and subtracts scaled height from baseline 194.
        double clamped = Math.Clamp(vNormalized, 0.0, 1.25) / 1.25;
        double py = 194.0 - (clamped * 180.0);
        return py.ToString("F1", CultureInfo.InvariantCulture);
    }
}
