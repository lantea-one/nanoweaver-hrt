@page "/services"
@using NanoWeaverHrt.Hardware.Benchmarking
@inject IStackServiceManager StackManager
@inject IConfigurationRepository ConfigRepo
@inject IAcceleratorBenchmarkService BenchmarkService

<div class="services-container">
    <div class="panel-header">
        <div>
            <h2>Stack Services Management &amp; Topology</h2>
            <p class="panel-desc">Single point of control, diagnostic health, and hardware telemetry for all components in the sovereign stack.</p>
        </div>
        <div class="actions">
            <button class="btn btn-secondary btn-sm" disabled="@_isRefreshing" @onclick="RefreshServicesAsync">
                @(_isRefreshing ? "Probing Stack..." : "⟳ Refresh Services")
            </button>
        </div>
    </div>

    <!-- Stack Service Topology Visual Cards -->
    <div class="services-grid mt-3">
        @foreach (StackServiceInfo svc in _services)
        {
            <div class="service-card card @GetCardBorderClass(svc.Health)">
                <div class="service-header">
                    <div>
                        <h3>@svc.DisplayName</h3>
                        <div class="service-tech font-mono">@svc.TechnologyStack</div>
                    </div>
                    <span class="badge @GetBadgeClass(svc.Health)">@svc.Health</span>
                </div>

                <p class="service-role subtext mt-2">@svc.RoleDescription</p>

                <div class="service-endpoint font-mono mt-2">
                    <span class="endpoint-label">ENDPOINT:</span>
                    <span class="endpoint-val">@svc.EndpointOrLocation</span>
                </div>

                <div class="service-status-bar mt-2">
                    <span class="status-indicator-dot @(svc.Health == ServiceHealthState.Healthy ? "dot-green" : "dot-amber")"></span>
                    <span class="status-text">@svc.StatusMessage</span>
                </div>

                <!-- Service-Specific Telemetry Metrics -->
                <div class="service-metrics mt-3">
                    <div class="metrics-title">DIAGNOSTIC TELEMETRY</div>
                    <div class="metrics-list font-mono">
                        @foreach (KeyValuePair<string, string> metric in svc.Metrics)
                        {
                            <div class="metric-row">
                                <span class="metric-name">@metric.Key:</span>
                                <span class="metric-val text-accent">@metric.Value</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="service-actions mt-3 text-right">
                    <button class="btn btn-outline btn-sm" @onclick="() => PingServiceAsync(svc.ServiceId)">
                        ⚡ Test Connectivity
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Accelerator Hardware Qualification Diagnostic Card -->
    <div class="card panel mt-4 accelerator-benchmark-card">
        <div class="panel-header">
            <div>
                <h3>Hardware Accelerator Qualification &amp; Benchmark</h3>
                <p class="panel-desc">Deterministic FP32/FP64 compute and memory transfer qualification metrics for molecular dynamics simulation engines.</p>
            </div>
            <div class="actions">
                <button class="btn btn-primary btn-sm btn-run-benchmark" disabled="@_isBenchmarking" @onclick="RunBenchmarkAsync">
                    @(_isBenchmarking ? "Running Qualification..." : "Run Hardware Qualification")
                </button>
            </div>
        </div>

        @if (_benchmarkReport is null)
        {
            <div class="empty-state mt-3 p-3">
                <p>No accelerator benchmark report is currently available. Run hardware qualification to measure compute throughput and memory bandwidth.</p>
            </div>
        }
        else
        {
            <div class="benchmark-details mt-3">
                <div class="benchmark-device-header mb-3">
                    <div>
                        <span class="benchmark-device-name font-mono text-accent">@_benchmarkReport.DeviceName</span>
                        <span class="benchmark-driver-version subtext ml-2 font-mono">(@_benchmarkReport.DriverVersion)</span>
                    </div>
                    <span class="badge @GetReadinessBadgeClass(_benchmarkReport.Readiness) benchmark-readiness-badge">
                        @_benchmarkReport.Readiness
                    </span>
                </div>

                <div class="benchmark-metrics-grid">
                    <div class="benchmark-metric-box">
                        <div class="benchmark-metric-label">SINGLE-PRECISION (FP32)</div>
                        <div class="benchmark-metric-value fp32-throughput">@_benchmarkReport.SinglePrecisionGflops.ToString("F2") GFLOPS</div>
                    </div>
                    <div class="benchmark-metric-box">
                        <div class="benchmark-metric-label">DOUBLE-PRECISION (FP64)</div>
                        <div class="benchmark-metric-value fp64-throughput">@_benchmarkReport.DoublePrecisionGflops.ToString("F2") GFLOPS</div>
                    </div>
                    <div class="benchmark-metric-box">
                        <div class="benchmark-metric-label">MEMORY BANDWIDTH</div>
                        <div class="benchmark-metric-value memory-bandwidth">@_benchmarkReport.MemoryBandwidthGigaBytesPerSecond.ToString("F2") GB/s</div>
                    </div>
                </div>

                <div class="benchmark-telemetry-strip mt-3 font-mono">
                    <span class="endpoint-label">THERMAL:</span>
                    <span class="text-accent benchmark-temp">@_benchmarkReport.TemperatureCelsius.ToString("F1") °C</span>
                    <span class="endpoint-label ml-3">POWER:</span>
                    <span class="text-accent benchmark-power">@_benchmarkReport.PowerUsageWatts.ToString("F1") W</span>
                    <span class="endpoint-label ml-3">COMPLETED:</span>
                    <span class="subtext benchmark-time">@_benchmarkReport.BenchmarkTimestampUtc.ToString("u")</span>
                </div>

                @if (_benchmarkReport.Recommendations is { Count: > 0 })
                {
                    <div class="recommendations-box mt-3">
                        <div class="benchmark-metric-label mb-1">OPERATIONAL RECOMMENDATIONS:</div>
                        <ul class="recommendations-list">
                            @foreach (string rec in _benchmarkReport.Recommendations)
                            {
                                <li class="subtext recommendation-item">@rec</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Deep-Dive Stack Volume Explorers -->
    <div class="grid-2col mt-4">
        <!-- Simulation Presets Explorer -->
        <div class="card panel">
            <div class="panel-header">
                <h3>Simulation Presets &amp; Input Decks</h3>
                <span class="badge badge-outline">Volume: /workspace/configs</span>
            </div>
            <p class="subtext">Engine control decks discovered in <code>simulations/configs/</code> ready for oxDNA or LAMMPS.</p>
            <div class="table-container mt-2">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Deck File Name</th>
                            <th>Engine Target</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_simulationConfigs.Count == 0)
                        {
                            <tr><td colspan="3" class="empty-state">No config templates discovered in simulations/configs/.</td></tr>
                        }
                        else
                        {
                            @foreach (string cfg in _simulationConfigs)
                            {
                                <tr>
                                    <td class="font-mono text-accent">@cfg</td>
                                    <td class="font-mono">@(cfg.EndsWith(".in") ? "LAMMPS" : "oxDNA")</td>
                                    <td><span class="badge badge-accent">Ready</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Parquet Analytics Catalog -->
        <div class="card panel">
            <div class="panel-header">
                <h3>Columnar Parquet Storage (pg_duckdb)</h3>
                <span class="badge badge-outline">Volume: /workspace/parquet</span>
            </div>
            <p class="subtext">Columnar Apache Parquet partitions queried with SIMD-vectorized zero-copy SQL.</p>
            <div class="table-container mt-2">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Parquet Partition</th>
                            <th>Compression</th>
                            <th>Analytics Engine</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_parquetFiles.Count == 0)
                        {
                            <tr><td colspan="3" class="empty-state">No Parquet files serialized yet. Convert trajectories in Stage 4.</td></tr>
                        }
                        else
                        {
                            @foreach (string pf in _parquetFiles)
                            {
                                <tr>
                                    <td class="font-mono text-accent">@pf</td>
                                    <td class="font-mono">SNAPPY</td>
                                    <td class="subtext">DuckDB SIMD Queryable</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Collection of stack service telemetry objects.
    /// </summary>
    private IReadOnlyList<StackServiceInfo> _services = [];

    /// <summary>
    /// Discovered simulation configuration files on disk.
    /// </summary>
    private IReadOnlyList<string> _simulationConfigs = [];

    /// <summary>
    /// Discovered columnar Parquet files on disk.
    /// </summary>
    private List<string> _parquetFiles = [];

    /// <summary>
    /// Current hardware accelerator qualification benchmark report, if any.
    /// </summary>
    private AcceleratorBenchmarkReport? _benchmarkReport;

    /// <summary>
    /// Refreshing state flag for stack services.
    /// </summary>
    private bool _isRefreshing;

    /// <summary>
    /// Indicates whether a hardware qualification benchmark is actively executing.
    /// </summary>
    private bool _isBenchmarking;

    /// <summary>
    /// Loads initial service states, volume catalogs, and the latest cached accelerator benchmark report.
    /// </summary>
    /// <returns>A task representing the asynchronous initialization operation.</returns>
    protected override async Task OnInitializedAsync()
    {
        await RefreshServicesAsync();
        _benchmarkReport = await BenchmarkService.GetLatestReportAsync();
    }

    /// <summary>
    /// Re-probes all stack services and refreshes volume listings.
    /// </summary>
    /// <returns>A task representing the asynchronous refresh operation.</returns>
    private async Task RefreshServicesAsync()
    {
        _isRefreshing = true;
        try
        {
            _services = await StackManager.GetStackServicesAsync();
            _simulationConfigs = StackManager.GetDiscoveredSimulationConfigs();

            string parquetDir = await ConfigRepo.GetValueAsync("Storage:TrajectoryParquetDir", "./simulations/parquet");
            if (Directory.Exists(parquetDir))
            {
                _parquetFiles = Directory.GetFiles(parquetDir, "*.parquet")
                    .Select(Path.GetFileName)
                    .Where(f => !string.IsNullOrEmpty(f))
                    .Cast<string>()
                    .ToList();
            }
        }
        finally
        {
            _isRefreshing = false;
        }
    }

    /// <summary>
    /// Triggers on-demand hardware accelerator compute and memory benchmark qualification.
    /// </summary>
    /// <returns>A task representing the asynchronous benchmark execution.</returns>
    private async Task RunBenchmarkAsync()
    {
        _isBenchmarking = true;
        try
        {
            _benchmarkReport = await BenchmarkService.RunBenchmarkAsync();
        }
        finally
        {
            _isBenchmarking = false;
        }
    }

    /// <summary>
    /// Pings an individual service by identifier.
    /// </summary>
    /// <param name="serviceId">The service identifier.</param>
    /// <returns>A task representing the asynchronous ping operation.</returns>
    private async Task PingServiceAsync(string serviceId)
    {
        await StackManager.PingServiceAsync(serviceId);
        _services = await StackManager.GetStackServicesAsync();
    }

    /// <summary>
    /// Resolves CSS badge classes for health status.
    /// </summary>
    /// <param name="state">The health state of the service.</param>
    /// <returns>CSS classes for rendering the health badge.</returns>
    private static string GetBadgeClass(ServiceHealthState state) => state switch
    {
        ServiceHealthState.Healthy => "badge-accent",
        ServiceHealthState.DegradedOrFallback => "badge-outline",
        ServiceHealthState.Busy => "badge-accent",
        _ => "badge-rose"
    };

    /// <summary>
    /// Resolves CSS border highlight classes for health cards.
    /// </summary>
    /// <param name="state">The health state of the service.</param>
    /// <returns>CSS classes for card border highlight.</returns>
    private static string GetCardBorderClass(ServiceHealthState state) => state switch
    {
        ServiceHealthState.Healthy => "border-healthy",
        ServiceHealthState.DegradedOrFallback => "border-fallback",
        _ => "border-offline"
    };

    /// <summary>
    /// Resolves CSS badge classes for accelerator hardware readiness score.
    /// </summary>
    /// <param name="readiness">The computed hardware readiness rating.</param>
    /// <returns>CSS classes for rendering high-contrast readiness badges.</returns>
    private static string GetReadinessBadgeClass(HardwareReadinessScore readiness) => readiness switch
    {
        HardwareReadinessScore.Go => "badge-accent badge-green",
        HardwareReadinessScore.Marginal => "badge-outline badge-amber",
        HardwareReadinessScore.Insufficient => "badge-rose badge-red",
        _ => "badge-outline"
    };
}
