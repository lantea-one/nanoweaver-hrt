@page "/depot-studio"
@using System.Globalization
@using System.Text
@using System.Text.Json
@using NanoWeaverHrt.Endocrine
@using NanoWeaverHrt.Fabrication
@using NanoWeaverHrt.Federation
@using NanoWeaverHrt.Localization
@using NanoWeaverHrt.Models
@using NanoWeaverHrt.Storage
@inject ITimeReleaseDepotService DepotService
@inject IDepotCalibrationService CalibrationService
@inject IDepotFormulationRepository DepotRepository
@inject IDepotAssayRepository AssayRepository
@inject IFabricationLotRepository LotRepository
@inject IFabricationLotService LotService
@inject IPeerKeyRegistry PeerKeyRegistry
@inject IFederatedPeerSyncService PeerSyncService
@inject IColdChainStabilityService ColdChainService
@inject IClinicalPharmacovigilanceService PharmacovigilanceService
@inject IMultiYearHomeostasisService MultiYearService
@inject IWeaverLocalizer Localizer
@inject IJSRuntime JS

<section class="card panel" role="region" aria-label="180-Day Depot Studio Header">
    <div class="panel-header">
        <div>
            <h2>180-Day Semi-Annual Time-Release Depot Studio</h2>
            <p class="panel-desc">Sovereign Pharmacokinetic Modeling &bull; Zero-Order Nanocarrier Elution &bull; Subcutaneous Matrix Kinetics &bull; HPG Axis Suppression</p>
        </div>
        <div class="status-indicator">
            <span class="status-indicator-dot dot-green" aria-hidden="true"></span>
            <span class="font-mono text-accent">180-DAY DEPOT ENGINE ACTIVE</span>
        </div>
    </div>
</section>

<!-- Interactive Parameter Configuration Workstation -->
<section class="card panel mt-3" role="region" aria-label="Depot Formulation Parameter Configuration">
    <div class="panel-header">
        <div>
            <h3>Depot Formulation &amp; Biomaterial Parameters</h3>
            <p class="subtext">Configure polymer matrix carrier, loaded hormone mass, and nominal erosion degradation rate for 6-month sustained delivery.</p>
        </div>
    </div>

    <div class="telemetry-grid mt-3">
        <!-- Regimen Selection -->
        <div class="form-group">
            <label class="form-label" for="select-regimen">Therapeutic Regimen</label>
            <select id="select-regimen" class="form-control" value="@_selectedRegimen" @onchange="HandleRegimenChanged" aria-label="Target Therapeutic Regimen">
                <option value="@TherapeuticRegimen.MaleToFemale">Feminizing HRT (E2 Dominant)</option>
                <option value="@TherapeuticRegimen.FemaleToMale">Masculinizing HRT (T Dominant)</option>
            </select>
            <span class="form-hint">Governs physiological target setpoints and HPG feedback.</span>
        </div>

        <!-- Polymer Matrix Type -->
        <div class="form-group">
            <label class="form-label" for="select-matrix">Polymer Matrix Carrier</label>
            <select id="select-matrix" class="form-control" @bind="_selectedMatrix" aria-label="Biocompatible Polymer Matrix Composition">
                <option value="@PolymerMatrixType.PlgaPegPlga">PLGA-PEG-PLGA Triblock Hydrogel</option>
                <option value="@PolymerMatrixType.AlginateChitosan">Alginate-Chitosan Complex</option>
                <option value="@PolymerMatrixType.CyclodextrinScaffold">Cyclodextrin Porous Scaffold</option>
                <option value="@PolymerMatrixType.CrosslinkedHydrogel">Covalently Crosslinked PEG/Methacrylate</option>
            </select>
            <span class="form-hint">Defines matrix pore diffusion and erosion mechanics.</span>
        </div>

        <!-- Initial Payload Mass (mg) -->
        <div class="form-group">
            <label class="form-label" for="input-initial-mass">Initial Nanocarrier Mass (mg)</label>
            <input id="input-initial-mass" type="number" class="form-control font-mono" @bind="_initialMassMg" step="0.5" min="1.0" max="2000.0" aria-label="Initial Nanocarrier Mass in milligrams" />
            <span class="form-hint">Total hormone payload loaded into the subcutaneous depot (16–20 mg MtF, 1000–1050 mg FtM).</span>
        </div>

        <!-- Daily Erosion Degradation Rate (%/day) -->
        <div class="form-group">
            <label class="form-label" for="input-erosion-rate">Nominal Daily Erosion Rate (%/day)</label>
            <input id="input-erosion-rate" type="number" class="form-control font-mono" @bind="_dailyErosionRatePercent" step="0.05" min="0.1" max="5.0" aria-label="Nominal Daily Erosion Rate in percent per day" />
            <span class="form-hint">Hydrolytic matrix degradation rate governing steady-state elution (default 0.55%/day).</span>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 mt-4">
        <button id="btn-run-depot-simulation" class="btn btn-primary" @onclick="RunSimulation" aria-label="Execute 180-Day Depot Kinetic Simulation">
            <span>⚡</span> Run 180-Day Simulation
        </button>
        <button id="btn-reset-depot-defaults" class="btn btn-outline" @onclick="ResetDefaults" aria-label="Reset Formulation Parameters to Clinical Defaults">
            Reset Defaults
        </button>
    </div>
</section>

@if (_simulationResult != null)
{
    var verdict = GetClinicalVerdict();

    <!-- Clinical Performance Verdict Banner -->
    <section class="card panel mt-4" role="region" aria-label="Clinical Verdict and Performance Summary">
        <div class="panel-header">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @verdict.BadgeClass">@verdict.Label</span>
                    <span class="badge badge-outline font-mono">180-DAY HORIZON</span>
                </div>
                <p class="mt-2 text-main">@verdict.Explanation</p>
            </div>
        </div>

        <!-- Key Clinical Metrics Grid -->
        <div class="telemetry-grid mt-3">
            <!-- Time In Target Range (TTR %) -->
            <div class="card stat-card">
                <div class="stat-label">TIME IN TARGET RANGE</div>
                <div class="stat-value font-mono @(_simulationResult.TimeInTargetRangePercent >= 95.0 ? "text-success" : "text-danger")">
                    @_simulationResult.TimeInTargetRangePercent.ToString("F1")%
                </div>
                <div class="stat-sub">Clinical Benchmark: &ge; 95.0%</div>
            </div>

            <!-- Burst Phase Release Fraction -->
            <div class="card stat-card">
                <div class="stat-label">PHASE I BURST FRACTION</div>
                <div class="stat-value font-mono @(_simulationResult.BurstSuppressed ? "text-success" : "text-danger")">
                    @((_simulationResult.Day7BurstFraction * 100.0).ToString("F2"))%
                </div>
                <div class="stat-sub">Day 7 Threshold: &le; 5.00%</div>
            </div>

            <!-- Steady-State Daily Release Rate -->
            <div class="card stat-card">
                <div class="stat-label">STEADY-STATE RATE</div>
                <div class="stat-value font-mono text-accent">
                    @_simulationResult.AverageDailyReleaseMg.ToString("F3") <small class="text-muted">mg/day</small>
                </div>
                <div class="stat-sub">Phase II Plateau Mean Delivery</div>
            </div>

            <!-- Terminal Depletion / Re-Dosing Day -->
            <div class="card stat-card">
                <div class="stat-label">TERMINAL RE-DOSING DAY</div>
                <div class="stat-value font-mono @(_simulationResult.ReDosingAlertDay > 0 ? "text-accent" : "text-success")">
                    @(_simulationResult.ReDosingAlertDay > 0 ? $"Day {_simulationResult.ReDosingAlertDay}" : "Day 180")
                </div>
                <div class="stat-sub">Reserve: @((_simulationResult.TerminalReserveFraction * 100.0).ToString("F1"))% remaining</div>
            </div>
        </div>
    </section>

    <!-- Semi-Annual Re-Dosing Countdown Widget -->
    <section class="card panel mt-4" role="region" aria-label="Semi-Annual Re-Dosing Countdown Widget">
        <div class="panel-header">
            <div>
                <h3>Semi-Annual Re-Dosing Countdown &amp; Payload Depletion</h3>
                <p class="subtext">Monitors continuous depot payload consumption across the 180-day cycle to forecast next scheduled clinical administration.</p>
            </div>
            <div class="badge @(_simulationResult.ReDosingAlertDay > 0 ? "badge-warning" : "badge-outline") font-mono">
                @(_simulationResult.ReDosingAlertDay > 0 ? $"ALERT AT DAY {_simulationResult.ReDosingAlertDay}" : "FULL 180-DAY COVERAGE")
            </div>
        </div>

        <div class="mt-3">
            <div class="d-flex justify-content-between font-mono subtext mb-1">
                <span>Day 0 (Depot Implantation)</span>
                <span>Day @(_simulationResult.ReDosingAlertDay > 0 ? _simulationResult.ReDosingAlertDay : 180) (Re-Dosing Horizon)</span>
                <span>Day 180 (Cycle Complete)</span>
            </div>
            <progress class="w-100" value="@(_simulationResult.ReDosingAlertDay > 0 ? _simulationResult.ReDosingAlertDay : 180)" max="180" aria-label="180-day depot countdown progress"></progress>
        </div>

        <div class="telemetry-grid mt-3">
            <div class="card stat-card">
                <div class="stat-label">RE-DOSING COUNTDOWN</div>
                <div class="stat-value font-mono text-accent">
                    @(_simulationResult.ReDosingAlertDay > 0 ? $"{_simulationResult.ReDosingAlertDay} Days" : "180 Days")
                </div>
                <div class="stat-sub">Autonomous Schedule Threshold</div>
            </div>
            <div class="card stat-card">
                <div class="stat-label">FINAL RESERVE MASS</div>
                <div class="stat-value font-mono">
                    @(_simulationResult.Points[^1].RemainingReserveMg.ToString("F2")) <small class="text-muted">mg</small>
                </div>
                <div class="stat-sub">Of initial @_initialMassMg.ToString("F1") mg payload</div>
            </div>
            <div class="card stat-card">
                <div class="stat-label">LH SUPPRESSION</div>
                <div class="stat-value font-mono @(_simulationResult.LhSuppressionAchieved ? "text-success" : "text-danger")">
                    @(_simulationResult.LhSuppressionAchieved ? "ACHIEVED (< 1.0 IU/L)" : "UNSUPPRESSED")
                </div>
                <div class="stat-sub">Final LH: @_simulationResult.FinalLhIuL.ToString("F2") IU/L</div>
            </div>
            <div class="card stat-card">
                <div class="stat-label">FSH SUPPRESSION</div>
                <div class="stat-value font-mono @(_simulationResult.FshSuppressionAchieved ? "text-success" : "text-danger")">
                    @(_simulationResult.FshSuppressionAchieved ? "ACHIEVED (< 1.5 IU/L)" : "UNSUPPRESSED")
                </div>
                <div class="stat-sub">Final FSH: @_simulationResult.FinalFshIuL.ToString("F2") IU/L</div>
            </div>
        </div>
    </section>

    <!-- 180-Day Multi-Phase Trajectory Visualization -->
    <section class="card panel mt-4" role="region" aria-label="180-Day Pharmacokinetic Multi-Phase Trajectory Chart">
        <div class="panel-header">
            <div>
                <h3>180-Day Multi-Phase Elution &amp; Depletion Trajectory</h3>
                <p class="subtext">Phase I Burst Suppression (Days 1–7) &bull; Phase II Zero-Order Steady-State Plateau (Days 8–150) &bull; Phase III First-Order Terminal Taper (Days 151–180)</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-accent font-mono">CYAN: CUMULATIVE RELEASE</span>
                <span class="badge badge-outline font-mono">AMBER: REMAINING RESERVE</span>
                @if (_calibrationResult != null)
                {
                    <span class="badge badge-success font-mono">EMERALD: RECALIBRATED</span>
                    <span class="badge badge-danger font-mono">ROSE: OBSERVED ASSAYS</span>
                }
            </div>
        </div>

        <div class="chart-container mt-3">
            <svg viewBox="0 0 720 240" class="w-100" role="img" aria-label="180-Day Depot Release Trajectory Graph">
                <title>180-Day Depot Release Trajectory</title>
                <desc>Displays cumulative payload fraction eluted, remaining unreleased payload reserve, recalibrated curve, and observed longitudinal serum assay markers across 180 simulation days.</desc>

                <!-- Phase Division Shading -->
                <!-- Phase I: Days 1 to 7 -->
                <rect x="50" y="30" width="25" height="170" fill="rgba(0, 210, 255, 0.05)" />
                <!-- Phase II: Days 8 to 150 -->
                <rect x="75" y="30" width="508" height="170" fill="rgba(16, 185, 129, 0.04)" />
                <!-- Phase III: Days 151 to 180 -->
                <rect x="583" y="30" width="107" height="170" fill="rgba(245, 158, 11, 0.05)" />

                <!-- Gridlines -->
                <line x1="50" y1="40" x2="690" y2="40" stroke="#1f2d42" stroke-dasharray="2,2" />
                <line x1="50" y1="80" x2="690" y2="80" stroke="#1f2d42" stroke-dasharray="2,2" />
                <line x1="50" y1="120" x2="690" y2="120" stroke="#1f2d42" stroke-dasharray="2,2" />
                <line x1="50" y1="160" x2="690" y2="160" stroke="#1f2d42" stroke-dasharray="2,2" />
                <line x1="50" y1="200" x2="690" y2="200" stroke="#334155" />
                <line x1="50" y1="200" x2="50" y2="30" stroke="#334155" />

                <!-- Phase Divider Vertical Lines -->
                <line x1="75" y1="30" x2="75" y2="200" stroke="#00f2fe" stroke-dasharray="3,3" />
                <line x1="583" y1="30" x2="583" y2="200" stroke="#f59e0b" stroke-dasharray="3,3" />

                <!-- Trajectory Curve: Baseline Cumulative Release Fraction (Cyan; dashed once recalibrated) -->
                <path d="@GetCumulativeReleasePath(_simulationResult)" fill="none" stroke="#00f2fe" stroke-width="2.5" stroke-dasharray="@(_calibrationResult != null ? "5,3" : null)" />

                <!-- Trajectory Curve: Remaining Payload Reserve (Amber) -->
                <path d="@GetRemainingReservePath()" fill="none" stroke="#f59e0b" stroke-width="2" stroke-dasharray="4,2" />

                <!-- Recalibrated Cumulative Release Overlay & Observed Assay Markers -->
                @if (_calibrationResult != null)
                {
                    <path data-series="recalibrated" d="@GetCumulativeReleasePath(_calibrationResult.RecalibratedTrajectory)" fill="none" stroke="#10b981" stroke-width="2.5" />
                    @for (int idx = 0; idx < _recordedAssays.Count; idx++)
                    {
                        DepotAssayObservation obs = _recordedAssays[idx];
                        (double cx, double cy) = ProjectAssayMarker(obs);
                        <circle class="assay-marker" cx="@cx.ToString("F1", CultureInfo.InvariantCulture)" cy="@cy.ToString("F1", CultureInfo.InvariantCulture)" r="4.5" fill="#f43f5e" stroke="#ffffff" stroke-width="1.5">
                            <title>@FormatAssayTooltip(obs)</title>
                        </circle>
                    }
                }

                <!-- Phase Labels -->
                <text x="52" y="24" fill="#00d2ff" font-size="9" font-family="monospace">Phase I (0-7d)</text>
                <text x="280" y="24" fill="#10b981" font-size="9" font-family="monospace">Phase II: Steady-State Plateau (8-150d)</text>
                <text x="585" y="24" fill="#f59e0b" font-size="9" font-family="monospace">Phase III (151-180d)</text>

                <!-- Axis Labels -->
                <text x="15" y="44" fill="#8b949e" font-size="9" font-family="monospace">100%</text>
                <text x="20" y="124" fill="#8b949e" font-size="9" font-family="monospace">50%</text>
                <text x="25" y="204" fill="#8b949e" font-size="9" font-family="monospace">0%</text>

                <text x="50" y="216" fill="#8b949e" font-size="9" font-family="monospace">Day 0</text>
                <text x="75" y="228" fill="#00d2ff" font-size="9" font-family="monospace">Day 7</text>
                <text x="210" y="216" fill="#8b949e" font-size="9" font-family="monospace">Day 45</text>
                <text x="365" y="216" fill="#8b949e" font-size="9" font-family="monospace">Day 90</text>
                <text x="515" y="216" fill="#8b949e" font-size="9" font-family="monospace">Day 135</text>
                <text x="583" y="228" fill="#f59e0b" font-size="9" font-family="monospace">Day 150</text>
                <text x="670" y="216" fill="#8b949e" font-size="9" font-family="monospace">Day 180</text>
            </svg>
        </div>

        <!-- Milestone Trajectory Data Table -->
        <div class="table-container mt-4">
            <table class="data-table">
                <caption class="sr-only">180-Day Semi-Annual Depot Clinical Milestone Timepoints</caption>
                <thead>
                    <tr>
                        <th scope="col">Day</th>
                        <th scope="col">Phase</th>
                        <th scope="col">Cumulative Release</th>
                        <th scope="col">Daily Delivery (mg/day)</th>
                        <th scope="col">Reserve Mass (mg)</th>
                        <th scope="col">17β-Estradiol</th>
                        <th scope="col">Testosterone</th>
                        <th scope="col">LH (IU/L)</th>
                        <th scope="col">FSH (IU/L)</th>
                        <th scope="col">Clinical Target</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (TimeReleaseDailyPoint pt in GetMilestonePoints())
                    {
                        <tr>
                            <td class="font-mono">Day @pt.Day</td>
                            <td class="subtext">@pt.Phase</td>
                            <td class="font-mono text-accent">@((pt.CumulativeFraction * 100.0).ToString("F2"))%</td>
                            <td class="font-mono">@pt.DailyReleaseMg.ToString("F3")</td>
                            <td class="font-mono">@pt.RemainingReserveMg.ToString("F2")</td>
                            <td class="font-mono">@pt.EstradiolPmolL.ToString("F1") <small>pmol/L</small></td>
                            <td class="font-mono">@pt.TestosteroneNmolL.ToString("F2") <small>nmol/L</small></td>
                            <td class="font-mono @(pt.LhIuL < 1.0 ? "text-success" : "")">@pt.LhIuL.ToString("F2")</td>
                            <td class="font-mono @(pt.FshIuL < 1.5 ? "text-success" : "")">@pt.FshIuL.ToString("F2")</td>
                            <td>
                                <span class="badge @(pt.InTargetRange ? "badge-success" : "badge-outline")">
                                    @(pt.InTargetRange ? "IN RANGE" : "OUT OF RANGE")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Longitudinal Serum Assay & Adaptive Calibration Panel (Milestone 34) -->
    <section id="longitudinal-calibration-panel" class="card panel mt-4" role="region" aria-label="@T("Depot.AssaySectionTitle")">
        <div class="panel-header">
            <div>
                <h3>@T("Depot.AssaySectionTitle")</h3>
                <p class="subtext">@T("Depot.AssaySectionDesc")</p>
            </div>
            @if (_calibrationResult != null)
            {
                <span id="calibration-safety-badge" class="badge @GetSafetyBadgeClass(_calibrationResult.OverallSafetyStatus) font-mono">
                    @T($"Depot.SafetyStatus.{_calibrationResult.OverallSafetyStatus}")
                </span>
            }
        </div>

        <div class="telemetry-grid mt-3">
            <div class="form-group">
                <label class="form-label" for="input-assay-day">@T("Depot.DaySinceImplant")</label>
                <input id="input-assay-day" type="number" class="form-control font-mono" @bind="_assayDay" min="1" max="365" step="1" />
            </div>

            <div class="form-group">
                <label class="form-label" for="input-assay-e2">@T("Depot.ObservedE2")</label>
                <input id="input-assay-e2" type="number" class="form-control font-mono" @bind="_assayE2" min="0" step="1" />
            </div>

            <div class="form-group">
                <label class="form-label" for="input-assay-t">@T("Depot.ObservedT")</label>
                <input id="input-assay-t" type="number" class="form-control font-mono" @bind="_assayT" min="0" step="0.1" />
            </div>

            <div class="form-group">
                <label class="form-label" for="input-assay-lh">@T("Depot.ObservedLh")</label>
                <input id="input-assay-lh" type="number" class="form-control font-mono" @bind="_assayLh" min="0" step="0.1" />
            </div>

            <div class="form-group">
                <label class="form-label" for="input-assay-fsh">@T("Depot.ObservedFsh")</label>
                <input id="input-assay-fsh" type="number" class="form-control font-mono" @bind="_assayFsh" min="0" step="0.1" />
            </div>

            <div class="form-group">
                <label class="form-label" for="input-assay-shbg">@T("Depot.ObservedShbg")</label>
                <input id="input-assay-shbg" type="number" class="form-control font-mono" @bind="_assayShbg" min="0" step="1" />
            </div>

            <div class="form-group">
                <label class="form-label" for="input-assay-hct">@T("Depot.ObservedHematocrit")</label>
                <input id="input-assay-hct" type="number" class="form-control font-mono" @bind="_assayHematocrit" min="0" max="100" step="0.1" />
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_assayErrorMessage))
        {
            <div id="assay-validation-error" class="alert alert-danger mt-3" role="alert">@_assayErrorMessage</div>
        }

        <div class="d-flex align-items-center gap-2 mt-4">
            <button id="btn-record-assay-recalibrate" class="btn btn-primary" @onclick="RecordAssayAndRecalibrateAsync" disabled="@_isCalibrating">
                @T("Depot.RecordAssay")
            </button>
            <button id="btn-clear-assays" class="btn btn-outline" @onclick="ClearAssays" disabled="@(_recordedAssays.Count == 0)">
                @T("Depot.ClearAssays")
            </button>
        </div>

        @if (_calibrationResult != null)
        {
            <!-- Adaptive Re-Dosing Telemetry Card -->
            <div id="adaptive-calibration-card" class="telemetry-grid mt-4">
                <div class="card stat-card">
                    <div class="stat-label">@T("Depot.InferredClearance")</div>
                    <div class="stat-value font-mono text-accent">@_calibrationResult.InferredClearanceMultiplier.ToString("F2")x</div>
                    <div class="stat-sub">Bounded WLS Posterior [0.40–2.50]</div>
                </div>
                <div class="card stat-card">
                    <div class="stat-label">@T("Depot.InferredErosion")</div>
                    <div class="stat-value font-mono text-accent">@_calibrationResult.InferredDailyErosionRatePercent.ToString("F2")%/d</div>
                    <div class="stat-sub">Next Target: @_calibrationResult.RecommendedNextErosionRatePercent.ToString("F2")%/d</div>
                </div>
                <div class="card stat-card">
                    <div class="stat-label">@T("Depot.ResidualRmse")</div>
                    <div class="stat-value font-mono">@_calibrationResult.ResidualRmse.ToString("F4")</div>
                    <div class="stat-sub">Assays Assimilated: @_recordedAssays.Count</div>
                </div>
                <div class="card stat-card">
                    <div class="stat-label">@T("Depot.AdjustedRedoseDay")</div>
                    <div class="stat-value font-mono text-accent">Day @_calibrationResult.AdjustedRedoseDay</div>
                    <div class="stat-sub">Recalibrated Horizon Forecast</div>
                </div>
                <div class="card stat-card">
                    <div class="stat-label">@T("Depot.RecommendedNextMass")</div>
                    <div class="stat-value font-mono">@_calibrationResult.RecommendedNextMassMg.ToString("F2") <small class="text-muted">mg</small></div>
                    <div class="stat-sub">Next 180-Day Depot Fabrication</div>
                </div>
            </div>

            <!-- Clinical Safety Guardrail Alerts -->
            <div id="calibration-safety-alerts" class="mt-4">
                <h4>@T("Depot.SafetyAlertsTitle")</h4>
                @if (_calibrationResult.Alerts.Count == 0)
                {
                    <p class="subtext mt-2">@T("Depot.NoSafetyAlerts")</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-2 mt-2">
                        @foreach (DepotSafetyAlert alert in _calibrationResult.Alerts)
                        {
                            <div class="card stat-card" role="status">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @GetSafetyBadgeClass(alert.Severity) font-mono">@alert.Code</span>
                                    <span class="font-mono subtext">@alert.MeasuredValue.ToString("F2") vs @alert.ThresholdValue.ToString("F2")</span>
                                </div>
                                <p class="mt-2 text-main">@alert.Message</p>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (_recordedAssays.Count > 0)
        {
            <div class="table-container mt-4">
                <table id="recorded-assays-table" class="data-table">
                    <caption class="sr-only">Recorded Longitudinal Serum Hormone Assays</caption>
                    <thead>
                        <tr>
                            <th scope="col">Day</th>
                            <th scope="col">17β-Estradiol (pmol/L)</th>
                            <th scope="col">Testosterone (nmol/L)</th>
                            <th scope="col">LH (IU/L)</th>
                            <th scope="col">FSH (IU/L)</th>
                            <th scope="col">SHBG (nmol/L)</th>
                            <th scope="col">Hematocrit (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DepotAssayObservation obs in _recordedAssays)
                        {
                            <tr>
                                <td class="font-mono">Day @obs.DaySinceImplant</td>
                                <td class="font-mono">@obs.ObservedE2PmolL.ToString("F1")</td>
                                <td class="font-mono">@obs.ObservedTNmolL.ToString("F2")</td>
                                <td class="font-mono">@obs.ObservedLhIuL.ToString("F2")</td>
                                <td class="font-mono">@obs.ObservedFshIuL.ToString("F2")</td>
                                <td class="font-mono">@obs.ObservedShbgNmolL.ToString("F1")</td>
                                <td class="font-mono">@obs.ObservedHematocritPct.ToString("F1")%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- Multi-Year Permanent Endocrine Homeostasis & Mitotic Cell-Turnover Panel (Milestone 43) -->
    <section id="multiyear-homeostasis-panel" class="card panel mt-4" role="region" aria-label="@T("MultiYear.SectionTitle")">
        <div class="panel-header">
            <div>
                <h3>@T("MultiYear.SectionTitle")</h3>
                <p class="subtext">@T("MultiYear.SectionSubtitle")</p>
            </div>
            @if (_multiYearReport != null)
            {
                <span id="multiyear-durability-badge" class="badge @(_multiYearReport.DurabilityStatus == MultiYearDurabilityStatus.PermanentHomeostasisVerified ? "badge-success" : "badge-amber") font-mono">
                    @(_multiYearReport.DurabilityStatus == MultiYearDurabilityStatus.PermanentHomeostasisVerified ? T("MultiYear.BadgeVerified") : T("MultiYear.BadgeAdvisory"))
                </span>
            }
        </div>

        <div class="telemetry-grid mt-3">
            <div class="form-group">
                <label class="form-label" for="input-multiyear-horizon">@T("MultiYear.HorizonLabel")</label>
                <input id="input-multiyear-horizon" type="number" class="form-control font-mono" @bind="_multiYearHorizonYears" min="1" max="10" step="1" />
            </div>

            <div class="form-group">
                <label class="form-label" for="input-multiyear-fidelity">@T("MultiYear.FidelityLabel")</label>
                <input id="input-multiyear-fidelity" type="number" class="form-control font-mono" @bind="_multiYearFidelityRate" min="0.90" max="0.9999" step="0.0005" />
            </div>

            <div class="form-group">
                <label class="form-label" for="input-multiyear-progenitor">@T("MultiYear.ProgenitorLabel")</label>
                <input id="input-multiyear-progenitor" type="number" class="form-control font-mono" @bind="_multiYearProgenitorFraction" min="0.10" max="1.0" step="0.05" />
            </div>

            <div class="form-group">
                <label class="form-label" for="input-multiyear-circuit-id">@T("MultiYear.CircuitIdLabel")</label>
                <input id="input-multiyear-circuit-id" type="text" class="form-control font-mono" @bind="_multiYearCircuitId" placeholder="epicirc_..." />
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_multiYearErrorMessage))
        {
            <div id="multiyear-validation-error" class="alert alert-danger mt-3" role="alert">@_multiYearErrorMessage</div>
        }

        <div class="d-flex align-items-center gap-2 mt-4">
            <button id="btn-run-multiyear-simulation" class="btn btn-primary" @onclick="RunMultiYearHomeostasisSimulationAsync" disabled="@_isSimulatingMultiYear">
                @T("MultiYear.RunButton")
            </button>
        </div>

        @if (_multiYearReport != null)
        {
            <div id="multiyear-kpi-grid" class="telemetry-grid mt-4">
                <div class="card stat-card">
                    <div class="stat-label">@T("MultiYear.TenYearTtrLabel")</div>
                    <div class="stat-value font-mono @(_multiYearReport.ProjectedTenYearTtrPercent >= 95.0 ? "text-success" : "text-warning")">
                        @_multiYearReport.ProjectedTenYearTtrPercent.ToString("F1", CultureInfo.InvariantCulture)%
                    </div>
                    <div class="stat-sub">@_multiYearReport.HorizonYears-Year Benchmark (&ge; 95.0%)</div>
                </div>
                <div class="card stat-card">
                    <div class="stat-label">@T("MultiYear.HandoffTtrLabel")</div>
                    <div class="stat-value font-mono @(!_multiYearReport.HandoffTroughDropDetected ? "text-success" : "text-danger")">
                        @_multiYearReport.HandoffWindowTtrPercent.ToString("F1", CultureInfo.InvariantCulture)%
                    </div>
                    <div class="stat-sub">Day 90–180 Exogenous &rarr; Epigenetic Handoff</div>
                </div>
                <div class="card stat-card">
                    <div class="stat-label">@T("MultiYear.FinalMemoryLabel")</div>
                    <div class="stat-value font-mono text-accent">
                        @((_multiYearReport.FinalMethylatedProgenitorFraction * 100.0).ToString("F1", CultureInfo.InvariantCulture))%
                    </div>
                    <div class="stat-sub">Mitotic Fidelity: @_multiYearReport.MitoticFidelityRate.ToString("F4", CultureInfo.InvariantCulture)</div>
                </div>
                <div class="card stat-card">
                    <div class="stat-label">Clinical Durability Status</div>
                    <div class="stat-value-compact font-mono @(_multiYearReport.RequiresBoosterDose ? "text-warning" : "text-success")">
                        @(_multiYearReport.RequiresBoosterDose ? T("MultiYear.BoosterAdvised") : T("MultiYear.LifetimeConserved"))
                    </div>
                    <div class="stat-sub">@_multiYearReport.RecommendedIntervention</div>
                </div>
            </div>

            <div class="chart-container mt-4">
                <div class="d-flex justify-between align-center flex-wrap gap-2 mb-2">
                    <h4 class="text-main">@T("MultiYear.ChartTitle")</h4>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge badge-accent font-mono">CYAN: EXOGENOUS HYDROGEL</span>
                        <span class="badge badge-success font-mono">EMERALD: ENDOGENOUS EPIGENETIC</span>
                        <span class="badge badge-amber font-mono">AMBER: CHROMATIN MEMORY</span>
                    </div>
                </div>

                <svg id="multiyear-trajectory-svg" viewBox="0 0 720 220" class="multiyear-trajectory-svg" role="img" aria-label="@T("MultiYear.ChartTitle")">
                    <title>@T("MultiYear.ChartTitle")</title>
                    <desc>Dual-source area and line plot tracing the Day 0-180 hydrogel elution taper into long-term endogenous steroidogenesis and methylated progenitor retention.</desc>

                    <rect class="multiyear-handoff-band" x="56" y="25" width="46" height="155" />
                    <line class="multiyear-grid" x1="50" y1="30" x2="690" y2="30" />
                    <line class="multiyear-grid" x1="50" y1="68" x2="690" y2="68" />
                    <line class="multiyear-grid" x1="50" y1="105" x2="690" y2="105" />
                    <line class="multiyear-grid" x1="50" y1="143" x2="690" y2="143" />
                    <line class="multiyear-axis" x1="50" y1="180" x2="690" y2="180" />
                    <line class="multiyear-axis" x1="50" y1="180" x2="50" y2="25" />

                    <path class="multiyear-exo-area" d="@BuildMultiYearHydrogelAreaPath(_multiYearReport)" />
                    <path class="multiyear-endo-area" d="@BuildMultiYearEndogenousAreaPath(_multiYearReport)" />
                    <path class="multiyear-exo-line" d="@BuildMultiYearHydrogelLinePath(_multiYearReport)" />
                    <path class="multiyear-endo-line" d="@BuildMultiYearEndogenousLinePath(_multiYearReport)" />
                    <path class="multiyear-memory-line" d="@BuildMultiYearMemoryLinePath(_multiYearReport)" />

                    <text class="multiyear-svg-label" x="15" y="34">100%</text>
                    <text class="multiyear-svg-label" x="20" y="109">50%</text>
                    <text class="multiyear-svg-label" x="25" y="184">0%</text>
                    <text class="multiyear-svg-label" x="50" y="198">Yr 0</text>
                    <text class="multiyear-svg-label" x="72" y="210">Handoff</text>
                    <text class="multiyear-svg-label" x="355" y="198">Yr @(_multiYearReport.HorizonYears / 2)</text>
                    <text class="multiyear-svg-label" x="665" y="198">Yr @_multiYearReport.HorizonYears</text>
                </svg>
            </div>

            <div class="table-container mt-4">
                <table id="multiyear-checkpoints-table" class="data-table">
                    <caption class="sr-only">@T("MultiYear.TableCaption")</caption>
                    <thead>
                        <tr>
                            <th scope="col">Year</th>
                            <th scope="col">17β-Estradiol (pmol/L)</th>
                            <th scope="col">Testosterone (nmol/L)</th>
                            <th scope="col">LH / FSH (IU/L)</th>
                            <th scope="col">Chromatin Memory (%)</th>
                            <th scope="col">Hydrogel Drive (%)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (MultiYearHomeostasisCheckpointRecord cp in _multiYearReport.AnnualCheckpoints)
                        {
                            <tr>
                                <td class="font-mono">Year @cp.YearIndex</td>
                                <td class="font-mono">@cp.EstradiolPmolL.ToString("F1", CultureInfo.InvariantCulture)</td>
                                <td class="font-mono">@cp.TestosteroneNmolL.ToString("F2", CultureInfo.InvariantCulture)</td>
                                <td class="font-mono">@cp.LhIuL.ToString("F2", CultureInfo.InvariantCulture) / @cp.FshIuL.ToString("F2", CultureInfo.InvariantCulture)</td>
                                <td class="font-mono text-accent">@((cp.MethylatedProgenitorFraction * 100.0).ToString("F1", CultureInfo.InvariantCulture))%</td>
                                <td class="font-mono">@((cp.HydrogelContributionFraction * 100.0).ToString("F1", CultureInfo.InvariantCulture))%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- Wet-Lab Batch Fabrication & Cryptographic QC Lot Release Panel (Milestone 35) -->
    <section id="wet-lab-lot-release-panel" class="card panel mt-4" role="region" aria-label="@T("FabricationLot.SectionTitle")">
        <div class="panel-header">
            <div>
                <h3>@T("FabricationLot.SectionTitle")</h3>
                <p class="subtext">@T("FabricationLot.SectionDesc")</p>
            </div>
            @if (_activeLot != null)
            {
                <span id="lot-status-badge" class="badge @GetLotStatusBadgeClass(_activeLot.LotStatus) font-mono">
                    @T($"FabricationLot.Status.{_activeLot.LotStatus}")
                </span>
            }
        </div>

        <div class="d-flex align-items-center gap-3 mt-3">
            <label class="d-flex align-items-center gap-2" for="chk-lot-cpg-required">
                <input id="chk-lot-cpg-required" type="checkbox" @bind="_lotCpGRequired" />
                <span>@T("FabricationLot.CpGRequiredLabel")</span>
            </label>
            <button id="btn-mint-fabrication-lot" class="btn btn-primary" @onclick="MintFabricationLotAsync" disabled="@_isLotBusy">
                @T("FabricationLot.MintLotButton")
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_lotErrorMessage))
        {
            <div id="lot-validation-error" class="alert alert-danger mt-3" role="alert">@_lotErrorMessage</div>
        }

        @if (_activeLot != null)
        {
            <div id="active-lot-summary" class="telemetry-grid mt-4">
                <div class="card stat-card">
                    <div class="stat-label">Lot ID</div>
                    <div class="stat-value-compact font-mono text-accent" title="@_activeLot.LotId">@_activeLot.LotId</div>
                    <div class="stat-sub text-break-all">Depot: @_activeLot.DepotId</div>
                </div>
                <div class="card stat-card">
                    <div class="stat-label">Target Payload Mass</div>
                    <div class="stat-value font-mono">@_activeLot.TargetMassMg.ToString("F2") <small class="text-muted">mg</small></div>
                    <div class="stat-sub text-break-all">@(_activeLot.CalibrationSnapshotId != null ? $"Adaptive Calibration ({_activeLot.CalibrationSnapshotId})" : "Baseline Depot Target")</div>
                </div>
                <div class="card stat-card">
                    <div class="stat-label">Target Daily Erosion</div>
                    <div class="stat-value font-mono">@_activeLot.TargetErosionRatePercent.ToString("F3")%/d</div>
                    <div class="stat-sub">@_activeLot.PolymerMatrixType</div>
                </div>
                <div class="card stat-card">
                    <div class="stat-label">Opentrons Protocol SHA-256</div>
                    <div class="stat-value-compact font-mono" title="@_activeLot.OpentronsProtocolSha256">@_activeLot.OpentronsProtocolSha256</div>
                    <div class="stat-sub">Protocol API v2 Provenance</div>
                </div>
            </div>

            <div class="telemetry-grid mt-4">
                <div class="form-group">
                    <label class="form-label" for="select-qc-gate">@T("FabricationLot.GateLabel")</label>
                    <select id="select-qc-gate" class="form-control" value="@_selectedQcGate" @onchange="HandleQcGateChanged">
                        <option value="@FabricationQcGateType.GelFoldingYield">1. Agarose Gel Folding Yield (&gt;= 85.0%)</option>
                        <option value="@FabricationQcGateType.EndotoxinSterility">2. LAL Endotoxin Sterility (&lt;= 0.50 EU/mL)</option>
                        <option value="@FabricationQcGateType.HydrodynamicSizePdi">3. DLS Diameter (15–120 nm) &amp; PDI (&lt;= 0.20)</option>
                        <option value="@FabricationQcGateType.PayloadEncapsulation">4. HPLC Encapsulation (&gt;= 80%) &amp; Mass Dev (&lt;= 5%)</option>
                        <option value="@FabricationQcGateType.CpGMethylation">5. M.SssI CpG Methylation (&gt;= 95.0%)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="input-qc-measured">@T("FabricationLot.MeasuredValueLabel")</label>
                    <input id="input-qc-measured" type="number" class="form-control font-mono" @bind="_qcMeasuredValue" step="0.01" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="input-qc-secondary">@T("FabricationLot.SecondaryValueLabel")</label>
                    <input id="input-qc-secondary" type="number" class="form-control font-mono" @bind="_qcSecondaryValue" step="0.01" />
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 mt-3">
                <button id="btn-record-qc-gate" class="btn btn-outline" @onclick="RecordQcGateAsync" disabled="@_isLotBusy">
                    @T("FabricationLot.RecordQcButton")
                </button>
                <button id="btn-release-lot" class="btn btn-primary" @onclick="ReleaseFabricationLotAsync" disabled="@_isLotBusy">
                    @T("FabricationLot.ReleaseLotButton")
                </button>
            </div>

            @if (_lotQcChecks.Count > 0)
            {
                <div class="table-container mt-4">
                    <table id="lot-qc-checks-table" class="data-table">
                        <caption class="sr-only">Recorded Wet-Lab Pharmaceutical Quality Control Checks</caption>
                        <thead>
                            <tr>
                                <th scope="col">QC Gate</th>
                                <th scope="col">Measured</th>
                                <th scope="col">Secondary</th>
                                <th scope="col">Threshold</th>
                                <th scope="col">Verdict</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (FabricationQcCheckRecord chk in _lotQcChecks)
                            {
                                <tr>
                                    <td class="font-mono">@chk.GateType</td>
                                    <td class="font-mono">@chk.MeasuredValue.ToString("F2")</td>
                                    <td class="font-mono">@(chk.SecondaryValue.HasValue ? chk.SecondaryValue.Value.ToString("F3") : "—")</td>
                                    <td class="font-mono">@chk.ThresholdValue.ToString("F2")</td>
                                    <td>
                                        <span class="badge @(chk.Passed ? "badge-success" : "badge-danger") font-mono">
                                            @(chk.Passed ? "PASS" : "FAIL")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (_lotReleaseEvaluation != null)
            {
                @if (_lotReleaseEvaluation.Certificate != null)
                {
                    <div id="lot-certificate-card" class="card stat-card mt-4" role="status">
                        <div class="d-flex align-items-center gap-2">
                            <h4>@T("FabricationLot.CertificateTitle")</h4>
                            <span id="lot-certificate-verified-badge" class="badge @(_lotCertificateVerified ? "badge-success" : "badge-danger") font-mono">
                                @(_lotCertificateVerified ? T("FabricationLot.CertificateVerified") : "SIGNATURE INVALID")
                            </span>
                        </div>
                        <div class="telemetry-grid mt-3">
                            <div>
                                <div class="stat-label">Algorithm</div>
                                <div class="font-mono text-accent">@_lotReleaseEvaluation.Certificate.SignatureAlgorithm</div>
                            </div>
                            <div>
                                <div class="stat-label">Signer Key ID</div>
                                <div class="font-mono text-break-all">@_lotReleaseEvaluation.Certificate.SignerKeyId</div>
                            </div>
                            <div>
                                <div class="stat-label">Canonical Payload SHA-256</div>
                                <div class="font-mono text-break-all" title="@_lotReleaseEvaluation.Certificate.PayloadSha256">@_lotReleaseEvaluation.Certificate.PayloadSha256</div>
                            </div>
                            <div>
                                <div class="stat-label">Issued UTC</div>
                                <div class="font-mono">@_lotReleaseEvaluation.Certificate.IssuedAtUtc.ToString("u", CultureInfo.InvariantCulture)</div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 mt-3">
                            <a id="link-download-coa" class="btn btn-outline" href="@($"/api/fabrication/lots/{_activeLot.LotId}/certificate/download")" target="_blank" rel="noopener">
                                Download Signed CoA JSON
                            </a>
                            <button id="btn-load-active-coa" class="btn btn-outline" @onclick="LoadActiveCertificateIntoVerifier">
                                Copy Into Verifier
                            </button>
                        </div>

                        @if (_activeLot.LotStatus == FabricationLotStatus.Released)
                        {
                            <div class="telemetry-grid mt-3">
                                <div class="form-group">
                                    <label class="form-label" for="input-revoke-reason">@T("FabricationLot.RevokeReasonLabel")</label>
                                    <input id="input-revoke-reason" type="text" class="form-control" @bind="_revokeReason" placeholder="e.g. Cold-chain excursion during transit" />
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-2">
                                <button id="btn-revoke-lot" class="btn btn-danger" @onclick="RevokeActiveLotAsync" disabled="@_isLotBusy">
                                    @T("FabricationLot.RevokeLotButton")
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div id="lot-quarantine-banner" class="alert alert-danger mt-4" role="alert">
                        <strong>@T("FabricationLot.QuarantineTitle")</strong>
                        <ul class="mt-2">
                            @foreach (string reason in _lotReleaseEvaluation.FailureReasons)
                            {
                                <li>@reason</li>
                            }
                        </ul>
                    </div>
                }
            }

            @if (_activeLotRevocation != null)
            {
                <div id="lot-revoked-banner" class="alert alert-danger mt-4" role="alert">
                    <strong>@T("FabricationLot.RevokedBannerTitle")</strong>
                    <p class="mt-2">@_activeLotRevocation.RevocationReason</p>
                    <p class="subtext font-mono">Revoked by @_activeLotRevocation.RevokedBy at @_activeLotRevocation.RevokedAtUtc.ToString("u", CultureInfo.InvariantCulture)</p>
                </div>
            }

            <!-- Cold-Chain Thermal Stability, Arrhenius Shelf-Life & SHA-256 Chain-of-Custody Panel (Milestone 40) -->
            <div id="cold-chain-custody-panel" class="card stat-card mt-4" role="region" aria-label="@T("ColdChain.SectionTitle")">
                <div class="panel-header">
                    <div>
                        <h4>@T("ColdChain.SectionTitle")</h4>
                        <p class="subtext">@T("ColdChain.SectionSubtitle")</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span id="cc-implantation-badge" class="badge @((_activeLotStability?.IsSafeForImplantation ?? true) ? "badge-success" : "badge-danger") font-mono">
                            @((_activeLotStability?.IsSafeForImplantation ?? true) ? T("ColdChain.ImplantationStatusSafe") : T("ColdChain.ImplantationStatusBlocked"))
                        </span>
                        <span id="cc-custody-chain-badge" class="badge @((_activeLotCustodyLedger?.CustodyChainValid ?? true) ? "badge-success" : "badge-danger") font-mono">
                            @((_activeLotCustodyLedger?.CustodyChainValid ?? true) ? T("ColdChain.CustodyChainVerified") : T("ColdChain.CustodyChainTampered"))
                        </span>
                        <span id="cc-stability-status-badge" class="badge @GetColdChainBadgeClass(_activeLotStability?.Status ?? ThermalStabilityStatus.Optimal) font-mono">
                            @(_activeLotStability?.Status ?? ThermalStabilityStatus.Optimal)
                        </span>
                    </div>
                </div>

                <div class="telemetry-grid mt-3">
                    <div>
                        <div class="stat-label">@T("ColdChain.RemainingPotencyLabel")</div>
                        <div id="cc-remaining-potency" class="stat-value font-mono">@((_activeLotStability?.RemainingPotencyPercent ?? 100.0).ToString("F2", CultureInfo.InvariantCulture))%</div>
                    </div>
                    <div>
                        <div class="stat-label">@T("ColdChain.ThermalBudgetUsedLabel")</div>
                        <div id="cc-budget-consumed" class="stat-value font-mono">@((_activeLotStability?.CumulativeThermalBudgetUsedPercent ?? 0.0).ToString("F2", CultureInfo.InvariantCulture))%</div>
                    </div>
                    <div>
                        <div class="stat-label">@T("ColdChain.ShelfLifeRemainingLabel")</div>
                        <div id="cc-shelf-life" class="stat-value-compact font-mono">
                            @((_activeLotStability?.EstimatedRemainingShelfLifeDaysAtMinus20C ?? 365.0).ToString("F1", CultureInfo.InvariantCulture)) d (-20°C) / @((_activeLotStability?.EstimatedRemainingShelfLifeDaysAt4C ?? 23.7).ToString("F1", CultureInfo.InvariantCulture)) d (+4°C)
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_coldChainErrorMessage))
                {
                    <div id="cc-error" class="alert alert-danger mt-3" role="alert">@_coldChainErrorMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(_coldChainStatusMessage))
                {
                    <div id="cc-status" class="alert alert-success mt-3" role="status">@_coldChainStatusMessage</div>
                }

                <div class="mt-4 pt-3 border-top">
                    <h5>@T("ColdChain.LogExcursionTitle")</h5>
                    <div class="telemetry-grid mt-2">
                        <div class="form-group">
                            <label class="form-label" for="select-cc-tier">Storage Tier</label>
                            <select id="select-cc-tier" class="form-control" @bind="_ccStorageTier">
                                <option value="@ThermalStorageTier.UltraColdMinus80">Ultra-Cold (-80°C)</option>
                                <option value="@ThermalStorageTier.FrozenMinus20">Frozen Standard (-20°C)</option>
                                <option value="@ThermalStorageTier.Refrigerated2To8">Refrigerated (2–8°C)</option>
                                <option value="@ThermalStorageTier.AmbientControlled">Ambient Controlled (&gt; 8–25°C)</option>
                                <option value="@ThermalStorageTier.ThermalExcursion">Thermal Excursion (&gt; 25°C / Unplanned)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-cc-temp">Temperature (°C)</label>
                            <input id="input-cc-temp" type="number" class="form-control font-mono" @bind="_ccTemperatureCelsius" step="0.5" min="-196.0" max="121.0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-cc-duration">Exposure Duration (Hours)</label>
                            <input id="input-cc-duration" type="number" class="form-control font-mono" @bind="_ccDurationHours" step="0.5" min="0.1" max="87600.0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-cc-sensor">Calibrated Sensor ID</label>
                            <input id="input-cc-sensor" type="text" class="form-control font-mono" @bind="_ccSensorId" placeholder="NIST-PROBE-01" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-cc-notes">Operator Notes (AES-256-GCM)</label>
                            <input id="input-cc-notes" type="text" class="form-control" @bind="_ccNotes" placeholder="Optional cold-box transfer observation" />
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <button id="btn-cc-log-excursion" class="btn btn-outline" @onclick="RecordColdChainExcursionAsync" disabled="@_isLotBusy">
                            @T("ColdChain.LogExcursionSubmit")
                        </button>
                    </div>

                    @if (_activeLotExcursions.Count > 0)
                    {
                        <div class="table-container mt-3">
                            <table id="cc-excursions-table" class="data-table">
                                <caption class="sr-only">Recorded Cold-Chain Thermal Intervals</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Tier</th>
                                        <th scope="col">Temp (°C)</th>
                                        <th scope="col">Duration (h)</th>
                                        <th scope="col">Sensor ID</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (ThermalExcursionResponse ex in _activeLotExcursions)
                                    {
                                        <tr>
                                            <td class="font-mono">@ex.StorageTier</td>
                                            <td class="font-mono">@ex.TemperatureCelsius.ToString("F2", CultureInfo.InvariantCulture)</td>
                                            <td class="font-mono">@ex.DurationHours.ToString("F2", CultureInfo.InvariantCulture)</td>
                                            <td class="font-mono">@ex.SensorId</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p id="cc-excursions-empty" class="subtext mt-2">@T("ColdChain.ExcursionHistoryEmpty")</p>
                    }
                </div>

                <div class="mt-4 pt-3 border-top">
                    <h5>@T("ColdChain.RecordHandoffTitle")</h5>
                    <div class="telemetry-grid mt-2">
                        <div class="form-group">
                            <label class="form-label" for="select-cc-stage">Custody Stage</label>
                            <select id="select-cc-stage" class="form-control" @bind="_ccCustodyStage">
                                <option value="@CustodyStage.WetLabRelease">Wet-Lab Release</option>
                                <option value="@CustodyStage.ColdChainDispatch">Cold-Chain Dispatch</option>
                                <option value="@CustodyStage.ClinicReceipt">Clinic Receipt</option>
                                <option value="@CustodyStage.PreImplantInspection">Pre-Implant Inspection</option>
                                <option value="@CustodyStage.PatientAdministration">Patient Administration (Gated)</option>
                                <option value="@CustodyStage.QuarantineDisposal">Quarantine Disposal (Terminal)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-cc-from">From Custodian</label>
                            <input id="input-cc-from" type="text" class="form-control" @bind="_ccFromCustodian" placeholder="wetlab_operator" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-cc-to">To Custodian / Clinic</label>
                            <input id="input-cc-to" type="text" class="form-control" @bind="_ccToCustodian" placeholder="cold_courier_01" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-cc-facility">Facility Code</label>
                            <input id="input-cc-facility" type="text" class="form-control font-mono" @bind="_ccLocationFacility" placeholder="ZRH-LAB-01" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-cc-handoff-temp">Handoff Temp (°C)</label>
                            <input id="input-cc-handoff-temp" type="number" class="form-control font-mono" @bind="_ccHandoffTempCelsius" step="0.5" min="-196.0" max="121.0" />
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <button id="btn-cc-record-handoff" class="btn btn-primary" @onclick="RecordColdChainHandoffAsync" disabled="@_isLotBusy">
                            @T("ColdChain.RecordHandoffSubmit")
                        </button>
                    </div>

                    @if (_activeLotCustodyLedger != null && _activeLotCustodyLedger.Handoffs.Count > 0)
                    {
                        <div class="table-container mt-3">
                            <table id="cc-custody-table" class="data-table">
                                <caption class="sr-only">Verified SHA-256 Chain-of-Custody Timeline</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Stage</th>
                                        <th scope="col">From &rarr; To</th>
                                        <th scope="col">Facility</th>
                                        <th scope="col">Temp (°C)</th>
                                        <th scope="col">Potency</th>
                                        <th scope="col">SHA-256 Digest</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (CustodyHandoffRecord h in _activeLotCustodyLedger.Handoffs)
                                    {
                                        string shortHash = h.EntrySha256.Length > 12 ? h.EntrySha256[..12] : h.EntrySha256;
                                        <tr>
                                            <td class="font-mono">@h.Stage</td>
                                            <td>@h.FromActor &rarr; @h.ToActor</td>
                                            <td class="font-mono">@h.FacilityCode</td>
                                            <td class="font-mono">@h.TemperatureCelsius.ToString("F2", CultureInfo.InvariantCulture)</td>
                                            <td class="font-mono">@h.PotencyPercentAtHandoff.ToString("F2", CultureInfo.InvariantCulture)%</td>
                                            <td class="font-mono" title="@h.EntrySha256">@shortHash&hellip;</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p id="cc-custody-empty" class="subtext mt-2">@T("ColdChain.CustodyTimelineEmpty")</p>
                    }
                </div>
            </div>

            <!-- Post-Implantation Pharmacovigilance, CARPA & TLR9 Surveillance Panel (Milestone 41) -->
            <div id="pharmacovigilance-surveillance-panel" class="card stat-card mt-4" role="region" aria-label="@T("Pharmacovigilance.SectionTitle")">
                <div class="panel-header">
                    <div>
                        <h4>@T("Pharmacovigilance.SectionTitle")</h4>
                        <p class="subtext">@T("Pharmacovigilance.SectionSubtitle")</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span id="pv-posture-badge" class="badge @GetPharmacovigilanceBadgeClass(_activeLotPharmacovigilance?.Posture ?? PharmacovigilancePosture.Nominal) font-mono">
                            @GetPharmacovigilancePostureLabel(_activeLotPharmacovigilance?.Posture ?? PharmacovigilancePosture.Nominal)
                        </span>
                    </div>
                </div>

                @if (_activeLotPharmacovigilance?.IsQuarantineTriggered == true)
                {
                    <div id="pv-quarantine-banner" class="alert alert-danger mt-3" role="alert">
                        <strong>@T("Pharmacovigilance.QuarantineBannerTitle")</strong>
                        <p class="mt-1">@T("Pharmacovigilance.QuarantineBannerDesc")</p>
                        @if (_activeLotPharmacovigilance.EmergencyRecallRecommended)
                        {
                            <p class="font-mono mt-1">@T("Pharmacovigilance.EmergencyRecallRecommended")</p>
                        }
                        <p class="subtext mt-1">@_activeLotPharmacovigilance.Summary</p>
                    </div>
                }

                <div class="telemetry-grid mt-3">
                    <div>
                        <div class="stat-label">@T("Pharmacovigilance.AdverseEventsCountLabel")</div>
                        <div id="pv-adverse-count" class="stat-value font-mono">@(_activeLotPharmacovigilance?.AdverseEventCount ?? 0)</div>
                    </div>
                    <div>
                        <div class="stat-label">@T("Pharmacovigilance.ImmunogenicityAssaysCountLabel")</div>
                        <div id="pv-assay-count" class="stat-value font-mono">@(_activeLotPharmacovigilance?.ImmunogenicityAssayCount ?? 0)</div>
                    </div>
                    <div>
                        <div class="stat-label">@T("Pharmacovigilance.HighestGradeLabel")</div>
                        <div id="pv-highest-grade" class="stat-value-compact font-mono">
                            @(_activeLotPharmacovigilance?.HighestSeverityGrade?.ToString() ?? "None")
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_pvErrorMessage))
                {
                    <div id="pv-error" class="alert alert-danger mt-3" role="alert">@_pvErrorMessage</div>
                }

                @if (!string.IsNullOrWhiteSpace(_pvStatusMessage))
                {
                    <div id="pv-status" class="alert alert-success mt-3" role="status">@_pvStatusMessage</div>
                }

                <div class="mt-4 pt-3 border-top">
                    <h5>@T("Pharmacovigilance.LogAdverseEventTitle")</h5>
                    <div class="telemetry-grid mt-2">
                        <div class="form-group">
                            <label class="form-label" for="select-pv-grade">CTCAE v5.0 Grade</label>
                            <select id="select-pv-grade" class="form-control" @bind="_pvSeverityGrade">
                                <option value="@AdverseEventSeverityGrade.Grade1Mild">Grade 1 — Mild</option>
                                <option value="@AdverseEventSeverityGrade.Grade2Moderate">Grade 2 — Moderate</option>
                                <option value="@AdverseEventSeverityGrade.Grade3Severe">Grade 3 — Severe (Auto-Quarantine)</option>
                                <option value="@AdverseEventSeverityGrade.Grade4LifeThreatening">Grade 4 — Life-Threatening (Auto-Quarantine)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-pv-symptom">Symptom Category</label>
                            <input id="input-pv-symptom" type="text" class="form-control" @bind="_pvSymptomCategory" placeholder="InjectionSiteErythema" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-pv-onset">Onset Post-Implant (Hours)</label>
                            <input id="input-pv-onset" type="number" class="form-control font-mono" @bind="_pvOnsetHours" step="0.5" min="0.0" max="87600.0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-pv-notes">Clinical Notes (AES-256-GCM)</label>
                            <input id="input-pv-notes" type="text" class="form-control" @bind="_pvClinicalNotes" placeholder="Optional clinician assessment" />
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <button id="btn-pv-record-event" class="btn btn-outline" @onclick="RecordPharmacovigilanceEventAsync" disabled="@_isLotBusy">
                            @T("Pharmacovigilance.LogAdverseEventSubmit")
                        </button>
                    </div>

                    @if (_activeLotPharmacovigilance != null && _activeLotPharmacovigilance.AdverseEvents.Count > 0)
                    {
                        <div class="table-container mt-3">
                            <table id="pv-events-table" class="data-table">
                                <caption class="sr-only">Recorded CTCAE v5.0 Adverse Events</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Grade</th>
                                        <th scope="col">Symptom</th>
                                        <th scope="col">Onset (h)</th>
                                        <th scope="col">Reporter</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (LotAdverseEventSummary ev in _activeLotPharmacovigilance.AdverseEvents)
                                    {
                                        <tr>
                                            <td class="font-mono">@ev.SeverityGrade</td>
                                            <td>@ev.SymptomCategory</td>
                                            <td class="font-mono">@ev.OnsetHoursPostImplant.ToString("F2", CultureInfo.InvariantCulture)</td>
                                            <td class="font-mono">@ev.ReportedBy</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p id="pv-events-empty" class="subtext mt-2">@T("Pharmacovigilance.AdverseEventsEmpty")</p>
                    }
                </div>

                <div class="mt-4 pt-3 border-top">
                    <h5>@T("Pharmacovigilance.LogImmunogenicityTitle")</h5>
                    <div class="telemetry-grid mt-2">
                        <div class="form-group">
                            <label class="form-label" for="input-pv-ch50">CH50 (%)</label>
                            <input id="input-pv-ch50" type="number" class="form-control font-mono" @bind="_pvCh50Percent" step="1.0" min="0.0" max="200.0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-pv-c3a">C3a (ng/mL)</label>
                            <input id="input-pv-c3a" type="number" class="form-control font-mono" @bind="_pvC3aNgMl" step="5.0" min="0.0" max="50000.0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-pv-c5a">C5a (ng/mL)</label>
                            <input id="input-pv-c5a" type="number" class="form-control font-mono" @bind="_pvC5aNgMl" step="1.0" min="0.0" max="10000.0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-pv-il6">IL-6 (pg/mL)</label>
                            <input id="input-pv-il6" type="number" class="form-control font-mono" @bind="_pvIl6PgMl" step="1.0" min="0.0" max="100000.0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-pv-tnfa">TNF-&alpha; (pg/mL)</label>
                            <input id="input-pv-tnfa" type="number" class="form-control font-mono" @bind="_pvTnfaPgMl" step="1.0" min="0.0" max="50000.0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-pv-antipeg">Anti-PEG IgM Titer</label>
                            <input id="input-pv-antipeg" type="number" class="form-control font-mono" @bind="_pvAntiPegIgmTiter" step="5.0" min="0.0" max="100000.0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-pv-antidsdna">Anti-dsDNA IgG (IU/mL)</label>
                            <input id="input-pv-antidsdna" type="number" class="form-control font-mono" @bind="_pvAntiDsDnaIgGIuMl" step="1.0" min="0.0" max="10000.0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="input-pv-tlr9">TLR9 Activation Index</label>
                            <input id="input-pv-tlr9" type="number" class="form-control font-mono" @bind="_pvTlr9Index" step="0.1" min="0.0" max="100.0" />
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <button id="btn-pv-record-assay" class="btn btn-primary" @onclick="RecordPharmacovigilanceAssayAsync" disabled="@_isLotBusy">
                            @T("Pharmacovigilance.LogImmunogenicitySubmit")
                        </button>
                    </div>

                    @if (_activeLotPharmacovigilance != null && _activeLotPharmacovigilance.ImmunogenicityAssays.Count > 0)
                    {
                        <div class="table-container mt-3">
                            <table id="pv-assays-table" class="data-table">
                                <caption class="sr-only">Recorded CARPA &amp; TLR9 Immunogenicity Assays</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">CH50 (%)</th>
                                        <th scope="col">C3a / C5a (ng/mL)</th>
                                        <th scope="col">IL-6 / TNF-&alpha; (pg/mL)</th>
                                        <th scope="col">Anti-PEG / dsDNA</th>
                                        <th scope="col">TLR9 Index</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (LotImmunogenicityAssayRecord ass in _activeLotPharmacovigilance.ImmunogenicityAssays)
                                    {
                                        <tr>
                                            <td class="font-mono">@ass.Ch50Percent.ToString("F1", CultureInfo.InvariantCulture)%</td>
                                            <td class="font-mono">@ass.C3aNgMl.ToString("F1", CultureInfo.InvariantCulture) / @ass.C5aNgMl.ToString("F1", CultureInfo.InvariantCulture)</td>
                                            <td class="font-mono">@ass.Il6PgMl.ToString("F1", CultureInfo.InvariantCulture) / @ass.TnfaPgMl.ToString("F1", CultureInfo.InvariantCulture)</td>
                                            <td class="font-mono">@ass.AntiPegIgmTiter.ToString("F0", CultureInfo.InvariantCulture) / @ass.AntiDsDnaIgGIuMl.ToString("F1", CultureInfo.InvariantCulture)</td>
                                            <td class="font-mono">@ass.Tlr9ActivationIndex.ToString("F2", CultureInfo.InvariantCulture)x</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p id="pv-assays-empty" class="subtext mt-2">@T("Pharmacovigilance.ImmunogenicityAssaysEmpty")</p>
                    }
                </div>
            </div>
        }
    </section>

    <!-- Cross-Node ML-DSA-65 Certificate Verifier Panel (Milestone 36) -->
    <section id="peer-certificate-verifier-panel" class="card panel mt-4" role="region" aria-label="@T("FabricationLot.VerifierSectionTitle")">
        <div class="panel-header">
            <div>
                <h3>@T("FabricationLot.VerifierSectionTitle")</h3>
                <p class="subtext">@T("FabricationLot.VerifierSectionDesc")</p>
            </div>
        </div>

        <div class="form-group mt-3">
            <label class="form-label" for="textarea-verify-coa-json">@T("FabricationLot.VerifierInputLabel")</label>
            <textarea id="textarea-verify-coa-json" class="form-control font-mono" rows="5" @bind="_verifyCertificateJson" placeholder="{ &quot;lotId&quot;: &quot;...&quot;, &quot;signatureBase64&quot;: &quot;...&quot; }"></textarea>
        </div>

        @if (!string.IsNullOrWhiteSpace(_verifyErrorMessage))
        {
            <div id="peer-verify-error" class="alert alert-danger mt-3" role="alert">@_verifyErrorMessage</div>
        }

        <div class="d-flex align-items-center gap-2 mt-3">
            <button id="btn-verify-peer-certificate" class="btn btn-primary" @onclick="VerifyPastedCertificateAsync" disabled="@_isVerifyingCertificate">
                @T("FabricationLot.VerifierButton")
            </button>
        </div>

        @if (_peerVerificationReport != null)
        {
            <div id="peer-verify-result-card" class="card stat-card mt-4" role="status">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span id="peer-verify-trust-badge" class="badge @(_peerVerificationReport.IsTrusted ? "badge-success" : "badge-danger") font-mono">
                        @(_peerVerificationReport.IsTrusted ? T("FabricationLot.VerifierTrustedBadge") : _peerVerificationReport.IsRevoked ? "REVOKED" : _peerVerificationReport.TrustSource.ToString().ToUpperInvariant())
                    </span>
                    <span class="badge badge-outline font-mono">@_peerVerificationReport.TrustSource</span>
                    @if (_peerVerificationReport.ColdChainStatus.HasValue)
                    {
                        <span id="peer-verify-coldchain-badge" class="badge @((_peerVerificationReport.IsSafeForImplantation ?? false) ? "badge-success" : "badge-danger") font-mono">
                            @_peerVerificationReport.ColdChainStatus (@((_peerVerificationReport.RemainingPotencyPercent ?? 0.0).ToString("F2", CultureInfo.InvariantCulture))%)
                        </span>
                    }
                    @if (_peerVerificationReport.PharmacovigilancePosture.HasValue)
                    {
                        <span id="peer-verify-pv-badge" class="badge @GetPharmacovigilanceBadgeClass(_peerVerificationReport.PharmacovigilancePosture.Value) font-mono">
                            @GetPharmacovigilancePostureLabel(_peerVerificationReport.PharmacovigilancePosture.Value)
                        </span>
                    }
                </div>
                <p class="mt-2 text-main">@_peerVerificationReport.Summary</p>
                <div class="subtext font-mono text-break-all mt-1">
                    Lot: @_peerVerificationReport.LotId &bull; Signer: @_peerVerificationReport.SignerKeyId
                </div>
            </div>
        }
    </section>

    <!-- Federated Peer Recall & Revocation Feed Sync Panel (Milestone 38) -->
    <section id="federated-revocation-sync-panel" class="card panel mt-4" role="region" aria-label="@T("FabricationLot.RevocationFeedTitle")">
        <div class="panel-header">
            <div>
                <h3>@T("FabricationLot.RevocationFeedTitle")</h3>
                <p class="subtext">@T("FabricationLot.RevocationFeedDesc")</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button id="btn-export-revocation-feed" class="btn btn-outline" @onclick="ExportSignedRevocationFeedAsync" disabled="@_isSyncingRevocationFeed">
                    @T("FabricationLot.RevocationFeedExportButton")
                </button>
                <button id="btn-refresh-federated-recalls" class="btn btn-outline" @onclick="RefreshFederatedRecallsAsync" disabled="@_isSyncingRevocationFeed">
                    @T("FabricationLot.RevocationFeedRefreshButton")
                </button>
            </div>
        </div>

        <div class="form-group mt-3">
            <label class="form-label" for="textarea-revocation-feed-json">@T("FabricationLot.RevocationFeedInputLabel")</label>
            <textarea id="textarea-revocation-feed-json" class="form-control font-mono" rows="5" @bind="_revocationFeedJson" placeholder="{ &quot;feedVersion&quot;: &quot;nanoweaver-revocation-feed-v1&quot;, &quot;entries&quot;: [ ... ] }"></textarea>
        </div>

        @if (!string.IsNullOrWhiteSpace(_revocationFeedErrorMessage))
        {
            <div id="revocation-feed-error" class="alert alert-danger mt-3" role="alert">@_revocationFeedErrorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(_revocationFeedStatusMessage))
        {
            <div id="revocation-feed-status" class="alert alert-success mt-3" role="status">@_revocationFeedStatusMessage</div>
        }

        <div class="d-flex align-items-center gap-2 mt-3">
            <button id="btn-import-revocation-feed" class="btn btn-primary" @onclick="ImportSignedRevocationFeedAsync" disabled="@_isSyncingRevocationFeed">
                @T("FabricationLot.RevocationFeedImportButton")
            </button>
        </div>

        @if (_federatedRecalls.Count > 0)
        {
            <div class="table-responsive mt-4">
                <table id="federated-recalls-table" class="table">
                    <thead>
                        <tr>
                            <th>@T("FabricationLot.RevocationFeedColLot")</th>
                            <th>@T("FabricationLot.RevocationFeedColIssuer")</th>
                            <th>@T("FabricationLot.RevocationFeedColReason")</th>
                            <th>@T("FabricationLot.RevocationFeedColImported")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (FederatedLotRevocationRecord rec in _federatedRecalls)
                        {
                            <tr>
                                <td class="font-mono text-break-all">@rec.LotId</td>
                                <td class="font-mono text-break-all">@(string.IsNullOrWhiteSpace(rec.IssuerPeerLabel) ? rec.IssuerKeyId : rec.IssuerPeerLabel)</td>
                                <td>@rec.RevocationReason</td>
                                <td class="font-mono">@rec.ImportedAtUtc.ToString("u", CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="subtext mt-3">@T("FabricationLot.RevocationFeedEmpty")</p>
        }

        <!-- Automated Peer Endpoint Subscriptions (Milestone 39) -->
        <div id="automated-peer-sync-section" class="mt-4 pt-3 border-top">
            <div class="panel-header">
                <div>
                    <h4>@T("FabricationLot.PeerSyncTitle")</h4>
                    <p class="subtext">@T("FabricationLot.PeerSyncDesc")</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button id="btn-sync-all-peers" class="btn btn-primary" @onclick="RunAllPeerSyncAsync" disabled="@_isSyncingRevocationFeed">
                        @T("FabricationLot.PeerSyncRunAllButton")
                    </button>
                </div>
            </div>

            <div class="grid-2 mt-3">
                <div class="form-group">
                    <label class="form-label" for="input-peer-sync-id">@T("FabricationLot.PeerSyncPeerIdLabel")</label>
                    <input id="input-peer-sync-id" class="form-control font-mono" type="text" @bind="_peerSyncPeerId" placeholder="clinic-zurich-01" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="input-peer-sync-name">@T("FabricationLot.PeerSyncDisplayNameLabel")</label>
                    <input id="input-peer-sync-name" class="form-control" type="text" @bind="_peerSyncDisplayName" placeholder="Zurich Sovereign Lab" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="input-peer-sync-url">@T("FabricationLot.PeerSyncBaseUrlLabel")</label>
                    <input id="input-peer-sync-url" class="form-control font-mono" type="url" @bind="_peerSyncBaseUrl" placeholder="https://lab-zurich.lantea.one" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="input-peer-sync-key">@T("FabricationLot.PeerSyncPinnedKeyLabel")</label>
                    <input id="input-peer-sync-key" class="form-control font-mono" type="text" @bind="_peerSyncPinnedKeyId" placeholder="64-hex ML-DSA-65 Key ID" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="input-peer-sync-interval">@T("FabricationLot.PeerSyncIntervalLabel")</label>
                    <input id="input-peer-sync-interval" class="form-control" type="number" min="1" max="10080" @bind="_peerSyncIntervalMinutes" />
                </div>
                <div class="form-group d-flex flex-column justify-content-center gap-2">
                    <label class="form-check-label" for="chk-peer-sync-enabled">
                        <input id="chk-peer-sync-enabled" class="form-check-input" type="checkbox" @bind="_peerSyncEnabled" />
                        @T("FabricationLot.PeerSyncEnabledLabel")
                    </label>
                    <label class="form-check-label" for="chk-peer-sync-loopback">
                        <input id="chk-peer-sync-loopback" class="form-check-input" type="checkbox" @bind="_peerSyncAllowLoopback" />
                        @T("FabricationLot.PeerSyncLoopbackLabel")
                    </label>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 mt-3">
                <button id="btn-save-peer-sync" class="btn btn-outline" @onclick="SavePeerSyncSubscriptionAsync" disabled="@_isSyncingRevocationFeed">
                    @T("FabricationLot.PeerSyncSaveButton")
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_peerSyncErrorMessage))
            {
                <div id="peer-sync-error" class="alert alert-danger mt-3" role="alert">@_peerSyncErrorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(_peerSyncStatusMessage))
            {
                <div id="peer-sync-status" class="alert alert-success mt-3" role="status">@_peerSyncStatusMessage</div>
            }

            @if (_peerSyncEndpoints.Count > 0)
            {
                <div class="table-responsive mt-3">
                    <table id="peer-sync-endpoints-table" class="table">
                        <thead>
                            <tr>
                                <th>@T("FabricationLot.PeerSyncColEndpoint")</th>
                                <th>@T("FabricationLot.PeerSyncColStatus")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (FederatedPeerSyncEndpointRecord ep in _peerSyncEndpoints)
                            {
                                string badgeClass = ep.LastStatus == FederatedPeerSyncStatus.Succeeded
                                    ? "badge badge-success"
                                    : ep.LastStatus == FederatedPeerSyncStatus.Failed
                                        ? "badge badge-danger"
                                        : "badge badge-outline";
                                <tr data-peer-id="@ep.PeerId">
                                    <td>
                                        <div class="font-bold">@ep.DisplayName <span class="font-mono subtext">(@ep.PeerId)</span></div>
                                        <div class="font-mono text-break-all subtext">@ep.BaseUrl</div>
                                        <div class="font-mono text-break-all subtext">@ep.PinnedKeyId</div>
                                    </td>
                                    <td>
                                        <span class="@badgeClass">@ep.LastStatus</span>
                                        <span class="subtext font-mono">(@ep.TotalImportedCount)</span>
                                        @if (!string.IsNullOrWhiteSpace(ep.LastError))
                                        {
                                            <div class="subtext text-danger">@ep.LastError</div>
                                        }
                                    </td>
                                    <td class="d-flex align-items-center gap-2">
                                        <button id="btn-run-peer-@ep.PeerId" class="btn btn-outline" @onclick="() => RunSinglePeerSyncAsync(ep.PeerId)" disabled="@_isSyncingRevocationFeed">
                                            @T("FabricationLot.PeerSyncRunOneButton")
                                        </button>
                                        <button id="btn-remove-peer-@ep.PeerId" class="btn btn-outline" @onclick="() => DeletePeerSyncSubscriptionAsync(ep.PeerId)" disabled="@_isSyncingRevocationFeed">
                                            @T("FabricationLot.PeerSyncRemoveButton")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p id="peer-sync-empty" class="subtext mt-3">@T("FabricationLot.PeerSyncEmpty")</p>
            }
        </div>
    </section>
}

@code {
    /// <summary>
    /// Currently selected therapeutic endocrine regimen.
    /// </summary>
    private TherapeuticRegimen _selectedRegimen = TherapeuticRegimen.MaleToFemale;

    /// <summary>
    /// Currently selected polymer matrix carrier type.
    /// </summary>
    private PolymerMatrixType _selectedMatrix = PolymerMatrixType.PlgaPegPlga;

    /// <summary>
    /// Initial loaded nanocarrier payload mass in milligrams.
    /// </summary>
    private double _initialMassMg = 16.0;

    /// <summary>
    /// Nominal daily polymer matrix erosion degradation rate in percent per day.
    /// </summary>
    private double _dailyErosionRatePercent = 0.55;

    /// <summary>
    /// Result of the most recent 180-day time-release depot simulation.
    /// </summary>
    private TimeReleaseSimulationResult? _simulationResult;

    /// <summary>
    /// Persisted active depot formulation identifier for the current studio calibration session.
    /// </summary>
    private string? _activeDepotId;

    /// <summary>
    /// Chronological list of recorded longitudinal serum hormone assays for the active studio session.
    /// </summary>
    private readonly List<DepotAssayObservation> _recordedAssays = [];

    /// <summary>
    /// Latest Bayesian longitudinal calibration result computed from <see cref="_recordedAssays"/>.
    /// </summary>
    private DepotCalibrationResult? _calibrationResult;

    /// <summary>
    /// Form input: elapsed day since depot implantation (1 to 365).
    /// </summary>
    private int _assayDay = 30;

    /// <summary>
    /// Form input: observed serum 17β-estradiol in pmol/L.
    /// </summary>
    private double _assayE2 = 520.0;

    /// <summary>
    /// Form input: observed serum total testosterone in nmol/L.
    /// </summary>
    private double _assayT = 1.1;

    /// <summary>
    /// Form input: observed serum LH in IU/L.
    /// </summary>
    private double _assayLh = 0.6;

    /// <summary>
    /// Form input: observed serum FSH in IU/L.
    /// </summary>
    private double _assayFsh = 0.9;

    /// <summary>
    /// Form input: observed serum SHBG in nmol/L.
    /// </summary>
    private double _assayShbg = 78.0;

    /// <summary>
    /// Form input: observed blood hematocrit percentage.
    /// </summary>
    private double _assayHematocrit = 41.5;

    /// <summary>
    /// Validation or calibration error message displayed in the longitudinal panel.
    /// </summary>
    private string? _assayErrorMessage;

    /// <summary>
    /// Indicates whether an asynchronous assay persistence and calibration operation is in progress.
    /// </summary>
    private bool _isCalibrating;

    /// <summary>
    /// Currently active community localization language.
    /// </summary>
    private WeaverLanguage _currentLanguage = WeaverLanguage.English;

    /// <summary>
    /// Active wet-lab fabrication lot minted from the current depot session.
    /// </summary>
    private FabricationLotRecord? _activeLot;

    /// <summary>
    /// Latest persisted Milestone 34 calibration snapshot identifier for adaptive lot minting.
    /// </summary>
    private string? _latestCalibrationSnapshotId;

    /// <summary>
    /// Recorded wet-lab QC checks for <see cref="_activeLot"/>.
    /// </summary>
    private readonly List<FabricationQcCheckRecord> _lotQcChecks = [];

    /// <summary>
    /// Most recent 5-gate wet-lab release evaluation for <see cref="_activeLot"/>.
    /// </summary>
    private FabricationLotReleaseEvaluation? _lotReleaseEvaluation;

    /// <summary>
    /// Indicates whether the active Certificate of Analysis passed live ML-DSA-65 verification.
    /// </summary>
    private bool _lotCertificateVerified;

    /// <summary>
    /// Toggle indicating whether CpG enzymatic methylation verification is mandatory on newly minted lots.
    /// </summary>
    private bool _lotCpGRequired = true;

    /// <summary>
    /// Currently selected wet-lab pharmaceutical QC gate in the entry form.
    /// </summary>
    private FabricationQcGateType _selectedQcGate = FabricationQcGateType.GelFoldingYield;

    /// <summary>
    /// Primary measured laboratory value entered for the active QC gate.
    /// </summary>
    private double _qcMeasuredValue = 92.4;

    /// <summary>
    /// Optional secondary laboratory value (DLS PDI or gravimetric mass deviation %).
    /// </summary>
    private double? _qcSecondaryValue;

    /// <summary>
    /// Validation or operational error message displayed in the wet-lab lot release panel.
    /// </summary>
    private string? _lotErrorMessage;

    /// <summary>
    /// Indicates whether an asynchronous lot persistence or signing operation is running.
    /// </summary>
    private bool _isLotBusy;

    /// <summary>
    /// Plain-English recall reason entered before revoking an active released lot.
    /// </summary>
    private string _revokeReason = string.Empty;

    /// <summary>
    /// Active lot revocation tombstone once revoked in the current studio session.
    /// </summary>
    private FabricationLotRevocationRecord? _activeLotRevocation;

    /// <summary>
    /// Portable Certificate of Analysis JSON text pasted into the cross-node verifier.
    /// </summary>
    private string _verifyCertificateJson = string.Empty;

    /// <summary>
    /// Validation or parse error message displayed in the cross-node verifier.
    /// </summary>
    private string? _verifyErrorMessage;

    /// <summary>
    /// Latest cross-node trust and revocation verification report.
    /// </summary>
    private FabricationCertificateVerificationReport? _peerVerificationReport;

    /// <summary>
    /// Indicates whether a cross-node certificate verification request is currently executing.
    /// </summary>
    private bool _isVerifyingCertificate;

    /// <summary>
    /// Resolves a localized UI string for the active community language.
    /// </summary>
    /// <param name="key">Dot-notated localization resource key.</param>
    /// <returns>Translated text in the active language.</returns>
    private string T(string key) => Localizer.GetString(key, _currentLanguage);

    /// <summary>
    /// Initializes component state and executes the default baseline simulation.
    /// </summary>
    protected override void OnInitialized()
    {
        // WHAT: Dispatches baseline 180-day depot simulation on component initialization.
        // WHY:  Ensures that clinical metrics and trajectory visualization render immediately for wet-lab operators.
        // HOW:  Invokes RunSimulation with initial defaults.
        RunSimulation();
    }

    /// <summary>
    /// Synchronizes the user's persisted browser language preference after initial client render.
    /// </summary>
    /// <param name="firstRender"><see langword="true"/> on initial interactive render.</param>
    /// <returns>A task representing the asynchronous JS interop language lookup.</returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // WHAT: Queries stored language preference from browser storage and re-renders localized strings.
        // WHY:  Ensures all 18 community locales (including Arabic RTL) render dynamically across the Depot Studio.
        // HOW:  Invokes 'weaverGetLanguage' via JS interop inside a headless-safe try/catch block.
        if (firstRender)
        {
            try
            {
                string? storedTag = await JS.InvokeAsync<string?>("weaverGetLanguage");
                if (!string.IsNullOrWhiteSpace(storedTag))
                {
                    _currentLanguage = Localizer.ResolveLanguage(storedTag);
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
                // Headless bUnit tests or server prerendering
            }
        }
    }

    /// <summary>
    /// Constructs the current baseline <see cref="TimeReleaseDepotParameters"/> from active form inputs.
    /// </summary>
    /// <returns>Configured baseline depot simulation parameters.</returns>
    private TimeReleaseDepotParameters BuildBaselineParameters()
    {
        // WHAT: Translates UI formulation inputs into a strongly typed TimeReleaseDepotParameters record.
        // WHY:  Shares a single canonical baseline specification between forward simulation and longitudinal calibration.
        // HOW:  Maps selected regimen physiological defaults, matrix type, clamped mass, and erosion rate.
        double initialE2 = _selectedRegimen == TherapeuticRegimen.MaleToFemale ? 120.0 : 450.0;
        double initialT = _selectedRegimen == TherapeuticRegimen.MaleToFemale ? 18.0 : 1.5;
        double targetE2 = _selectedRegimen == TherapeuticRegimen.MaleToFemale ? 550.0 : 100.0;
        double targetT = _selectedRegimen == TherapeuticRegimen.MaleToFemale ? 1.2 : 20.0;

        return new TimeReleaseDepotParameters
        {
            Regimen = _selectedRegimen,
            MatrixType = _selectedMatrix,
            KineticsModel = ReleaseKineticsModel.KorsmeyerPeppas,
            InitialPayloadMassMg = Math.Max(1.0, _initialMassMg),
            TargetHorizonDays = 180,
            ClearanceMultiplier = 1.0,
            InitialEstradiolPmolL = initialE2,
            InitialTestosteroneNmolL = initialT,
            InitialLhIuL = 6.5,
            InitialFshIuL = 5.0,
            TargetEstradiolPmolL = targetE2,
            TargetTestosteroneNmolL = targetT,
            DailyErosionRatePercent = Math.Clamp(_dailyErosionRatePercent, 0.05, 100.0)
        };
    }

    /// <summary>
    /// Executes the 180-day time-release depot kinetic simulation using configured parameters.
    /// </summary>
    private void RunSimulation()
    {
        // WHAT: Constructs simulation parameters and invokes computational time-release depot engine.
        // WHY:  Calculates multi-phase elution, HPG feedback suppression, and semi-annual re-dosing alert day.
        // HOW:  Builds baseline parameters and invokes DepotService.Simulate180DayDepot.
        _simulationResult = DepotService.Simulate180DayDepot(BuildBaselineParameters());
    }

    /// <summary>
    /// Resets all formulation parameters to standard clinical defaults and re-runs the simulation.
    /// </summary>
    private void ResetDefaults()
    {
        // WHAT: Restores formulation configuration inputs to pristine clinical defaults.
        // WHY:  Permits wet-lab operators to quickly discard parameter explorations and resume standard protocols.
        // HOW:  Reassigns fields, clears recorded studio assays, and dispatches RunSimulation.
        _selectedRegimen = TherapeuticRegimen.MaleToFemale;
        _selectedMatrix = PolymerMatrixType.PlgaPegPlga;
        _initialMassMg = 16.0;
        _dailyErosionRatePercent = 0.55;
        ClearAssays();
        RunSimulation();
    }

    /// <summary>
    /// Handles changes in therapeutic regimen selection, updating default physiological setpoints.
    /// </summary>
    /// <param name="e">Change event args containing the selected enum string.</param>
    private void HandleRegimenChanged(ChangeEventArgs e)
    {
        // WHAT: Synchronizes selected therapeutic regimen, adjusts default loaded payload mass, and re-executes depot kinetics.
        // WHY:  Different endocrine regimens require distinct baseline and target sex steroid thresholds (16.0 mg E2 for MtF vs 1050.0 mg T for FtM).
        // HOW:  Parses enum value from event string, updates _initialMassMg and default assay values, and invokes RunSimulation.
        if (Enum.TryParse(e.Value?.ToString(), out TherapeuticRegimen regimen))
        {
            _selectedRegimen = regimen;
            _initialMassMg = regimen == TherapeuticRegimen.FemaleToMale ? 1050.0 : 16.0;
            _assayE2 = regimen == TherapeuticRegimen.FemaleToMale ? 95.0 : 520.0;
            _assayT = regimen == TherapeuticRegimen.FemaleToMale ? 21.0 : 1.1;
            _assayHematocrit = regimen == TherapeuticRegimen.FemaleToMale ? 47.0 : 41.5;
            ClearAssays();
            RunSimulation();
        }
    }

    /// <summary>
    /// Validates the longitudinal assay inputs, persists the observation and formulation, runs Bayesian
    /// recalibration, saves the calibration snapshot, and updates the interactive UI overlay.
    /// </summary>
    /// <returns>A task representing the asynchronous persistence and calibration workflow.</returns>
    private async Task RecordAssayAndRecalibrateAsync()
    {
        // WHAT: Persists a new longitudinal serum hormone assay and executes adaptive Bayesian recalibration.
        // WHY:  Enables interactive observed-vs-predicted trajectory comparison and immediate clinical safety evaluation.
        // HOW:  Validates numeric bounds, upserts active depot formulation, records assay via IDepotAssayRepository,
        //       runs IDepotCalibrationService.CalibrateDepot, and persists the calibration snapshot.
        _assayErrorMessage = null;

        if (_assayDay < 1 || _assayDay > 365)
        {
            _assayErrorMessage = "Day since implant must be between 1 and 365.";
            return;
        }

        if (_assayE2 < 0.0 || _assayT < 0.0 || _assayLh < 0.0 || _assayFsh < 0.0 || _assayShbg < 0.0)
        {
            _assayErrorMessage = "Observed hormone concentrations cannot be negative.";
            return;
        }

        if (_assayHematocrit < 0.0 || _assayHematocrit > 100.0)
        {
            _assayErrorMessage = "Observed hematocrit must be between 0.0% and 100.0%.";
            return;
        }

        _isCalibrating = true;
        try
        {
            TimeReleaseDepotParameters baseline = BuildBaselineParameters();
            string patientId = "depot-studio-session";
            if (string.IsNullOrWhiteSpace(_activeDepotId))
            {
                _activeDepotId = $"depot_studio_{Guid.NewGuid():N}";
                await DepotRepository.UpsertDepotFormulationAsync(new DepotFormulationRecord
                {
                    DepotId = _activeDepotId,
                    PatientId = patientId,
                    Regimen = baseline.Regimen,
                    PolymerMatrixType = baseline.MatrixType.ToString(),
                    InitialNanocarrierMassMg = baseline.InitialPayloadMassMg,
                    DailyErosionRatePercent = baseline.DailyErosionRatePercent,
                    ReleaseKineticsModel = baseline.KineticsModel.ToString(),
                    TargetHorizonDays = baseline.TargetHorizonDays,
                    CreatedAtUtc = DateTimeOffset.UtcNow
                });
            }

            DateTimeOffset now = DateTimeOffset.UtcNow;
            await AssayRepository.RecordObservationAsync(new DepotAssayObservationRecord
            {
                DepotId = _activeDepotId,
                PatientId = patientId,
                DaySinceImplant = _assayDay,
                ObservedE2PmolL = _assayE2,
                ObservedTNmolL = _assayT,
                ObservedLhIuL = _assayLh,
                ObservedFshIuL = _assayFsh,
                ObservedShbgNmolL = _assayShbg,
                ObservedHematocritPct = _assayHematocrit,
                RecordedAtUtc = now
            });

            _recordedAssays.Add(new DepotAssayObservation
            {
                DaySinceImplant = _assayDay,
                ObservedE2PmolL = _assayE2,
                ObservedTNmolL = _assayT,
                ObservedLhIuL = _assayLh,
                ObservedFshIuL = _assayFsh,
                ObservedShbgNmolL = _assayShbg,
                ObservedHematocritPct = _assayHematocrit,
                RecordedAtUtc = now
            });
            _recordedAssays.Sort((a, b) => a.DaySinceImplant.CompareTo(b.DaySinceImplant));

            DepotCalibrationResult result = CalibrationService.CalibrateDepot(new DepotCalibrationRequest
            {
                DepotId = _activeDepotId,
                PatientId = patientId,
                BaselineParameters = baseline,
                Observations = _recordedAssays
            });

            DepotCalibrationSnapshotRecord savedSnap = await AssayRepository.SaveCalibrationSnapshotAsync(new DepotCalibrationSnapshotRecord
            {
                DepotId = _activeDepotId,
                PatientId = patientId,
                InferredClearanceMultiplier = result.InferredClearanceMultiplier,
                InferredDailyErosionRatePercent = result.InferredDailyErosionRatePercent,
                AdjustedRedoseDay = result.AdjustedRedoseDay,
                RecommendedNextMassMg = result.RecommendedNextMassMg,
                SafetyStatus = result.OverallSafetyStatus,
                ResidualRmse = result.ResidualRmse,
                ComputedAtUtc = DateTimeOffset.UtcNow
            });

            _latestCalibrationSnapshotId = savedSnap.SnapshotId;
            _calibrationResult = result;
        }
        finally
        {
            _isCalibrating = false;
        }
    }

    /// <summary>
    /// Clears all recorded longitudinal assays and removes the recalibrated overlay from the studio view.
    /// </summary>
    private void ClearAssays()
    {
        // WHAT: Resets session assay history and recalibration state.
        // WHY:  Allows clinicians to start a fresh longitudinal series when switching formulations.
        // HOW:  Clears _recordedAssays, nulls _calibrationResult, _activeDepotId, and _assayErrorMessage.
        _recordedAssays.Clear();
        _calibrationResult = null;
        _latestCalibrationSnapshotId = null;
        _activeDepotId = null;
        _assayErrorMessage = null;
        _activeLot = null;
        _lotQcChecks.Clear();
        _lotReleaseEvaluation = null;
        _lotCertificateVerified = false;
        _lotErrorMessage = null;
        _activeLotRevocation = null;
        _revokeReason = string.Empty;
        _peerVerificationReport = null;
        _verifyErrorMessage = null;
        _activeLotStability = null;
        _activeLotExcursions.Clear();
        _activeLotCustodyLedger = null;
        _coldChainErrorMessage = null;
        _coldChainStatusMessage = null;
        _multiYearReport = null;
        _multiYearErrorMessage = null;
    }

    /// <summary>
    /// Evaluates the overall clinical verdict based on TTR, burst fraction, and gonadotropin suppression.
    /// </summary>
    /// <returns>A tuple containing the clinical status label, CSS badge class, and detailed explanation.</returns>
    private (string Label, string BadgeClass, string Explanation) GetClinicalVerdict()
    {
        // WHAT: Evaluates comprehensive clinical criteria for semi-annual depot efficacy.
        // WHY:  Guarantees patient safety by checking TTR >= 95%, burst <= 5%, and LH/FSH gonadotropin suppression.
        // HOW:  Inspects simulation metrics against international Endocrine Society guidelines.
        if (_simulationResult == null)
        {
            return ("PENDING", "badge-outline", "Simulation pending execution.");
        }

        bool ttrPassed = _simulationResult.TimeInTargetRangePercent >= 95.0;
        bool burstPassed = _simulationResult.BurstSuppressed;
        bool lhPassed = _simulationResult.LhSuppressionAchieved;
        bool fshPassed = _simulationResult.FshSuppressionAchieved;

        if (ttrPassed && burstPassed && lhPassed && fshPassed)
        {
            return (
                "OPTIMAL CLINICAL EFFICACY",
                "badge-success",
                "Formulation satisfies all therapeutic standards: TTR >= 95%, Day 7 burst <= 5.0%, and full HPG axis gonadotropin suppression (LH < 1.0 IU/L, FSH < 1.5 IU/L)."
            );
        }
        else if (burstPassed && ttrPassed)
        {
            return (
                "ACCEPTABLE (MONITOR GONADOTROPINS)",
                "badge-warning",
                "Acceptable time in target range and burst suppression achieved, but pituitary LH/FSH suppression is borderline."
            );
        }
        else
        {
            return (
                "SUBOPTIMAL FORMULATION",
                "badge-danger",
                "Formulation fails clinical thresholds. Adjust polymer matrix composition, loaded mass, or daily erosion degradation rate."
            );
        }
    }

    /// <summary>
    /// Resolves the sovereign theme CSS badge class corresponding to a <see cref="DepotSafetyStatus"/> tier.
    /// </summary>
    /// <param name="status">Clinical safety classification tier.</param>
    /// <returns>A CSS badge utility class name.</returns>
    private static string GetSafetyBadgeClass(DepotSafetyStatus status) => status switch
    {
        DepotSafetyStatus.Optimal => "badge-success",
        DepotSafetyStatus.AdvisoryDrift => "badge-outline",
        DepotSafetyStatus.WarningEscape => "badge-warning",
        DepotSafetyStatus.CriticalSafety => "badge-danger",
        _ => "badge-outline"
    };

    /// <summary>
    /// Projects a recorded longitudinal serum assay onto the 180-day SVG canvas coordinate space.
    /// </summary>
    /// <param name="obs">The recorded serum assay observation.</param>
    /// <returns>Projected <c>(X, Y)</c> pixel coordinates within the SVG viewport.</returns>
    private (double X, double Y) ProjectAssayMarker(DepotAssayObservation obs)
    {
        // WHAT: Maps an observed longitudinal lab draw onto the SVG chart canvas.
        // WHY:  Provides immediate visual alignment between measured blood levels and predicted curves.
        // HOW:  Projects DaySinceImplant (0..180) to X (50..690) and normalized cumulative/target ratio to Y (200..40).
        double clampedDay = Math.Clamp(obs.DaySinceImplant, 0, 180);
        double x = 50.0 + (clampedDay / 180.0) * 640.0;
        double targetRef = _selectedRegimen == TherapeuticRegimen.FemaleToMale ? 30.0 : 900.0;
        double observedPrimary = _selectedRegimen == TherapeuticRegimen.FemaleToMale ? obs.ObservedTNmolL : obs.ObservedE2PmolL;
        double normalizedRatio = Math.Clamp(observedPrimary / targetRef, 0.0, 1.0);
        double y = 200.0 - (normalizedRatio * 160.0);
        return (x, y);
    }

    /// <summary>
    /// Formats an accessible SVG tooltip summarizing a measured longitudinal serum assay point.
    /// </summary>
    /// <param name="obs">The observed serum assay.</param>
    /// <returns>Plain-English tooltip string for SVG <c>&lt;title&gt;</c> elements.</returns>
    private static string FormatAssayTooltip(DepotAssayObservation obs) =>
        string.Format(
            CultureInfo.InvariantCulture,
            "Day {0}: E2 {1:F1} pmol/L, T {2:F2} nmol/L, LH {3:F2} IU/L, FSH {4:F2} IU/L, Hct {5:F1}%",
            obs.DaySinceImplant,
            obs.ObservedE2PmolL,
            obs.ObservedTNmolL,
            obs.ObservedLhIuL,
            obs.ObservedFshIuL,
            obs.ObservedHematocritPct);

    /// <summary>
    /// Builds the SVG path definition for the cumulative release fraction trajectory of a simulation result.
    /// </summary>
    /// <param name="simulation">The simulation result whose cumulative release trajectory should be plotted.</param>
    /// <returns>SVG path string command attribute (e.g. 'M 50 200 L 53 198 ...').</returns>
    private static string GetCumulativeReleasePath(TimeReleaseSimulationResult? simulation)
    {
        // WHAT: Maps daily trajectory simulation points to SVG canvas pixel coordinates.
        // WHY:  Enables responsive vector visualization of baseline and recalibrated 180-day multi-phase elution curves.
        // HOW:  Iterates over points, projecting day (0..180) to X (50..690) and fraction (0..1) to Y (200..40).
        if (simulation == null || simulation.Points.Count == 0)
        {
            return string.Empty;
        }

        StringBuilder sb = new();
        for (int i = 0; i < simulation.Points.Count; i++)
        {
            TimeReleaseDailyPoint pt = simulation.Points[i];
            double x = 50.0 + (pt.Day / 180.0) * 640.0;
            double y = 200.0 - (pt.CumulativeFraction * 160.0);
            char cmd = i == 0 ? 'M' : 'L';
            sb.Append(CultureInfo.InvariantCulture, $"{cmd} {x:F1} {y:F1} ");
        }

        return sb.ToString();
    }

    /// <summary>
    /// Builds the SVG path definition for the remaining reserve trajectory.
    /// </summary>
    /// <returns>SVG path string command attribute for remaining reserve mass.</returns>
    private string GetRemainingReservePath()
    {
        // WHAT: Maps remaining reserve fraction to SVG canvas pixel coordinates.
        // WHY:  Visualizes payload depletion down to the Phase III terminal taper.
        // HOW:  Projects day to X (50..690) and remaining reserve fraction (1..0) to Y (40..200).
        if (_simulationResult == null || _simulationResult.Points.Count == 0 || _initialMassMg <= 0.0)
        {
            return string.Empty;
        }

        StringBuilder sb = new();
        for (int i = 0; i < _simulationResult.Points.Count; i++)
        {
            TimeReleaseDailyPoint pt = _simulationResult.Points[i];
            double fraction = pt.RemainingReserveMg / _initialMassMg;
            double x = 50.0 + (pt.Day / 180.0) * 640.0;
            double y = 200.0 - (fraction * 160.0);
            char cmd = i == 0 ? 'M' : 'L';
            sb.Append(CultureInfo.InvariantCulture, $"{cmd} {x:F1} {y:F1} ");
        }

        return sb.ToString();
    }

    /// <summary>
    /// Retrieves a filtered subset of daily trajectory points for tabular clinical review.
    /// </summary>
    /// <returns>Collection of milestone trajectory points.</returns>
    private IEnumerable<TimeReleaseDailyPoint> GetMilestonePoints()
    {
        // WHAT: Filters simulation points to key clinical milestone days.
        // WHY:  Provides a concise tabular overview of Day 0, Day 7, Day 30, Day 60, Day 90, Day 120, Day 150, Day 180.
        // HOW:  Yields points matching milestone day thresholds and the final simulation day.
        if (_simulationResult == null)
        {
            yield break;
        }

        int[] milestoneDays = [0, 7, 30, 60, 90, 120, 150, 180];
        foreach (int day in milestoneDays)
        {
            if (day < _simulationResult.Points.Count)
            {
                yield return _simulationResult.Points[day];
            }
        }
    }

    /// <summary>
    /// Updates default measurement placeholders when the operator switches the active pharmaceutical QC gate.
    /// </summary>
    /// <param name="e">Change event arguments carrying the selected <see cref="FabricationQcGateType"/> name.</param>
    private void HandleQcGateChanged(ChangeEventArgs e)
    {
        // WHAT: Updates default laboratory measurement inputs to typical passing reference values for the selected gate.
        // WHY:  Streamlines benchtop QC entry and reminds operators of expected units per gate.
        // HOW:  Parses FabricationQcGateType and assigns gate-specific default primary/secondary values.
        if (Enum.TryParse(e.Value?.ToString(), out FabricationQcGateType gate))
        {
            _selectedQcGate = gate;
            (_qcMeasuredValue, _qcSecondaryValue) = gate switch
            {
                FabricationQcGateType.GelFoldingYield => (92.4, (double?)null),
                FabricationQcGateType.EndotoxinSterility => (0.14, (double?)null),
                FabricationQcGateType.HydrodynamicSizePdi => (62.0, (double?)0.12),
                FabricationQcGateType.PayloadEncapsulation => (89.0, (double?)1.5),
                _ => (98.2, (double?)null)
            };
        }
    }

    /// <summary>
    /// Mints a new patient-specific wet-lab nanocarrier fabrication lot inheriting active depot or calibrated parameters.
    /// </summary>
    /// <returns>A task representing the asynchronous lot creation operation.</returns>
    private async Task MintFabricationLotAsync()
    {
        // WHAT: Persists a new wet-lab fabrication lot bound to the active depot formulation and Opentrons SHA-256 digest.
        // WHY:  Milestone 35 (P188): Connects adaptive Milestone 34 recommendations directly into physical batch manufacturing.
        // HOW:  Ensures the parent depot exists in DepotRepository, selects calibrated or baseline mass/erosion, and upserts lot.
        _lotErrorMessage = null;
        _isLotBusy = true;
        try
        {
            TimeReleaseDepotParameters baseline = BuildBaselineParameters();
            string patientId = "depot-studio-session";
            if (string.IsNullOrWhiteSpace(_activeDepotId))
            {
                _activeDepotId = $"depot_studio_{Guid.NewGuid():N}";
                await DepotRepository.UpsertDepotFormulationAsync(new DepotFormulationRecord
                {
                    DepotId = _activeDepotId,
                    PatientId = patientId,
                    Regimen = baseline.Regimen,
                    PolymerMatrixType = baseline.MatrixType.ToString(),
                    InitialNanocarrierMassMg = baseline.InitialPayloadMassMg,
                    DailyErosionRatePercent = baseline.DailyErosionRatePercent,
                    ReleaseKineticsModel = baseline.KineticsModel.ToString(),
                    TargetHorizonDays = baseline.TargetHorizonDays,
                    CreatedAtUtc = DateTimeOffset.UtcNow
                });
            }

            double targetMassMg = _calibrationResult?.RecommendedNextMassMg ?? baseline.InitialPayloadMassMg;
            double targetErosion = _calibrationResult?.RecommendedNextErosionRatePercent ?? baseline.DailyErosionRatePercent;
            string opentronsSha = LotService.ComputeOpentronsProtocolSha256(
                _activeDepotId,
                patientId,
                baseline.Regimen,
                baseline.MatrixType.ToString(),
                targetMassMg,
                targetErosion);

            _activeLot = await LotRepository.UpsertLotAsync(new FabricationLotRecord
            {
                DepotId = _activeDepotId,
                CalibrationSnapshotId = _latestCalibrationSnapshotId,
                PatientId = patientId,
                Regimen = baseline.Regimen,
                PolymerMatrixType = baseline.MatrixType.ToString(),
                TargetMassMg = targetMassMg,
                TargetErosionRatePercent = targetErosion,
                CpGMethylationRequired = _lotCpGRequired,
                OpentronsProtocolSha256 = opentronsSha,
                LotStatus = FabricationLotStatus.Draft,
                CreatedAtUtc = DateTimeOffset.UtcNow
            });

            _lotQcChecks.Clear();
            _lotReleaseEvaluation = null;
            _lotCertificateVerified = false;
            _activeLotExcursions.Clear();
            _coldChainErrorMessage = null;
            _coldChainStatusMessage = null;
            _pvErrorMessage = null;
            _pvStatusMessage = null;
            await RefreshColdChainStateAsync();
            await RefreshPharmacovigilanceStateAsync();
        }
        finally
        {
            _isLotBusy = false;
        }
    }

    /// <summary>
    /// Evaluates and persists a single pharmaceutical wet-lab QC measurement for the active lot.
    /// </summary>
    /// <returns>A task representing the asynchronous QC persistence operation.</returns>
    private async Task RecordQcGateAsync()
    {
        // WHAT: Evaluates the entered QC gate reading via IFabricationLotService and logs it to IFabricationLotRepository.
        // WHY:  Captures verifiable 5-gate wet-lab evidence prior to cryptographic Certificate of Analysis signing.
        // HOW:  Validates an active lot exists, runs EvaluateSingleGate, persists check, and transitions lot to QcPending.
        _lotErrorMessage = null;
        if (_activeLot is null)
        {
            _lotErrorMessage = "Mint a wet-lab fabrication lot before recording QC checks.";
            return;
        }

        _isLotBusy = true;
        try
        {
            FabricationQcGateEvaluation eval = LotService.EvaluateSingleGate(_selectedQcGate, _qcMeasuredValue, _qcSecondaryValue);
            FabricationQcCheckRecord saved = await LotRepository.RecordQcCheckAsync(new FabricationQcCheckRecord
            {
                LotId = _activeLot.LotId,
                PatientId = _activeLot.PatientId,
                GateType = _selectedQcGate,
                MeasuredValue = _qcMeasuredValue,
                SecondaryValue = _qcSecondaryValue,
                ThresholdValue = eval.ThresholdValue,
                Passed = eval.Passed,
                RecordedAtUtc = DateTimeOffset.UtcNow
            });

            _lotQcChecks.Add(saved);
            if (_activeLot.LotStatus is FabricationLotStatus.Draft or FabricationLotStatus.Quarantined)
            {
                _activeLot = await LotRepository.UpsertLotAsync(_activeLot with { LotStatus = FabricationLotStatus.QcPending });
            }
        }
        finally
        {
            _isLotBusy = false;
        }
    }

    /// <summary>
    /// Executes 5-gate pharmaceutical verification and signs a post-quantum ML-DSA-65 Certificate of Analysis on pass.
    /// </summary>
    /// <returns>A task representing the asynchronous cryptographic release operation.</returns>
    private async Task ReleaseFabricationLotAsync()
    {
        // WHAT: Evaluates all required wet-lab QC gates on the active lot and transitions it to Released or Quarantined.
        // WHY:  Enforces fail-closed clinical safety with live NIST FIPS 204 ML-DSA-65 cryptographic verification.
        // HOW:  Calls IFabricationLotService.EvaluateAndSignLotRelease, persists updated lot metadata, and runs VerifyLotCertificate.
        _lotErrorMessage = null;
        if (_activeLot is null)
        {
            _lotErrorMessage = "Mint a wet-lab fabrication lot before executing lot release.";
            return;
        }

        _isLotBusy = true;
        try
        {
            FabricationLotReleaseEvaluation eval = LotService.EvaluateAndSignLotRelease(_activeLot, _lotQcChecks);
            FabricationLotRecord updated = eval.Certificate is not null
                ? _activeLot with
                {
                    LotStatus = FabricationLotStatus.Released,
                    CertificatePayloadSha256 = eval.Certificate.PayloadSha256,
                    CertificateSignatureBase64 = eval.Certificate.SignatureBase64,
                    CertificateSignerKeyId = eval.Certificate.SignerKeyId,
                    ReleasedAtUtc = eval.Certificate.IssuedAtUtc
                }
                : _activeLot with
                {
                    LotStatus = FabricationLotStatus.Quarantined,
                    CertificatePayloadSha256 = null,
                    CertificateSignatureBase64 = null,
                    CertificateSignerKeyId = null,
                    ReleasedAtUtc = null
                };

            _activeLot = await LotRepository.UpsertLotAsync(updated);
            _lotReleaseEvaluation = eval;
            _lotCertificateVerified = eval.Certificate is not null && LotService.VerifyLotCertificate(eval.Certificate);
            await RefreshColdChainStateAsync();
            await RefreshPharmacovigilanceStateAsync();
        }
        finally
        {
            _isLotBusy = false;
        }
    }

