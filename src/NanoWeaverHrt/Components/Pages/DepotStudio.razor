    /// </summary>
    /// <returns>A task representing the asynchronous revocation operation.</returns>
    private async Task RevokeActiveLotAsync()
    {
        // WHAT: Transitions the active released lot to Revoked and writes a permanent revocation record.
        // WHY:  Milestone 36 (P193): Enforces immediate recall blocking inside DepotStudio and across verifiers.
        // HOW:  Validates non-blank reason, updates lot status, records tombstone via LotRepository, and updates UI.
        _lotErrorMessage = null;
