        // WHY:  Milestone 38 (P203): Allows clinicians to copy/share signed recall feeds with peer sovereign nodes.
        // HOW:  Lists local revocations, signs via LotService.BuildSignedRevocationFeed, and formats indented JSON.
        _revocationFeedErrorMessage = null;
