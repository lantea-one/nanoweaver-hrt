    /// <summary>
    /// Logs a cold-chain temperature interval for <see cref="_activeLot"/> and updates Arrhenius potency and shelf-life metrics.
    /// </summary>
    /// <returns>A task representing the asynchronous excursion logging operation.</returns>
    private async Task RecordColdChainExcursionAsync()
    {
        // WHAT: Submits a temperature-duration interval to IColdChainStabilityService and updates UI telemetry.
        // WHY:  Milestone 40 (P213): Evaluates Arrhenius thermal degradation and dsDNA melting cliffs interactively.
        // HOW:  Guards on _activeLot, calls RecordThermalExcursionAsync, appends response to _activeLotExcursions, and handles validation exceptions.
        _coldChainErrorMessage = null;
        _coldChainStatusMessage = null;
        if (_activeLot is null)
        {
            _coldChainErrorMessage = "Mint a fabrication lot before recording thermal intervals.";
            return;
        }

        _isLotBusy = true;
        try
        {
            ThermalExcursionResponse? recorded = await ColdChainService.RecordThermalExcursionAsync(
                _activeLot.LotId,
                new RecordThermalExcursionRequest
                {
                    TemperatureCelsius = _ccTemperatureCelsius,
                    DurationHours = _ccDurationHours,
                    StorageTier = _ccStorageTier,
                    SensorId = _ccSensorId,
                    Notes = string.IsNullOrWhiteSpace(_ccNotes) ? null : _ccNotes
                },
                "depot-studio-operator");

            if (recorded is not null)
            {
                _activeLotExcursions.Add(recorded);
                _activeLotStability = recorded.StabilityAfterExcursion;
                _coldChainStatusMessage = string.Create(
                    CultureInfo.InvariantCulture,
                    $"Recorded {recorded.TemperatureCelsius:F1}°C / {recorded.DurationHours:F1}h interval: {recorded.StabilityAfterExcursion.RemainingPotencyPercent:F2}% potency remaining.");
            }
        }
        catch (ArgumentException ex)
        {
            _coldChainErrorMessage = ex.Message;
        }
        finally
        {
            _isLotBusy = false;
        }
    }

    /// <summary>
    /// Appends a SHA-256 hash-chained physical custody handoff for <see cref="_activeLot"/>, surfacing fail-closed blocks in UI alerts.
    /// </summary>
    /// <returns>A task representing the asynchronous custody handoff operation.</returns>
    private async Task RecordColdChainHandoffAsync()
    {
        // WHAT: Commits a hash-chained custody handoff via IColdChainStabilityService and refreshes stability/ledger views.
        // WHY:  Milestone 40 (P213): Enforces fail-closed blocking of compromised or recalled PatientAdministration handoffs in Depot Studio.
        // HOW:  Calls RecordCustodyHandoffAsync, refreshes cold-chain state, and maps ArgumentException / InvalidOperationException to #cc-error.
        _coldChainErrorMessage = null;
        _coldChainStatusMessage = null;
        if (_activeLot is null)
        {
            _coldChainErrorMessage = "Mint a fabrication lot before recording custody handoffs.";
            return;
        }

        _isLotBusy = true;
        try
        {
            CustodyHandoffRecord? recorded = await ColdChainService.RecordCustodyHandoffAsync(
                _activeLot.LotId,
                new RecordCustodyHandoffRequest
                {
                    Stage = _ccCustodyStage,
                    FromActor = _ccFromCustodian,
                    ToActor = _ccToCustodian,
                    FacilityCode = _ccLocationFacility,
                    TemperatureCelsius = _ccHandoffTempCelsius
                },
                "depot-studio-operator");

            await RefreshColdChainStateAsync();
            if (recorded is not null)
            {
                _coldChainStatusMessage = $"Appended {recorded.Stage} custody handoff ({recorded.FromActor} -> {recorded.ToActor}).";
            }
        }
        catch (ArgumentException ex)
        {
            _coldChainErrorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            await RefreshColdChainStateAsync();
            _coldChainErrorMessage = string.IsNullOrWhiteSpace(ex.Message)
                ? T("ColdChain.PatientAdministrationBlocked")
                : ex.Message;
        }
        finally
        {
            _isLotBusy = false;
        }
    }

