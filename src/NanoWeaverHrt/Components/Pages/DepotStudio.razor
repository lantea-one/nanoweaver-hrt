    /// <summary>
    /// Parses a pasted Certificate of Analysis JSON bundle and verifies its ML-DSA-65 signature,
    /// local/peer trust anchor, and revocation status.
    /// </summary>
    /// <returns>A task representing the asynchronous certificate verification operation.</returns>
    private async Task VerifyPastedCertificateAsync()
    {
        // WHAT: Verifies an imported or local ML-DSA-65 Certificate of Analysis JSON bundle against trust anchors.
        // WHY:  Milestone 36 (P193): Surfaces live cross-node signature, peer registry, and revocation checks in UI.
        // HOW:  Deserializes JSON, checks IPeerKeyRegistry and LotRepository revocation tombstones, and calls LotService.
        _verifyErrorMessage = null;
        _peerVerificationReport = null;

        if (string.IsNullOrWhiteSpace(_verifyCertificateJson))
        {
            _verifyErrorMessage = "Paste a signed Certificate of Analysis JSON bundle to verify.";
            return;
        }

        _isVerifyingCertificate = true;
        try
        {
            FabricationLotCertificate? certificate = JsonSerializer.Deserialize<FabricationLotCertificate>(
                _verifyCertificateJson,
                new JsonSerializerOptions(JsonSerializerDefaults.Web));

            if (certificate is null || string.IsNullOrWhiteSpace(certificate.LotId))
            {
                _verifyErrorMessage = "JSON payload is not a valid Certificate of Analysis (missing lotId).";
                return;
            }

            IReadOnlyList<PeerKeyRecord> peers = await PeerKeyRegistry.ListAsync();
            PeerKeyRecord? matchedPeer = null;
            for (int i = 0; i < peers.Count; i++)
            {
                if (string.Equals(peers[i].KeyId, certificate.SignerKeyId, StringComparison.OrdinalIgnoreCase))
                {
                    matchedPeer = peers[i];
                    break;
                }
            }

            FabricationLotRevocationRecord? revocation = await LotRepository.GetLotRevocationAsync(certificate.LotId.Trim());
            if (revocation is null)
            {
                FederatedLotRevocationRecord? fed = await LotRepository.GetFederatedRevocationAsync(certificate.LotId.Trim());
                if (fed is not null)
                {
                    revocation = FabricationLotService.ToEffectiveRevocation(fed);
                }
            }

            FabricationCertificateVerificationReport baseReport = LotService.VerifyCertificateAgainstTrustAnchor(certificate, matchedPeer, revocation);
            FabricationCertificateVerificationReport coldGated = await ColdChainService.ApplyColdChainStabilityGateAsync(baseReport);
            _peerVerificationReport = await PharmacovigilanceService.ApplyPharmacovigilanceGateAsync(coldGated);
        }
        catch (JsonException)
        {
            _verifyErrorMessage = "Invalid JSON syntax in Certificate of Analysis payload.";
        }
        finally
        {
            _isVerifyingCertificate = false;
        }
    }

