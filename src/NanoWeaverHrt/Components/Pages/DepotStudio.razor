    /// <summary>
    /// Executes and persists a coupled hydrogel-to-epigenetic multi-year durability simulation for the active depot.
    /// </summary>
    /// <returns>A task representing the asynchronous multi-year simulation run.</returns>
    private async Task RunMultiYearHomeostasisSimulationAsync()
    {
        // WHAT: Ensures a persisted depot exists for this studio session and runs IMultiYearHomeostasisService.
        // WHY:  Milestone 43 (P228): Lets clinicians forecast 1-10 year handoff continuity and mitotic drift directly in Depot Studio.
        // HOW:  Saves baseline depot if missing, calls SimulateAndPersistAsync, and renders validation errors cleanly on ArgumentException.
        _multiYearErrorMessage = null;
        _isSimulatingMultiYear = true;
        try
        {
            TimeReleaseDepotParameters baseline = BuildBaselineParameters();
            string patientId = "depot-studio-session";
            if (string.IsNullOrWhiteSpace(_activeDepotId))
            {
                _activeDepotId = $"depot_studio_{Guid.NewGuid():N}";
                await DepotRepository.UpsertDepotFormulationAsync(new DepotFormulationRecord
                {
                    DepotId = _activeDepotId,
                    PatientId = patientId,
                    Regimen = baseline.Regimen,
                    PolymerMatrixType = baseline.MatrixType.ToString(),
                    InitialNanocarrierMassMg = baseline.InitialPayloadMassMg,
                    DailyErosionRatePercent = baseline.DailyErosionRatePercent,
                    ReleaseKineticsModel = baseline.KineticsModel.ToString(),
                    TargetHorizonDays = baseline.TargetHorizonDays,
                    CreatedAtUtc = DateTimeOffset.UtcNow
                });
            }

            _multiYearReport = await MultiYearService.SimulateAndPersistAsync(
                _activeDepotId,
                new SimulateMultiYearHomeostasisRequest
                {
                    CircuitId = string.IsNullOrWhiteSpace(_multiYearCircuitId) ? null : _multiYearCircuitId.Trim(),
                    HorizonYears = _multiYearHorizonYears,
                    MitoticFidelityRate = _multiYearFidelityRate,
                    TransducedProgenitorFraction = _multiYearProgenitorFraction
                },
                "depot-studio-operator");
        }
        catch (ArgumentException ex)
        {
            _multiYearErrorMessage = ex.Message;
        }
        finally
        {
            _isSimulatingMultiYear = false;
        }
    }

