    /// into SVG path coordinates (<c>x in [50..690]</c>, <c>y in [30..180]</c>).
    /// </summary>
    /// <param name="report">Computed multi-year forecast report.</param>
    /// <param name="selector">Normalized [0..1] metric accessor.</param>
    /// <param name="closeArea">True to close the path down to the x-axis for translucent area shading.</param>
    /// <returns>Formatted SVG path data string.</returns>
    private static string BuildMultiYearMetricPath(
        MultiYearHomeostasisForecastReport report,
        Func<MultiYearTrajectoryPoint, double> selector,
        bool closeArea)
    {
        // WHAT: Converts multi-year trajectory samples into an SVG polyline or closed area path string.
        // WHY:  Avoids duplicating SVG viewport projection math across exogenous, endogenous, and chromatin memory curves.
        // HOW:  Scales Day / maxDay across [50..690] and normalized value across [180..30] without LINQ allocations.
        if (report.TrajectorySamples.Count == 0)
        {
            return string.Empty;
        }

        double maxDays = Math.Max(1.0, report.SimulatedDays);
        StringBuilder sb = new(report.TrajectorySamples.Count * 20);
        double firstX = 50.0;
        double lastX = 50.0;

        for (int i = 0; i < report.TrajectorySamples.Count; i++)
        {
            MultiYearTrajectoryPoint pt = report.TrajectorySamples[i];
            double x = 50.0 + ((pt.Day / maxDays) * 640.0);
            double val = Math.Clamp(selector(pt), 0.0, 1.0);
            double y = 180.0 - (val * 150.0);

            if (i == 0)
            {
                firstX = x;
                sb.AppendFormat(CultureInfo.InvariantCulture, "M {0:F1} {1:F1}", x, y);
            }
            else
            {
                sb.AppendFormat(CultureInfo.InvariantCulture, " L {0:F1} {1:F1}", x, y);
            }

            lastX = x;
        }

        if (closeArea)
        {
            sb.AppendFormat(CultureInfo.InvariantCulture, " L {0:F1} 180.0 L {1:F1} 180.0 Z", lastX, firstX);
        }

        return sb.ToString();
    }
}
