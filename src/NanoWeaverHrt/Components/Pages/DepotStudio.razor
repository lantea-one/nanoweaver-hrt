            FederatedPeerSyncRunResult result = await PeerSyncService.SyncPeerAsync(peerId, "studio_operator");
            _peerSyncEndpoints = await PeerSyncService.ListSubscriptionsAsync();
            _federatedRecalls = await LotRepository.ListFederatedRevocationsAsync();
            if (result.Succeeded)
            {
                _peerSyncStatusMessage = result.Summary;
            }
            else
            {
                _peerSyncErrorMessage = result.Summary;
            }
        }
        finally
        {
            _isSyncingRevocationFeed = false;
        }
    }

