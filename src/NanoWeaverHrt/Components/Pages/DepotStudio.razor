        // WHY:  Milestone 39 (P208): Lets clinicians pull urgent upstream recalls on demand.
        // HOW:  Calls PeerSyncService.SyncPeerAsync and refreshes both peer telemetry and federated recall tables.
        _isSyncingRevocationFeed = true;
