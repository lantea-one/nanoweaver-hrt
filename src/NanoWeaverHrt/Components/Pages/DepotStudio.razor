        }
    }

    /// <summary>
    /// Parses, verifies, and persists a pasted ML-DSA-65 signed peer revocation feed.
    /// </summary>
    /// <returns>A task representing the asynchronous verification and import operation.</returns>
    private async Task ImportSignedRevocationFeedAsync()
    {
        // WHAT: Verifies a peer node's ML-DSA-65 revocation feed signature and trust anchor before persisting recall tombstones.
        // WHY:  Milestone 38 (P203): Enforces fail-closed cross-node recall propagation directly from Depot Studio.
        // HOW:  Deserializes JSON, looks up signer key in IPeerKeyRegistry, runs VerifySignedRevocationFeed, and upserts entries.
        _revocationFeedErrorMessage = null;
        _revocationFeedStatusMessage = null;
        if (string.IsNullOrWhiteSpace(_revocationFeedJson))
        {
            _revocationFeedErrorMessage = "Paste a signed ML-DSA-65 revocation feed JSON bundle to import.";
            return;
        }

        _isSyncingRevocationFeed = true;
        try
        {
            SignedLotRevocationFeed? feed = JsonSerializer.Deserialize<SignedLotRevocationFeed>(
                _revocationFeedJson,
                new JsonSerializerOptions(JsonSerializerDefaults.Web));
            if (feed is null)
            {
                _revocationFeedErrorMessage = "JSON payload is not a valid signed revocation feed.";
                return;
            }

            IReadOnlyList<PeerKeyRecord> peers = await PeerKeyRegistry.ListAsync();
            PeerKeyRecord? matchedPeer = null;
            for (int i = 0; i < peers.Count; i++)
            {
                if (string.Equals(peers[i].KeyId, feed.SignerKeyId, StringComparison.OrdinalIgnoreCase))
                {
                    matchedPeer = peers[i];
                    break;
                }
            }

            RevocationFeedVerificationResult verdict = LotService.VerifySignedRevocationFeed(feed, matchedPeer);
            if (!verdict.IsTrusted)
            {
                _revocationFeedErrorMessage = verdict.Summary;
                return;
            }

            DateTimeOffset importedAtUtc = DateTimeOffset.UtcNow;
            int count = 0;
            for (int i = 0; i < feed.Entries.Count; i++)
            {
                SignedLotRevocationEntry entry = feed.Entries[i];
                if (string.IsNullOrWhiteSpace(entry.LotId)
                    || string.IsNullOrWhiteSpace(entry.RevokedBy)
                    || string.IsNullOrWhiteSpace(entry.RevocationReason))
                {
                    continue;
                }

                await LotRepository.UpsertFederatedRevocationAsync(new FederatedLotRevocationRecord
                {
                    LotId = entry.LotId.Trim(),
                    PayloadSha256 = entry.PayloadSha256,
                    IssuerKeyId = feed.SignerKeyId,
                    IssuerPeerLabel = verdict.TrustedPeerLabel,
                    RevokedBy = entry.RevokedBy.Trim(),
                    RevocationReason = entry.RevocationReason.Trim(),
                    RevokedAtUtc = entry.RevokedAtUtc,
                    FeedPayloadSha256 = feed.PayloadSha256,
                    FeedSignatureBase64 = feed.SignatureBase64,
                    ImportedAtUtc = importedAtUtc
                });
                count++;
            }

            _federatedRecalls = await LotRepository.ListFederatedRevocationsAsync();
            _revocationFeedStatusMessage = $"Verified and imported {count} federated recall tombstone(s).";
        }
        catch (JsonException)
        {
            _revocationFeedErrorMessage = "Invalid JSON syntax in signed revocation feed payload.";
        }
        finally
        {
            _isSyncingRevocationFeed = false;
        }
    }

