    private async Task DeleteContactAsync(string id)
    {
        // WHAT: Removes an outreach contact entry from the repository.
        // WHY:  Allows patients to update or revoke designated emergency contacts.
        // HOW:  Calls DeleteContactAsync and re-queries the contact list.
        try
