@page "/trajectories"
@using NanoWeaverHrt.Analytics
@inject IDatasetManager DatasetManager
@inject XyzPipeReader XyzParser
@inject DcdPipeReader DcdParser
@inject LammpsCustomPipeReader LammpsParser
@inject IParquetTrajectoryWriter ParquetWriter
@inject IConfigurationRepository ConfigRepo
@inject ITrajectoryAnalyticsService AnalyticsService

<div class="trajectory-container">
    <div class="panel-header">
        <div>
            <h2>Active Simulation Trajectories &amp; Sovereign Data Exchange</h2>
            <p class="panel-desc">Shared memory volume file explorer (<code>/workspace/data</code>), zero-allocation streaming slicer, and cryptographic transfer hub.</p>
        </div>
        <button class="btn btn-secondary btn-sm" disabled="@_isLoading" @onclick="LoadTrajectoriesAsync">
            @(_isLoading ? "Scanning Volume..." : "⟳ Refresh File List")
        </button>
    </div>

    <!-- Active Trajectories Table -->
    <div class="card panel mt-3">
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Trajectory File Name</th>
                        <th>Format</th>
                        <th>Size</th>
                        <th>Last Modified</th>
                        <th class="text-right">Zero-Allocation Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_files.Count == 0)
                    {
                        <tr><td colspan="5" class="empty-state">No trajectory files discovered in shared storage volume.</td></tr>
                    }
                    else
                    {
                        @foreach (TrajectoryFileItem file in _files)
                        {
                            <tr>
                                <td class="font-mono"><strong>@file.Name</strong></td>
                                <td><span class="badge badge-accent">@file.Format</span></td>
                                <td class="font-mono">@file.SizeFormatted</td>
                                <td class="subtext">@file.LastModifiedUtc</td>
                                <td class="text-right">
                                    <div class="btn-group">
                                        <a href="@file.DownloadUrl" class="btn btn-sm btn-outline" download="@file.Name" title="Download raw trajectory file">
                                            📥 Download
                                        </a>
                                        <button class="btn btn-sm btn-primary" @onclick="() => StreamParseFileAsync(file.Name)">
                                            ⚡ Stream Parse
                                        </button>
                                        <button class="btn btn-sm btn-outline" @onclick="() => ConvertToParquetAsync(file.Name)">
                                            📦 Parquet
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (!string.IsNullOrEmpty(_consoleOutput))
        {
            <div class="console-box mt-3">
                <div class="console-header">ZERO-ALLOCATION PIPELINE TELEMETRY CONSOLE</div>
                <div class="console-body font-mono">@_consoleOutput</div>
            </div>
        }
    </div>

    <!-- Columnar Trajectory Analytics & SQL Query Drawer -->
    <div class="card panel mt-4" id="analytics-section">
        <div class="panel-header">
            <div>
                <h3>Trajectory Parquet Analytics &amp; In-Process SQL</h3>
                <p class="panel-desc">Interactive columnar SQL execution directly over converted Apache Parquet datasets or in-memory analytical sessions via DuckDB.</p>
            </div>
            <button class="btn btn-secondary btn-sm" @onclick="ToggleQueryDrawer">
                @(_drawerOpen ? "▲ Hide Query Drawer" : "▼ Open Query Drawer")
            </button>
        </div>

        @if (_drawerOpen)
        {
            <div class="query-drawer mt-3">
                <div class="grid-2col">
                    <div class="form-group">
                        <label class="form-label" for="dataset-select">Target Dataset / Parquet File:</label>
                        <select id="dataset-select" class="input-select font-mono" @bind="_queryDataset">
                            <option value="sample">sample (In-Memory Origami Beads)</option>
                            <option value=":memory:">:memory: (Ephemeral DuckDB Session)</option>
                            @foreach (TrajectoryFileItem file in _files)
                            {
                                <option value="@Path.GetFileNameWithoutExtension(file.Name)">@file.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="preset-select">Preset Analytical Templates:</label>
                        <select id="preset-select" class="input-select" @onchange="OnPresetSelected">
                            <option value="">-- Choose an analytical template --</option>
                            <option value="region">Distribution of Beads by Region</option>
                            <option value="bbox">Bounding Box Dimensions</option>
                            <option value="density">Frame Count &amp; Atom Density</option>
                        </select>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <label class="form-label" for="sql-query-input">SQL Query (Read-Only):</label>
                    <textarea id="sql-query-input" class="input-text font-mono" rows="4" @bind="_queryText" placeholder="SELECT * FROM trajectory LIMIT 50;"></textarea>
                </div>

                <div class="mt-3 flex-between">
                    <div class="subtext">
                        <span>Max Rows: </span>
                        <input id="max-rows-input" type="number" class="input-number" style="width: 80px;" @bind="_queryMaxRows" min="1" max="10000" />
                    </div>
                    <div class="btn-group">
                        <button class="btn btn-outline btn-sm" @onclick="ClearQueryResults">
                            Clear Results
                        </button>
                        <button class="btn btn-primary btn-sm" id="btn-run-query" disabled="@_isQueryExecuting" @onclick="ExecuteAnalyticsQueryAsync">
                            @(_isQueryExecuting ? "Executing Query..." : "⚡ Run Columnar SQL")
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_queryError))
                {
                    <div class="callout-box mt-3" style="border-left-color: var(--accent-rose, #e06c75);">
                        <div class="callout-title" style="color: var(--accent-rose, #e06c75);">⚠️ Query Execution Error</div>
                        <div class="font-mono subtext" id="query-error-message">@_queryError</div>
                    </div>
                }

                @if (_analyticsResult != null)
                {
                    <div class="result-box mt-3" id="query-results-box">
                        <div class="flex-between">
                            <div class="result-title">Query Results: @_analyticsResult.TotalRows row(s) returned</div>
                            <span class="badge badge-accent">@(_analyticsResult.ElapsedMilliseconds.ToString("F2")) ms</span>
                        </div>

                        <div class="table-container mt-2">
                            <table class="data-table" id="analytics-results-table">
                                <thead>
                                    <tr>
                                        @foreach (string col in _analyticsResult.Columns)
                                        {
                                            <th>@col</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_analyticsResult.Rows.Count == 0)
                                    {
                                        <tr><td colspan="@_analyticsResult.Columns.Count" class="empty-state">No matching records returned.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (IReadOnlyList<object?> row in _analyticsResult.Rows)
                                        {
                                            <tr>
                                                @foreach (object? cell in row)
                                                {
                                                    <td class="font-mono">@(cell?.ToString() ?? "NULL")</td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Sovereign Import / Export Panels -->
    <div class="grid-2col mt-4">
        <!-- Export Section -->
        <div class="card panel">
            <div class="panel-header">
                <h3>Package &amp; Sign Sovereign Dataset</h3>
            </div>
            <p class="subtext">Packages simulation files into an immutable .tar.gz bundle with a deterministic SHA-256 provenance manifest.</p>
            <div class="form-group mt-3">
                <label class="form-label">Dataset Bundle Name:</label>
                <input type="text" class="input-text font-mono" @bind="_exportBundleName" placeholder="e.g., dna-origami-nanotube-bundle" />
            </div>
            <div class="mt-3 text-right">
                <button class="btn btn-primary" disabled="@_isExporting" @onclick="ExportDatasetAsync">
                    @(_isExporting ? "Packaging & Hashing..." : "Export & Sign Dataset")
                </button>
            </div>
            @if (_lastExportManifest != null)
            {
                <div class="result-box mt-3">
                    <div class="result-title">Manifest Generated:</div>
                    <div class="hash-badge">SHA-256: @_lastExportManifest.Sha256Checksum</div>
                    <div class="mt-2">
                        <a href="/api/datasets/download/@_lastExportManifest.ArchiveFileName" class="btn btn-outline btn-sm">
                            📥 Download Archive (@((_lastExportManifest.SizeInBytes / 1024.0 / 1024.0).ToString("F2")) MB)
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Import Section -->
        <div class="card panel">
            <div class="panel-header">
                <h3>Verify &amp; Import Peer Dataset</h3>
            </div>
            <p class="subtext">Upload a peer's dataset archive (.tar.gz) and its manifest. The SHA-256 hash is verified before extracting.</p>
            <div class="callout-box mt-2">
                <div class="callout-title">🛡️ Cryptographic Integrity Assurance</div>
                <div>Any tampered, corrupted, or altered byte in the archive will cause the SHA-256 validation to fail, preventing untrusted coordinate execution.</div>
            </div>
            <div class="mt-3">
                <span class="subtext">Use the REST API endpoint <code>POST /api/datasets/import</code> for multipart upload and cryptographic verification.</span>
            </div>
        </div>
    </div>

    <!-- Exported Sovereign Bundles & Provenance Artifacts Management -->
    <div class="card panel mt-4">
        <div class="panel-header">
            <div>
                <h3>Exported Sovereign Bundles &amp; Provenance Artifacts</h3>
                <p class="panel-desc">Manage cryptographically hashed <code>.tar.gz</code> archive packages and SHA-256 provenance manifests available for direct web download.</p>
            </div>
            <button class="btn btn-secondary btn-sm" disabled="@_isExportLoading" @onclick="LoadExportsAsync">
                @(_isExportLoading ? "Refreshing..." : "⟳ Refresh Exports")
            </button>
        </div>

        <div class="table-container mt-3">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Artifact Name</th>
                        <th>Category</th>
                        <th>Size</th>
                        <th>Last Modified</th>
                        <th class="text-right">Export Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_exports.Count == 0)
                    {
                        <tr><td colspan="5" class="empty-state">No export bundles or manifests found in export directory (<code>/simulations/exports</code>).</td></tr>
                    }
                    else
                    {
                        @foreach (ExportFileItem item in _exports)
                        {
                            <tr>
                                <td class="font-mono"><strong>@item.Name</strong></td>
                                <td><span class="badge badge-accent">@item.Category</span></td>
                                <td class="font-mono">@item.SizeFormatted</td>
                                <td class="subtext">@item.LastModifiedUtc</td>
                                <td class="text-right">
                                    <div class="btn-group">
                                        <a href="@item.DownloadUrl" class="btn btn-sm btn-primary" download="@item.Name" title="Download artifact directly">
                                            📥 Download
                                        </a>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteExportAsync(item.Name)" title="Delete artifact from disk">
                                            🗑 Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Flag indicating whether the analytics query drawer is expanded.
    /// </summary>
    private bool _drawerOpen = true;

    /// <summary>
    /// Target dataset identifier for the analytical query.
    /// </summary>
    private string _queryDataset = "sample";

    /// <summary>
    /// SQL query text to execute.
    /// </summary>
    private string _queryText = "SELECT target_region, COUNT(*) AS bead_count FROM trajectory GROUP BY target_region ORDER BY bead_count DESC;";

    /// <summary>
    /// Maximum number of rows to return from the analytical query.
    /// </summary>
    private int _queryMaxRows = 1000;

    /// <summary>
    /// Flag indicating whether an analytical query is actively executing.
    /// </summary>
    private bool _isQueryExecuting;

    /// <summary>
    /// Error message produced by the analytical query execution, if any.
    /// </summary>
    private string? _queryError;

    /// <summary>
    /// Result produced by the most recent analytical query execution.
    /// </summary>
    private TrajectoryAnalyticsResult? _analyticsResult;

    /// <summary>
    /// Collection of discovered trajectory files.
    /// </summary>
    private IReadOnlyList<TrajectoryFileItem> _files = [];

    /// <summary>
    /// Collection of discovered exported bundle files.
    /// </summary>
    private IReadOnlyList<ExportFileItem> _exports = [];

    /// <summary>
    /// Loading state flag for trajectory files.
    /// </summary>
    private bool _isLoading;

    /// <summary>
    /// Loading state flag for exported files.
    /// </summary>
    private bool _isExportLoading;

    /// <summary>
    /// Exporting state flag.
    /// </summary>
    private bool _isExporting;

    /// <summary>
    /// Name for the export bundle.
    /// </summary>
    private string _exportBundleName = "dna-origami-dataset";

    /// <summary>
    /// Manifest from the most recent export.
    /// </summary>
    private DatasetManifest? _lastExportManifest;

    /// <summary>
    /// Pipeline console output log.
    /// </summary>
    private string _consoleOutput = "";

    /// <summary>
    /// Loads initial file lists for trajectories and exports.
    /// </summary>
    /// <returns>A task representing the asynchronous operation.</returns>
    protected override async Task OnInitializedAsync()
    {
        // WHAT: Discovers both active trajectory inputs and exported packages on startup.
        // WHY: Prepares the user interface with full volume oversight.
        // HOW: Concurrently queries both directory listings.
        await Task.WhenAll(LoadTrajectoriesAsync(), LoadExportsAsync());
    }

    /// <summary>
    /// Scans the shared storage volume for trajectory files.
    /// </summary>
    /// <returns>A task representing the asynchronous operation.</returns>
    private async Task LoadTrajectoriesAsync()
    {
        // WHAT: Discovers active trajectory files (.xyz, .dcd, .lammpstrj).
        // WHY: Populates the trajectory table for streaming and Parquet conversion.
        // HOW: Calls DatasetManager.ListTrajectoriesAsync.
        _isLoading = true;
        try
        {
            _files = await DatasetManager.ListTrajectoriesAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Scans the export storage volume for package archives and manifests.
    /// </summary>
    /// <returns>A task representing the asynchronous operation.</returns>
    private async Task LoadExportsAsync()
    {
        // WHAT: Discovers exported .tar.gz and .json manifest artifacts from the exports directory.
        // WHY: Exposes completed research packages for authenticated download and management.
        // HOW: Calls DatasetManager.ListExportsAsync to query the filesystem.
        _isExportLoading = true;
        try
        {
            _exports = await DatasetManager.ListExportsAsync();
        }
        finally
        {
            _isExportLoading = false;
        }
    }

    /// <summary>
    /// Deletes an exported package or manifest from disk.
    /// </summary>
    /// <param name="fileName">The file name of the export artifact to delete.</param>
    /// <returns>A task representing the asynchronous operation.</returns>
    private async Task DeleteExportAsync(string fileName)
    {
        // WHAT: Safely deletes an export bundle or manifest artifact from disk.
        // WHY: Enables researchers to clean up redundant or stale simulation archives.
        // HOW: Calls IDatasetManager.DeleteExportAsync and reloads the export list on success.
        bool deleted = await DatasetManager.DeleteExportAsync(fileName);
        if (deleted)
        {
            _consoleOutput += $"[EXPORT] Deleted artifact: {fileName}\n";
            await LoadExportsAsync();
        }
        else
        {
            _consoleOutput += $"[ERROR] Failed to delete artifact: {fileName}\n";
        }
    }

    /// <summary>
    /// Triggers the zero-allocation parser on the selected file.
    /// </summary>
    /// <param name="fileName">The trajectory file name.</param>
    /// <returns>A task representing the asynchronous operation.</returns>
    private async Task StreamParseFileAsync(string fileName)
    {
        _consoleOutput = $"[PIPELINE] Initializing zero-allocation parser for {fileName}...\n";

        string incomingDir = await ConfigRepo.GetValueAsync("Storage:TrajectoryIncomingDir", "./simulations/shared-data");
        string safePath = Path.Combine(incomingDir, Path.GetFileName(fileName));

        if (!File.Exists(safePath))
        {
            _consoleOutput += $"[ERROR] File {safePath} not found on disk.\n";
            return;
        }

        string ext = Path.GetExtension(safePath).ToLowerInvariant();
        ITrajectoryParser parser = ext switch
        {
            ".xyz" => XyzParser,
            ".dcd" => DcdParser,
            _ => LammpsParser
        };

        System.Diagnostics.Stopwatch sw = System.Diagnostics.Stopwatch.StartNew();
        long frames = 0;
        long atoms = 0;

        using (FileStream fs = new(safePath, FileMode.Open, FileAccess.Read, FileShare.Read, 65536, useAsync: true))
        {
            System.IO.Pipelines.PipeReader reader = System.IO.Pipelines.PipeReader.Create(fs);
            await parser.ParseAsync(reader, (frameIdx, coords) =>
            {
                frames++;
                atoms += coords.Length;
                return ValueTask.CompletedTask;
            });
        }

        sw.Stop();

        _consoleOutput += $"[SUCCESS] Trajectory parsed:\n"
            + $"  - Format: {parser.FormatName}\n"
            + $"  - Frames Sliced: {frames:N0}\n"
            + $"  - Total Atoms Processed: {atoms:N0}\n"
            + $"  - Elapsed Time: {sw.ElapsedMilliseconds} ms\n"
            + $"  - Heap Allocations: 0 Bytes\n";
    }

    /// <summary>
    /// Converts the selected trajectory file to columnar Apache Parquet.
    /// </summary>
    /// <param name="fileName">The trajectory file name.</param>
    /// <returns>A task representing the asynchronous operation.</returns>
    private async Task ConvertToParquetAsync(string fileName)
    {
        _consoleOutput = $"[PARQUET] Converting {fileName} to Apache Parquet via DuckDB...\n";

        string incomingDir = await ConfigRepo.GetValueAsync("Storage:TrajectoryIncomingDir", "./simulations/shared-data");
        string parquetDir = await ConfigRepo.GetValueAsync("Storage:TrajectoryParquetDir", "./simulations/parquet");
        string safeSource = Path.Combine(incomingDir, Path.GetFileName(fileName));
        string safeDest = Path.Combine(parquetDir, $"{Path.GetFileNameWithoutExtension(fileName)}.parquet");

        if (!File.Exists(safeSource))
        {
            _consoleOutput += $"[ERROR] Source file not found.\n";
            return;
        }

        string ext = Path.GetExtension(safeSource).ToLowerInvariant();
        ITrajectoryParser parser = ext switch
        {
            ".xyz" => XyzParser,
            ".dcd" => DcdParser,
            _ => LammpsParser
        };

        long records = await ParquetWriter.ConvertTrajectoryToParquetAsync(safeSource, safeDest, parser);
        _consoleOutput += $"[SUCCESS] Serialized {records:N0} columnar records to {safeDest} ready for pg_duckdb.\n";
    }

    /// <summary>
    /// Packages the active volume into a signed dataset bundle.
    /// </summary>
    /// <returns>A task representing the asynchronous operation.</returns>
    private async Task ExportDatasetAsync()
    {
        _isExporting = true;
        try
        {
            _lastExportManifest = await DatasetManager.ExportDatasetAsync(_exportBundleName, null);
            await LoadExportsAsync();
        }
        finally
        {
            _isExporting = false;
        }
    }

    /// <summary>
    /// Toggles the analytical query drawer open or closed.
    /// </summary>
    private void ToggleQueryDrawer()
    {
        // WHAT: Inverts the drawer expansion state.
        // WHY:  Allows researchers to collapse the query panel to save screen space.
        // HOW:  Toggles the _drawerOpen boolean flag.
        _drawerOpen = !_drawerOpen;
    }

    /// <summary>
    /// Populates the query text area with a pre-configured analytical template.
    /// </summary>
    /// <param name="e">Change event args from the preset selector.</param>
    private void OnPresetSelected(ChangeEventArgs e)
    {
        // WHAT: Replaces the query textarea content with a standard analytical SQL template.
        // WHY:  Provides quick-access templates for common origami and trajectory geometry inquiries.
        // HOW:  Maps dropdown key to pre-composed SQL string.
        string? selected = e.Value?.ToString();
        _queryText = selected switch
        {
            "region" => "SELECT target_region, COUNT(*) AS bead_count FROM trajectory GROUP BY target_region ORDER BY bead_count DESC;",
            "bbox" => "SELECT MAX(x) - MIN(x) AS dx, MAX(y) - MIN(y) AS dy, MAX(z) - MIN(z) AS dz, (MAX(x) - MIN(x)) * (MAX(y) - MIN(y)) * (MAX(z) - MIN(z)) AS volume FROM trajectory;",
            "density" => "SELECT COUNT(DISTINCT frame_index) AS frame_count, COUNT(DISTINCT atom_index) AS atom_count, COUNT(*) AS total_records FROM trajectory;",
            _ => _queryText
        };
    }

    /// <summary>
    /// Clears the currently displayed analytical query results and error banners.
    /// </summary>
    private void ClearQueryResults()
    {
        // WHAT: Resets analytical result and error state.
        // WHY:  Permits researchers to clear past query output before formulating new queries.
        // HOW:  Nullifies _analyticsResult and _queryError.
        _analyticsResult = null;
        _queryError = null;
    }

    /// <summary>
    /// Executes the active analytical SQL query against the selected trajectory dataset.
    /// </summary>
    /// <returns>A task representing the asynchronous operation.</returns>
    private async Task ExecuteAnalyticsQueryAsync()
    {
        // WHAT: Executes the read-only analytical SQL query via ITrajectoryAnalyticsService.
        // WHY:  Allows interactive exploration of trajectory datasets directly within the Web UI.
        // HOW:  Validates inputs, maps to TrajectoryAnalyticsQuery, executes asynchronously, and captures results or errors.
        if (string.IsNullOrWhiteSpace(_queryText))
        {
            _queryError = "SQL query cannot be empty.";
            return;
        }

        _isQueryExecuting = true;
        _queryError = null;

        try
        {
            TrajectoryAnalyticsQuery query = new(
                DatasetName: string.IsNullOrWhiteSpace(_queryDataset) ? "sample" : _queryDataset.Trim(),
                Query: _queryText.Trim(),
                MaxRows: _queryMaxRows > 0 ? _queryMaxRows : 1000);

            _analyticsResult = await AnalyticsService.ExecuteQueryAsync(query);
        }
        catch (Exception ex)
        {
            _queryError = ex.Message;
            _analyticsResult = null;
        }
        finally
        {
            _isQueryExecuting = false;
        }
    }
}
