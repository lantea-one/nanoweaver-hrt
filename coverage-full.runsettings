<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <!--
    This file exists only for gate step 7 (scripts/verify-all.sh). It is the honest measurement:
    unlike coverlet.runsettings it does NOT exclude CompilerGeneratedAttribute, so minimal-API endpoint
    lambdas and async state machines are counted. It has no threshold; scripts/check-coverage-ratchet.py
    compares the result with coverage-baseline.json instead. Keep the Include, Exclude and ExcludeByFile
    lists in sync with coverlet.runsettings whenever those change.
  -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[NanoWeaverHrt]*</Include>
          <Exclude>[NanoWeaverHrt.Tests]*,[NanoWeaverHrt]AutoGeneratedProgram,[NanoWeaverHrt]NanoWeaverHrt.Components.*</Exclude>
          <ExcludeByFile>**/Components/**/*.razor</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
