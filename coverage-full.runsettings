<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <!--
    This file exists only for gate step 7 (scripts/verify-all.sh). It is the honest measurement:
    unlike coverlet.runsettings it does NOT exclude CompilerGeneratedAttribute, so minimal-API endpoint
    lambdas and async state machines are counted. It has no threshold; scripts/check-coverage-ratchet.py
    compares the result with coverage-baseline.json instead. Keep the Include, Exclude and ExcludeByFile
    lists in sync with coverlet.runsettings whenever those change.
  -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[NanoWeaverHrt]*</Include>
          <Exclude>[NanoWeaverHrt.Tests]*,[NanoWeaverHrt]AutoGeneratedProgram</Exclude>
          <ExcludeByFile>**/Components/App.razor,**/Components/Routes.razor,**/Components/Pages/ComplianceSecurity.razor,**/Components/Pages/ConfigurationManagement.razor,**/Components/Pages/DnaManagementPage.razor,**/Components/Pages/EndocrineDashboard.razor,**/Components/Pages/PeerConnect.razor,**/Components/Pages/SimulationStudio.razor,**/Components/Pages/StackServices.razor,**/Components/Pages/TrajectoryBrowser.razor,**/Components/Pages/UserManagement.razor,**/Components/Pages/UserProfilePage.razor,**/Components/Pages/WorkflowWizard.razor,**/Components/Cohorts/**</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
