# ==============================================================================
# NanoWeaverHrt container identity template. Copy to .env (git-ignored):
#   cp example.env .env
# WHAT: Numeric user/group IDs the containers run as, plus the host GPU groups.
# WHY:  Files created in ./simulations/* then belong to you, not root, and the
#       non-root simulation process can still open /dev/dri.
# HOW:  Compose reads .env from the repository root for every overlay combination.
# ==============================================================================

# Numeric UID the services run as.  Discover: id -u
WEAVER_UID=1000
# Numeric primary GID the services run as.  Discover: id -g
WEAVER_GID=1000
# Host 'video' group GID.  Discover: getent group video | cut -d: -f3
WEAVER_VIDEO_GID=44
# Host 'render' group GID.  Discover: getent group render | cut -d: -f3
WEAVER_RENDER_GID=109
