# ==============================================================================
# LAMMPS Input Script: Aptamer Latch Gating & Pituitary Receptor Docking
# ------------------------------------------------------------------------------
# WHAT: Hardware-accelerated Steered Molecular Dynamics (SMD) and umbrella
#       sampling computing the Potential of Mean Force (PMF) for aptamer opening.
# WHY:  Verifies that nanocarrier gates remain tightly locked (Delta G >= +8.5 kcal/mol)
#       in basal state, opening only upon allosteric binding of LH/FSH.
# HOW:  Langevin dynamics with harmonic spring pulling on terminal aptamer latches.
# ==============================================================================

units           real
atom_style      full
boundary        p p p

# Simulation domain box (Angstroms)
region          simbox block -80.0 80.0 -80.0 80.0 -80.0 80.0
create_box      2 simbox

# Force field parameters (CHARMM36 nucleic acid & GAFF for ligand)
pair_style      lj/charmm/coul/long 10.0 12.0
pair_coeff      * * 0.10 3.50
kspace_style    pppm 1.0e-4

# Steered MD Pulling / Reaction coordinate along aptamer latch axis (0.5 to 3.0 nm)
group           latch_arm1 id 1:42
group           latch_arm2 id 43:84
fix             pull latch_arm1 smd cvel 20.0 0.001 0.0 0.0 1.0 0.0

timestep        2.0
thermo          500

# Stream frames for zero-allocation C# parser (AptamerAffinityAnalyzer)
dump            gating_stream all custom 500 /workspace/data/aptamer_gating.dump id type x y z vx vy vz

minimize        1.0e-4 1.0e-6 200 2000
run             50000
