# ==============================================================================
# Sample LAMMPS Input Script: Coarse-Grained DNA Nanostructure Relaxation
# ------------------------------------------------------------------------------
# WHAT: Minimal LAMMPS simulation configuration running molecular dynamics 
#       relaxation on a DNA duplex or nanotube.
# WHY:  Provides a baseline verifiable simulation deck for hardware-accelerated nodes.
# HOW:  Uses Langevin thermostat and OpenCL/SYCL GPU acceleration package.
# ==============================================================================

units           real
atom_style      molecular
boundary        p p p

# Define simulation box (Angstroms)
region          simbox block -50.0 50.0 -50.0 50.0 -50.0 50.0
create_box      1 simbox

# Pair potentials (soft repulsion for initial energy minimization)
pair_style      soft 4.0
pair_coeff      * * 0.0 4.0

timestep        1.0
thermo          100

# Write XYZ trajectory stream for the .NET 10 zero-allocation parser
dump            traj_stream all xyz 100 /workspace/data/minidna_run.xyz

# Run energy relaxation
minimize        1.0e-4 1.0e-6 100 1000
run             500
