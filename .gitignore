# Cryptographic Key Material (Ed25519 / ML-DSA-65 keypairs, certificates, keystores)
# Key material must never reach the sovereign Forgejo remote. Authentication is
# public-key challenge-response, and the app offers downloads such as
# {username}_private_key.pem. Never add a bare *.txt rule here; it would hide ordinary text files.
*.pem
*.key
*.pub
*.priv
*.der
*.crt
*.cer
*.p8
*.pk8
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.gpg
*_private_key*
*_public_key*
id_ed25519*
id_rsa*
*_ed25519
*_ed25519.pub
keys/
.keys/
secrets/

# Agent worktrees: isolated checkouts created for concurrent sub-agent work.
# These are full copies of the repository and must never be committed.
.claude/worktrees/

# npm lockfile: package.json declares no dependencies, so this file pins nothing and
# carries no supply-chain value. Remove this entry if real dependencies are ever added.
package-lock.json
