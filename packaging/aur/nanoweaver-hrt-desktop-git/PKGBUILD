# Maintainer: Nanoweaver HRT Project Contributors <admin@lantea.one>
pkgname=nanoweaver-hrt-desktop-git
pkgver=2026.11.10.1
pkgrel=1
pkgdesc="Decentralized Synthetic Biology & DNA Origami Research Platform (Git)"
arch=('x86_64' 'aarch64')
url="https://git.lantea.one/lantea-one/nanoweaver-hrt"
license=('MIT')
provides=('nanoweaver-hrt-desktop')
conflicts=('nanoweaver-hrt-desktop' 'nanoweaver-hrt-desktop-bin')
makedepends=('git' 'dotnet-sdk>=10.0')
depends=('glibc' 'libx11' 'libice' 'libsm' 'fontconfig' 'dbus' 'libnotify')
source=("git+https://git.lantea.one/lantea-one/nanoweaver-hrt.git")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/nanoweaver-hrt"
    if [ -x scripts/packaging/get-version.sh ]; then
        local ver
        ver="$(./scripts/packaging/get-version.sh 2>/dev/null || echo "2026.11.10.1")"
        local count
        count="$(git rev-list --count HEAD 2>/dev/null || echo "0")"
        local hash
        hash="$(git rev-parse --short HEAD 2>/dev/null || echo "0000000")"
        echo "${ver}.r${count}.g${hash}"
    else
        git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || echo "2026.11.10.1.r0.g$(git rev-parse --short HEAD)"
    fi
}

build() {
    cd "${srcdir}/nanoweaver-hrt"
    dotnet publish src/NanoWeaverHrt.Desktop/NanoWeaverHrt.Desktop.csproj -c Release --self-contained true -p:PublishTrimmed=false
}

package() {
    cd "${srcdir}/nanoweaver-hrt"
    
    install -dm755 "${pkgdir}/usr/lib/nanoweaver-hrt-desktop"
    install -dm755 "${pkgdir}/usr/bin"
    install -dm755 "${pkgdir}/usr/share/applications"
    install -dm755 "${pkgdir}/etc/xdg/autostart"
    install -dm755 "${pkgdir}/usr/share/icons/hicolor/scalable/apps"
    install -dm755 "${pkgdir}/usr/share/metainfo"
    install -dm755 "${pkgdir}/usr/share/licenses/nanoweaver-hrt-desktop"

    if [ -f "artifacts/aur-publish/NanoWeaverHrt.Desktop" ]; then
        install -Dm755 "artifacts/aur-publish/NanoWeaverHrt.Desktop" "$pkgdir/opt/nanoweaver-hrt/nanoweaver-hrt-desktop"
        ln -sf /opt/nanoweaver-hrt/nanoweaver-hrt-desktop "${pkgdir}/usr/bin/nanoweaver-hrt-desktop"
    elif [ -f "artifacts/aur-publish/nanoweaver-hrt-desktop" ]; then
        install -Dm755 "artifacts/aur-publish/nanoweaver-hrt-desktop" "$pkgdir/opt/nanoweaver-hrt/nanoweaver-hrt-desktop"
        ln -sf /opt/nanoweaver-hrt/nanoweaver-hrt-desktop "${pkgdir}/usr/bin/nanoweaver-hrt-desktop"
    else
        cp -r src/NanoWeaverHrt.Desktop/bin/Release/net10.0/*/publish/* "${pkgdir}/usr/lib/nanoweaver-hrt-desktop/"
        if [ -f "${pkgdir}/usr/lib/nanoweaver-hrt-desktop/NanoWeaverHrt.Desktop" ]; then
            chmod 755 "${pkgdir}/usr/lib/nanoweaver-hrt-desktop/NanoWeaverHrt.Desktop"
            ln -sf /usr/lib/nanoweaver-hrt-desktop/NanoWeaverHrt.Desktop "${pkgdir}/usr/bin/nanoweaver-hrt-desktop"
        elif [ -f "${pkgdir}/usr/lib/nanoweaver-hrt-desktop/NanoWeaverHrt" ]; then
            chmod 755 "${pkgdir}/usr/lib/nanoweaver-hrt-desktop/NanoWeaverHrt"
            ln -sf /usr/lib/nanoweaver-hrt-desktop/NanoWeaverHrt "${pkgdir}/usr/bin/nanoweaver-hrt-desktop"
        fi
    fi

    install -m644 packaging/linux/nanoweaver-hrt-desktop.desktop "${pkgdir}/usr/share/applications/"
    install -m644 packaging/linux/nanoweaver-hrt-desktop-tray.desktop "${pkgdir}/etc/xdg/autostart/"
    install -m644 packaging/linux/nanoweaver-hrt-desktop.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/"
    install -m644 packaging/linux/org.lantea.NanoWeaverHrt.metainfo.xml "${pkgdir}/usr/share/metainfo/"
    if [ -f "LICENSE" ]; then
        install -m644 LICENSE "${pkgdir}/usr/share/licenses/nanoweaver-hrt-desktop/"
    else
        echo "MIT License" > "${pkgdir}/usr/share/licenses/nanoweaver-hrt-desktop/LICENSE"
    fi
}
