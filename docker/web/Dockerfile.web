# ==============================================================================
# Sovereign Web UI & High-Throughput .NET 10 Service Container
# ------------------------------------------------------------------------------
# WHAT: High-performance microservice container running the ASP.NET Core 10 
#       runtime, zero-allocation trajectory parser, and sovereign Web UI.
# WHY:  Enables sovereign lab nodes to stream, slice, analyze, and export massive 
#       molecular simulations without GC overhead or host runtime dependencies.
# HOW:  Multi-stage Dockerfile compiling with ReadyToRun optimizations and running 
#       under server GC mode in a lightweight Linux container.
# ==============================================================================

# ------------------------------------------------------------------------------
# Build Stage (.NET 10 SDK)
# ------------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy Directory.Build.props to ensure workload resolver settings persist
COPY Directory.Build.props ./

# Copy project manifest and restore dependencies
COPY ["src/NanoWeaverHrt/NanoWeaverHrt.csproj", "NanoWeaverHrt/"]
RUN dotnet restore "NanoWeaverHrt/NanoWeaverHrt.csproj"

# Copy source code and publish with ReadyToRun optimizations
COPY src/NanoWeaverHrt/ NanoWeaverHrt/
WORKDIR "/src/NanoWeaverHrt"
RUN dotnet publish "NanoWeaverHrt.csproj" \
    -c Release \
    -o /app/publish \
    /p:PublishReadyToRun=true

# ------------------------------------------------------------------------------
# Runtime Stage (.NET 10 ASP.NET Runtime)
# ------------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

LABEL org.opencontainers.image.source="https://git.lantea.one/lantea-one/nanoweaver-hrt" \
      org.opencontainers.image.description="NanoWeaverHrt Sovereign Web UI and Real-Time Trajectory Streaming Node"

# Install curl for container runtime healthcheck probe
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Copy compiled binaries from build stage
COPY --from=build /app/publish .

# High-performance server GC configuration
ENV ASPNETCORE_URLS=http://+:5000 \
    DOTNET_EnableDiagnostics=0 \
    DOTNET_gcServer=1 \
    DOTNET_GCName="" \
    TRAJECTORY_INCOMING_DIR=/workspace/data \
    TRAJECTORY_EXPORT_DIR=/workspace/exports

# WHAT: Pre-create the writable workspace directories owned by UID/GID 1000.
# WHY:  The service will run as non-root; Docker discards ownership changes made
#       after the VOLUME instruction, so this must come first.
# HOW:  mkdir + chown here. /app stays root-owned so the service cannot rewrite its own code.
RUN mkdir -p /workspace/data /workspace/exports /workspace/parquet /workspace/node-keys \
    && chown 1000:1000 /workspace /workspace/data /workspace/exports /workspace/parquet /workspace/node-keys

# Mount points for shared simulation streams, cryptographic dataset exports, and isolated node keys
VOLUME ["/workspace/data", "/workspace/exports", "/workspace/node-keys"]

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5000/healthz || exit 1

# WHAT: Drop root for the runtime process.
# WHY:  Least privilege; also makes bare `docker run` non-root. Compose overrides the
#       value with WEAVER_UID:WEAVER_GID so bind-mounted files match the host user.
# HOW:  Numeric USER (not a name) so orchestrators can verify it and it works for
#       UIDs without a passwd entry.
USER 1000:1000

ENTRYPOINT ["dotnet", "NanoWeaverHrt.dll"]
