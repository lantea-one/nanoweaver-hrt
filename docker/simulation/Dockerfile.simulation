# ==============================================================================
# Multi-Hardware Simulation Engine Container
# ------------------------------------------------------------------------------
# WHAT: Container image equipped with scientific simulation runtimes (LAMMPS & 
#       oxDNA) and driver runtimes for Intel iGPUs, Intel Arc GPUs, and OpenCL.
# WHY:  Provides a sovereign, reproducible compute environment across disparate 
#       lab nodes without requiring manual system library installations.
# HOW:  Installs Intel Compute Runtime (NEO/Level-Zero) and OpenCL ICD loader on 
#       Ubuntu 24.04, compiling or provisioning oxDNA and LAMMPS binaries.
# ==============================================================================

FROM ubuntu:24.04 AS sim-builder

ENV DEBIAN_FRONTEND=noninteractive

# Install core build dependencies and Intel repository keys
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    build-essential \
    cmake \
    git \
    pkg-config \
    libfftw3-dev \
    python3 \
    python3-dev \
    python3-pip \
    ocl-icd-opencl-dev \
    opencl-headers \
    && curl -fsSL https://repositories.intel.com/gpu/intel-graphics.key | gpg --dearmor -o /usr/share/keyrings/intel-gpu-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/intel-gpu-keyring.gpg] https://repositories.intel.com/gpu/ubuntu noble client" > /etc/apt/sources.list.d/intel-gpu.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    intel-opencl-icd \
    intel-level-zero-gpu \
    libze1 \
    libze-dev \
    && rm -rf /var/lib/apt/lists/*

# Build oxDNA with OpenCL acceleration enabled
WORKDIR /opt
RUN git clone --depth 1 https://github.com/lorenzo-rovigatti/oxDNA.git /opt/oxdna \
    && mkdir -p /opt/oxdna/build && cd /opt/oxdna/build \
    && cmake .. -DOpenCL=ON -DCMAKE_BUILD_TYPE=Release \
    && make -j$(nproc)

# Runtime Image
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    clinfo \
    ocl-icd-libopencl1 \
    libfftw3-double3 \
    libfftw3-single3 \
    lammps \
    python3 \
    && curl -fsSL https://repositories.intel.com/gpu/intel-graphics.key | gpg --dearmor -o /usr/share/keyrings/intel-gpu-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/intel-gpu-keyring.gpg] https://repositories.intel.com/gpu/ubuntu noble client" > /etc/apt/sources.list.d/intel-gpu.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    intel-opencl-icd \
    intel-level-zero-gpu \
    libze1 \
    && rm -rf /var/lib/apt/lists/*

# Copy oxDNA build output
COPY --from=sim-builder /opt/oxdna/build/bin/oxDNA /usr/local/bin/oxDNA
COPY --from=sim-builder /opt/oxdna/build/bin/DNAnalysis /usr/local/bin/DNAnalysis
COPY --from=sim-builder /opt/oxdna/build/bin/confGenerator /usr/local/bin/confGenerator

# Set up environment variables
ENV PATH="/usr/local/bin:${PATH}" \
    OCL_ICD_VENDORS=/etc/OpenCL/vendors

COPY docker/simulation/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY docker/simulation/simulation_daemon.py /usr/local/bin/simulation_daemon.py
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/simulation_daemon.py

# WHAT: Pre-create writable workspace directories and run as non-root UID/GID 1000
#       (the stock 'ubuntu' user in ubuntu:24.04).
# WHY:  Files written to bind mounts should belong to the host user, not root.
# HOW:  mkdir + chown, then numeric USER. GPU access without root works through
#       compose 'group_add': device nodes keep their host GID inside the container,
#       and a supplementary GID matching it lets this user open them. Compose sets
#       the real UID/GID and GPU GIDs from .env (see example.env).
RUN mkdir -p /workspace/configs /workspace/data /workspace/exports \
    && chown 1000:1000 /workspace /workspace/data /workspace/exports
USER 1000:1000

EXPOSE 8080

WORKDIR /workspace

LABEL org.opencontainers.image.source="https://git.lantea.one/lantea-one/nanoweaver-hrt" \
      org.opencontainers.image.description="NanoWeaverHrt Coarse-Grained and All-Atom Molecular Dynamics Simulation Engine"

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["python3", "/usr/local/bin/simulation_daemon.py"]
