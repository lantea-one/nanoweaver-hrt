{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "packageRules": [
    {
      "description": "Hold .NET 11 major upgrades until dedicated net11.0 LTS migration milestone",
      "matchPackageNames": [
        "dotnet-sdk",
        "mcr.microsoft.com/dotnet/aspnet",
        "mcr.microsoft.com/dotnet/sdk",
        "Microsoft.Data.Sqlite",
        "Microsoft.AspNetCore.Mvc.Testing"
      ],
      "allowedVersions": "<11.0.0"
    },
    {
      "description": "Hold coverlet.collector major 10.x until compiler state-machine branch baseline is reconciled",
      "matchPackageNames": [
        "coverlet.collector"
      ],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "Hold xunit.runner.visualstudio at v2 series while xunit remains on 2.x",
      "matchPackageNames": [
        "xunit.runner.visualstudio"
      ],
      "allowedVersions": "<3.0.0"
    },
    {
      "description": "Pin Ubuntu simulation base image to 24.04 LTS for Intel GPU noble apt repository",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "24.04"
    },
    {
      "description": "Pin Node.js CI runtime to active Node 24 LTS",
      "matchPackageNames": [
        "node"
      ],
      "allowedVersions": "24"
    },
    {
      "description": "Keep Forgejo Actions upload-artifact on v3 for Forgejo runner artifact API compatibility",
      "matchFileNames": [
        ".forgejo/workflows/**"
      ],
      "matchPackageNames": [
        "actions/upload-artifact"
      ],
      "allowedVersions": "<4.0.0"
    }
  ]
}
