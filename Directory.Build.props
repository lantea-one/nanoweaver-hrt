<Project>
  <PropertyGroup>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <NuGetAudit>false</NuGetAudit>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- AGENTS.md Prime Directive #6 requires the solution to build with zero warnings
         (/warnaserror). WarningsNotAsErrors was already declared in NanoWeaverHrt.csproj,
         but TreatWarningsAsErrors was never actually enabled, so a newly introduced warning
         would not have failed the build or CI. Enabled here so the directive is enforced
         rather than merely observed. NU1900 (transient NuGet audit-feed connectivity) stays
         demoted to a warning because it reports infrastructure, not a code defect. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <!-- CalVer dynamic version resolution:
         1. Explicit PACKAGE_VERSION environment variable
         2. CI ref name (GITHUB_REF_NAME, FORGEJO_REF_NAME, CI_COMMIT_REF_NAME)
         3. Active git release branch name extracted directly from .git/HEAD
         4. Baseline CalVer fallback -->
    <DefaultCalVerVersion>2026.11.10.2</DefaultCalVerVersion>

    <DerivedVersion Condition="'$(DerivedVersion)' == '' and '$(PACKAGE_VERSION)' != ''">$(PACKAGE_VERSION)</DerivedVersion>

    <CiRefName Condition="'$(CiRefName)' == ''">$(GITHUB_REF_NAME)</CiRefName>
    <CiRefName Condition="'$(CiRefName)' == ''">$(FORGEJO_REF_NAME)</CiRefName>
    <CiRefName Condition="'$(CiRefName)' == ''">$(CI_COMMIT_REF_NAME)</CiRefName>
    <DerivedVersion Condition="'$(DerivedVersion)' == '' and '$(CiRefName)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(CiRefName)', '(?:release/)?v?(\d+\.\d+\.\d+(?:\.\d+)?)').Groups[1].Value)</DerivedVersion>

    <GitHeadPath>$(MSBuildThisFileDirectory).git/HEAD</GitHeadPath>
    <GitHeadContent Condition="'$(DerivedVersion)' == '' and Exists('$(GitHeadPath)')">$([System.IO.File]::ReadAllText('$(GitHeadPath)').Trim())</GitHeadContent>
    <DerivedVersion Condition="'$(DerivedVersion)' == '' and '$(GitHeadContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(GitHeadContent)', 'refs/heads/(?:release/)?v?(\d+\.\d+\.\d+(?:\.\d+)?)').Groups[1].Value)</DerivedVersion>

    <DerivedVersion Condition="'$(DerivedVersion)' == ''">$(DefaultCalVerVersion)</DerivedVersion>
    <DerivedVersion Condition="$(DerivedVersion.StartsWith('v'))">$(DerivedVersion.Substring(1))</DerivedVersion>

    <Version>$(DerivedVersion)</Version>
    <AssemblyVersion>$(DerivedVersion)</AssemblyVersion>
    <FileVersion>$(DerivedVersion)</FileVersion>
  </PropertyGroup>
</Project>
